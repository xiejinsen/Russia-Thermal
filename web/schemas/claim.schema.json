{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaimRecord",
  "type": "object",
  "required": [
    "id",
    "proposition",
    "status",
    "confidence",
    "supportingSourceIds",
    "sourcePath"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "proposition": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "string",
      "minLength": 1
    },
    "supportingSourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradictingSourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "boundary": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1
    },
    "decisionRole": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "PARTNER_READINESS",
        "PORTFOLIO_RATIONALE",
        "COMPARATOR_UMBRELLA",
        "FRONTIER_DISCOVERY",
        "EVIDENCE_GAP",
        "BACKGROUND",
        "UNRESOLVED",
        null
      ]
    }
  },
  "additionalProperties": false
}
