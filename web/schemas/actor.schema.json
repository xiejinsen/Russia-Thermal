{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActorRecord",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "country",
    "parentId",
    "sourcePath"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "ORGANIZATION",
        "LAB",
        "PERSON",
        "COMPANY"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "minLength": 2
    },
    "parentId": {
      "type": [
        "string",
        "null"
      ]
    },
    "currentRole": {
      "type": [
        "string",
        "null"
      ]
    },
    "officialUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "publicContact": {
      "type": [
        "string",
        "null"
      ]
    },
    "researchRelevance": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "latitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180
    },
    "locationVerifiedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "atlasProfile": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "state",
        "assessedAt",
        "leadershipSummary",
        "collaborationSummary",
        "influenceSummary",
        "outputInterpretation",
        "contextSourceIds",
        "collaborationSourceIds",
        "influenceSourceIds",
        "publicGaps",
        "sourcePath"
      ],
      "properties": {
        "state": {
          "type": "string"
        },
        "assessedAt": {
          "type": "string"
        },
        "leadershipSummary": {
          "type": "string"
        },
        "collaborationSummary": {
          "type": "string"
        },
        "influenceSummary": {
          "type": "string"
        },
        "outputInterpretation": {
          "type": "string"
        },
        "contextSourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collaborationSourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "influenceSourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publicGaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourcePath": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "researchClass": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ACADEMIC_UNIVERSITY",
        "ACADEMIC_RESEARCH_INSTITUTE",
        "APPLIED_RESEARCH_ORG",
        "INDUSTRIAL_ORG",
        "COMPANY",
        null
      ]
    },
    "researchDepth": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "PRIMARY",
        "SELECTIVE",
        "CONTEXT_ONLY",
        null
      ]
    }
  },
  "additionalProperties": false
}
