{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityRecord",
  "type": "object",
  "required": [
    "id",
    "actorId",
    "statement",
    "maturity",
    "evidenceConfidence",
    "targetFit",
    "keyPeopleIds",
    "claimIds",
    "sourcePath",
    "portfolioDisposition"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "actorId": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "maturity": {
      "type": "string",
      "minLength": 1
    },
    "evidenceConfidence": {
      "type": "string",
      "minLength": 1
    },
    "targetFit": {
      "type": "string",
      "minLength": 1
    },
    "keyPeopleIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claimIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technicalScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transferBoundary": {
      "type": [
        "string",
        "null"
      ]
    },
    "strategicUse": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1
    },
    "portfolioDisposition": {
      "type": "string",
      "enum": [
        "DIRECTION_LINKED",
        "COMPARATOR_ONLY",
        "SUPPORT_ONLY",
        "BACKGROUND_KILLED_THESIS",
        "UNRESOLVED"
      ]
    },
    "capabilityFamily": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "SOFTWARE_SYSTEM",
        "PASSIVE_HARDWARE",
        "ACTIVE_HARDWARE",
        "ENABLING",
        null
      ]
    },
    "capabilityTopics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platformTransfer": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "platform",
          "level"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "SMARTPHONE",
              "TABLET",
              "WEARABLE",
              "AR_VR",
              "LAPTOP",
              "COMPACT_ELECTRONICS",
              "ADJACENT_ELECTRONICS",
              "FOUNDATIONAL_ONLY"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "DIRECT",
              "NEAR_DIRECT",
              "TRANSFERABLE",
              "ADJACENT",
              "FOUNDATIONAL",
              "NOT_SUPPORTED"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
