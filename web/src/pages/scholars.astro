---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ExplorerToolbar from '../components/ExplorerToolbar.astro';
import DenseObjectRow from '../components/DenseObjectRow.astro';
import { actors, capabilities, directions, priorities } from '../data/load-normalized';
import { buildScholarsCollectionVM } from '../view-models/builders';
import { directionTitle, humanize } from '../view-models/helpers';

const vm = buildScholarsCollectionVM();
const actorById = new Map(actors.map((actor) => [actor.id, actor]));
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;

function isUnder(actorId: string | null | undefined, rootId: string) {
  let current = actorId ? actorById.get(actorId) : undefined;
  const seen = new Set<string>();
  while (current && !seen.has(current.id)) {
    if (current.id === rootId) return true;
    seen.add(current.id);
    current = current.parentId ? actorById.get(current.parentId) : undefined;
  }
  return false;
}

const records = vm.records.map((model) => {
  const person = actorById.get(model.id);
  const relatedCapabilities = capabilities.filter((capability) => capability.keyPeopleIds.includes(model.id));
  const linkedCapabilityIds = new Set(relatedCapabilities.map((capability) => capability.id));
  const linkedDirections = directions.filter((direction) =>
    direction.capabilityIds.some((id) => linkedCapabilityIds.has(id))
  );
  const dispositions = [...new Set(relatedCapabilities.map((capability) => capability.portfolioDisposition))];
  const priorityRanks = priorities
    .filter((priority) =>
      priority.targetActorIds.some((targetId) =>
        isUnder(person?.parentId, targetId) ||
        relatedCapabilities.some((capability) => isUnder(capability.actorId, targetId))
      )
    )
    .map((priority) => priority.rank);
  const relations = [
    ...(priorityRanks.length ? ['PRIORITY'] : []),
    ...dispositions,
    ...(!relatedCapabilities.length ? ['NO_CAPABILITY'] : [])
  ];
  const affiliation = person?.parentId ? actorById.get(person.parentId) : undefined;

  return {
    model,
    person,
    affiliation,
    relatedCapabilities,
    linkedDirections,
    priorityRanks,
    dispositions,
    relations,
    directionIds: linkedDirections.map((direction) => direction.id),
    search: [
      model.name,
      model.affiliation,
      model.role ?? '',
      model.relevance,
      affiliation?.name ?? '',
      ...relatedCapabilities.map((capability) => capability.statement),
      ...linkedDirections.map((direction) => directionTitle(direction.id))
    ].join(' ')
  };
}).sort((a, b) =>
  (a.person?.country ?? '').localeCompare(b.person?.country ?? '') ||
  (a.affiliation?.name ?? '').localeCompare(b.affiliation?.name ?? '') ||
  a.model.name.localeCompare(b.model.name)
);

const countryValues = [...new Set(records.map((record) => record.person?.country).filter((value): value is string => Boolean(value)))].sort();
const affiliationValues = [...new Map(records
  .filter((record) => record.affiliation)
  .map((record) => [record.affiliation!.id, record.affiliation!.name])).entries()]
  .map(([value, label]) => ({ value, label }))
  .sort((a, b) => a.label.localeCompare(b.label));

const relationOptions = [
  { value: 'PRIORITY', label: 'P1 / P2 / P3 related' },
  { value: 'DIRECTION_LINKED', label: 'Direction-linked' },
  { value: 'SUPPORT_ONLY', label: 'Russia support-only' },
  { value: 'COMPARATOR_ONLY', label: 'China comparator-only' },
  { value: 'BACKGROUND_KILLED_THESIS', label: 'Background / killed thesis' },
  { value: 'NO_CAPABILITY', label: 'Profile only / no capability' }
];
const directionOptions = directions
  .map((direction) => ({ value: direction.id, label: directionTitle(direction.id) }))
  .sort((a, b) => a.label.localeCompare(b.label));
---

<BaseLayout title="Russia-Thermal — Key People" description={vm.summary}>
  <SiteHeader slot="header" />

  <div data-explorer-root>
    <section class="collection-hero">
      <div>
        <p class="eyebrow">Scholar & key-person explorer</p>
        <h1>Scholars & key people</h1>
        <p>
          Browse the full Russia / China people graph without turning 70+ researchers into a card wall.
          Each row keeps identity, affiliation, research relevance, capability touchpoints and portfolio context visible.
        </p>
      </div>
      <div class="count">{records.length} records</div>
    </section>

    <ExplorerToolbar
      sticky
      compact
      total={records.length}
      searchPlaceholder="Search person, affiliation, role, capability or direction…"
      filters={[
        {
          key: 'country',
          label: 'Country',
          options: countryValues.map((value) => ({ value, label: value === 'RU' ? 'Russia' : value === 'CN' ? 'China' : value }))
        },
        { key: 'affiliation', label: 'Affiliation', options: affiliationValues },
        { key: 'relation', label: 'Research role', options: relationOptions },
        { key: 'direction', label: 'Direction', options: directionOptions }
      ]}
    />

    <section class="dense-list" aria-label="Scholar and key-person records">
      {records.map((record) => (
        <div
          data-explorer-record
          data-country={record.person?.country ?? ''}
          data-affiliation={record.affiliation?.id ?? ''}
          data-relation={record.relations.join('|')}
          data-direction={record.directionIds.join('|')}
          data-search={record.search}
        >
          <DenseObjectRow
            layout="balanced"
            href={record.model.href ? href(record.model.href) : undefined}
            ariaLabel={record.model.name}
          >
            <div slot="main" class="scholar-main">
              <div class="identity">
                <div class="avatar" aria-hidden="true">{record.model.name.slice(0,1)}</div>
                <div>
                  <div class="topline">
                    <span>{record.person?.country ?? '—'}</span>
                    {record.priorityRanks.map((rank) => <b>{rank}</b>)}
                    {record.model.status && <em>{record.model.status.label}</em>}
                  </div>
                  {record.model.href ? (
                    <a class="title" href={href(record.model.href)}>{record.model.name}</a>
                  ) : <strong class="title">{record.model.name}</strong>}
                </div>
              </div>

              <div class="affiliation-line">
                {record.affiliation ? (
                  <a href={href(`/institutions/${record.affiliation.id}`)}>{record.affiliation.name}</a>
                ) : <span>{record.model.affiliation}</span>}
                {record.model.role && <span>· {record.model.role}</span>}
              </div>
            </div>

            <div slot="details" class="scholar-details">
              <div>
                <span>Research relevance</span>
                <p>{record.model.relevance}</p>
              </div>
              {record.relatedCapabilities.length > 0 && (
                <div>
                  <span>Capability touchpoints</span>
                  <p>
                    {record.relatedCapabilities.slice(0,2).map((capability) => capability.statement).join(' · ')}
                    {record.relatedCapabilities.length > 2 ? ' …' : ''}
                  </p>
                </div>
              )}
            </div>

            <div slot="meta" class="scholar-meta">
              <div class="metrics">
                <span><b>{record.relatedCapabilities.length}</b> capabilities</span>
                <span><b>{record.linkedDirections.length}</b> directions</span>
              </div>
              <div class="tags">
                {record.dispositions.slice(0,3).map((value) => <em>{humanize(value)}</em>)}
                {!record.dispositions.length && <em>Profile only</em>}
              </div>
              {record.linkedDirections.length > 0 && (
                <div class="direction-line">
                  <span>Direction context</span>
                  <p>{record.linkedDirections.slice(0,2).map((direction) => directionTitle(direction.id)).join(' · ')}{record.linkedDirections.length > 2 ? ' …' : ''}</p>
                </div>
              )}
            </div>

            <div slot="actions" class="row-actions">
              <a href={href(`/claims?person=${encodeURIComponent(record.model.id)}`)}>Claims</a>
              <a href={href(`/papers?person=${encodeURIComponent(record.model.id)}`)}>Papers</a>
              <a href={href(`/evidence?person=${encodeURIComponent(record.model.id)}`)}>Evidence</a>
            </div>
          </DenseObjectRow>
        </div>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .collection-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;max-width:none}
  .collection-hero>div:first-child{max-width:72rem}
  .collection-hero h1{margin:0;font-size:clamp(1.7rem,2.7vw,2.35rem);letter-spacing:-.05em;line-height:1.08}
  .collection-hero>div>p:not(.eyebrow){margin:.55rem 0 0;color:var(--text-muted);max-width:82ch;line-height:1.6}
  .count{flex:0 0 auto;width:fit-content;padding:.45rem .8rem;border-radius:999px;background:var(--accent-soft);color:var(--accent);font-weight:800}

  .dense-list{margin-top:12px;border:1px solid var(--line);border-radius:var(--radius-md);overflow:hidden;background:var(--surface);box-shadow:var(--shadow-1)}
  .scholar-main,.scholar-details,.scholar-meta{display:grid;gap:6px;min-width:0}
  .identity{display:flex;gap:10px;align-items:center;min-width:0}
  .avatar{display:grid;place-items:center;width:2.35rem;height:2.35rem;flex:0 0 auto;border-radius:50%;background:var(--accent-soft);color:var(--accent);font-weight:850}
  .topline{display:flex;gap:5px;align-items:center;flex-wrap:wrap}
  .topline span,.topline b,.topline em{padding:3px 6px;border-radius:999px;font-size:.54rem;font-style:normal;font-weight:900;letter-spacing:.04em;text-transform:uppercase}
  .topline span{background:#eef4f8;color:#587185}.topline b{background:#e7f6ef;color:#087a66}.topline em{background:#f3f0fb;color:#60558a}
  .title{display:block;width:fit-content;margin-top:4px;color:#1d405a;font-size:.98rem;font-weight:850;line-height:1.35;text-decoration:none}
  .title:hover,.title:focus-visible{text-decoration:underline;text-underline-offset:.16em}
  .affiliation-line{display:flex;gap:5px;flex-wrap:wrap;color:#708696;font-size:.69rem}.affiliation-line a{color:#3e6682;font-weight:800;text-decoration:none}

  .scholar-details>div{display:grid;gap:3px}.scholar-details span,.direction-line span{color:#0b67b2;font-size:.55rem;font-weight:900;letter-spacing:.05em;text-transform:uppercase}
  .scholar-details p,.direction-line p{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;margin:0;color:#536d80;font-size:.75rem;line-height:1.5}
  .metrics{display:flex;gap:10px;flex-wrap:wrap}.metrics span{color:#6a8192;font-size:.64rem}.metrics b{color:#0b67b2;font-size:.85rem}
  .tags{display:flex;gap:4px;flex-wrap:wrap}.tags em{padding:3px 5px;border-radius:5px;background:#f1f5f8;color:#587185;font-size:.54rem;font-style:normal;font-weight:750}
  .direction-line{display:grid;gap:3px}

  .row-actions{display:flex;gap:5px;flex-wrap:wrap}.row-actions a{padding:5px 7px;border:1px solid #d8e7f1;border-radius:6px;color:#43677f;font-size:.62rem;font-weight:800;text-decoration:none;white-space:nowrap}.row-actions a:hover{background:#eef6fb;color:#0b67b2}

  [hidden]{display:none!important}
  @media(max-width:850px){.collection-hero{align-items:flex-start;flex-direction:column}}
</style>
