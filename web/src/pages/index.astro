---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { buildOverviewVM } from '../view-models/builders';

const vm = buildOverviewVM();
const base = import.meta.env.BASE_URL;
const href = (path: string) => path === '/' ? base : `${base}${path.replace(/^\//, '')}`;
const primary = vm.priorities.find(p => p.priorityClass === 'Primary');
const reserve = vm.priorities.find(p => p.priorityClass === 'Reserve');
const hold = vm.priorities.find(p => p.priorityClass === 'Hold');
const candidates = [
  { name: primary?.institutions[0]?.name ?? 'Kutateladze Institute of Thermophysics', person: 'Pavlenko / Surtaev · Laboratory 1.3', topic: 'Mechanism-resolved dryout', status: 'P1 · PRIMARY FEASIBILITY', gate: 'Can repeatable dry-spot labels improve a handset validation decision?', url: primary?.institutions[0]?.href ?? '/partners' },
  { name: reserve?.institutions[0]?.name ?? 'Moscow Power Engineering Institute', person: 'N. S. Ivanov', topic: '42-month thermosyphon aging', status: 'P2 · CONDITIONAL RESERVE', gate: 'Is intermediate aging-state history and permission to use it available?', url: reserve?.institutions[0]?.href ?? '/partners' },
  { name: hold?.institutions[0]?.name ?? 'Tomsk Polytechnic University', person: 'Feoktistov · surface engineering', topic: 'Laser processing / wettability', status: 'P3 · HOLD', gate: 'Any phone-device-matched gain over Chinese process prior art?', url: hold?.institutions[0]?.href ?? '/partners' }
];
const comparisons = [
  { topic: 'Ultra-thin VC manufacturing', baseline: 'China / internal product stack', russia: 'No verified matched phone device advantage', disposition: 'DO NOT INVEST', link: '/landscape' },
  { topic: 'Dryout failure states', baseline: 'China device work + global wick-mode models', russia: 'Kutateladze local IR / optical crisis labels', disposition: 'P1 FEASIBILITY', link: '/directions' },
  { topic: 'Long-calendar aging', baseline: 'China VC oxidation, QA and accelerated tests', russia: 'MPEI R410A thermosyphon endpoint after 42 months', disposition: 'RESERVE', link: '/partners' },
  { topic: 'Transient PCM / LHP limits', baseline: 'Global prior art and device trade-offs', russia: 'TSU, ITP Ural and ICM research methods', disposition: 'WATCH', link: '/capabilities' }
];
---
<BaseLayout title="Where Russian Thermal Science Can Add Value | Russia-Thermal" description="Evidence-linked comparison of Russia thermal science against smartphone device engineering in China and global literature.">
  <SiteHeader slot="header" />
  <div class="editorial-page">
    <header class="masthead">
      <p class="eyebrow">RESEARCH REVIEW / OCTOBER 2026 / SMARTPHONE THERMAL</p>
      <div class="masthead-grid">
        <div class="thesis">
          <h1>Where Russian Thermal Science<br class="wide-only" /> Can Add Value</h1>
          <p class="executive" lang="zh-CN">俄罗斯的潜在价值是补充失效机理、长期退化证据和专项研究方法，而不是替代国内手机散热产品研发。</p>
          <p class="technical-lead">We reviewed named academic teams against Chinese handset-device engineering and independent global research. Only narrow, falsifiable scientific increments survive; a phone-scale hardware advantage has <strong>not</strong> been established.</p>
          <a class="inline-link" href={href('/landscape')}>Explore the research landscape <span aria-hidden="true">↗</span></a>
        </div>
        <aside class="evidence-rail" aria-label="Research thesis provenance and scope">
          <h2>CLAIM / PROVENANCE <span class="cn-inline" lang="zh-CN">· 结论依据</span></h2>
          <div class="rail-entry"><strong>China / Internal</strong><p>Ultra-thin VC · manufacturing quality · system integration · device reliability</p></div>
          <div class="rail-entry"><strong>Russia / Academia</strong><p>Dryout diagnostics · long-calendar aging endpoints · focused thermal models</p></div>
          <div class="rail-entry"><strong>Evidence boundary</strong><p>No demonstrated smartphone UTVC superiority. Data access and collaboration willingness remain unknown.</p></div>
          <a href={href('/evidence')}>Inspect original evidence →</a>
        </aside>
      </div>
    </header>

    <section class="landscape-index" aria-labelledby="landscape-index-title">
      <div class="section-intro">
        <p class="eyebrow">RESEARCH LANDSCAPE / INSTITUTIONS, PEOPLE & ORIGINAL WORKS</p>
        <h2 id="landscape-index-title">Who is doing relevant thermal science?<span class="heading-cn" lang="zh-CN">俄罗斯科研版图：机构、关键学者和代表性能力</span></h2>
        <p>A bounded index of groups connected to the current research portfolio, not an exhaustive census of Russian thermal institutes. Follow a named institution or scholar to inspect its original research.</p>
      </div>
      <div class="landscape-columns">
        <aside class="landscape-context">
          <strong>LANDSCAPE / SCOPE</strong>
          <p><b>{vm.stats.capabilities}</b> capability records in the normalized research graph. Coverage is corpus-specific: these are not independently counted national capabilities or universally phone-qualified technologies.</p>
          <a href={href('/research-map/russia')}>Explore verified Russian research locations →</a>
          <a href={href('/research-coverage')}>How coverage was assessed →</a>
        </aside>
        <div class="actor-directory">
          <div class="directory-labels"><span>INSTITUTION / RESEARCH ROLE</span><span>CANONICAL PROFILE</span></div>
          {vm.institutions.slice(0,6).map(institution => <div class="actor-entry">
            <div><a class="actor-name" href={href(institution.href)}>{institution.name}</a><p>{institution.capabilityCount} linked capability records in the active portfolio view</p></div>
            <a href={href(institution.href)}>Profile ↗</a>
          </div>)}
          <p class="directory-hint">The active-portfolio index is selective. Browse the full <a href={href('/institutions')}>institution atlas</a>, <a href={href('/scholars')}>scholars</a> and <a href={href('/representative-works')}>representative original papers</a> for the wider research corpus.</p>
        </div>
      </div>
    </section>

    <article class="featured" aria-labelledby="study-title">
      <div class="study-body">
        <p class="eyebrow">FEATURED RESEARCH / PHASE-1 PRIORITY</p>
        <h2 id="study-title">When does Dryout become irreversible?<span class="heading-cn" lang="zh-CN">干涸何时演变为不可逆失效？</span></h2>
        <p>Surtaev, Malakhov, Perminov, Polovnikov and Pavlenko investigated boiling of dielectric fluids HFE-7100 and Novec 649 using high-speed infrared and optical diagnostics. The work documents local dry-spot evolution near critical heat flux (CHF), including the formation of persistent dry regions under the studied experimental conditions.</p>
        <p>This is <strong>mechanism-resolved laboratory evidence</strong>, not a sealed ultra-thin vapor chamber (UTVC) experiment. A prospective research collaboration would need repeatable annotations, test conditions and accessible datasets before it could contribute to handset evaluation.</p>
        <div class="research-question"><span>THE FALSIFIABLE QUESTION</span><p>Can distinct reversible and irreversible crisis-state labels improve a phone-relevant validation or protection decision beyond existing thermal, pressure and physics-model baselines?</p></div>
      </div>
      <aside class="citation" aria-label="Featured research citation">
        <span>ORIGINAL PAPER · 2026</span>
        <a class="paper-title" href="https://doi.org/10.1016/j.ijheatmasstransfer.2025.127855">Investigation of heat transfer, critical heat flux and dry spots dynamics during boiling of dielectric fluids HFE-7100 and Novec 649</a>
        <p>Surtaev et al. · International Journal of Heat and Mass Transfer</p>
        <div class="citation-limit"><strong>SCOPE LIMIT</strong><p>Dielectric open-boiling / optical diagnostics. No sealed smartphone device validation.</p></div>
        <a href={href('/papers/PAPER-RU-DRY-001')}>Read this paper’s findings and limits →</a>\n        <a href={href('/claims/CLM-PAV-002')}>Inspect the supporting Dryout Claim →</a>
      </aside>
    </article>

    <section class="comparison" aria-labelledby="landscape-title">
      <div class="section-intro"><p class="eyebrow">COMPARATOR-PRESSURED EVIDENCE</p><h2 id="landscape-title">Where China leads — and Russia may complement<span class="heading-cn" lang="zh-CN">中俄技术能力对比与互补空间</span></h2><p>Comparison is by mechanism, available observables and phone transfer constraints; cross-rig CHF or heat-transfer numbers are not ranked as device performance.</p></div>
      <div class="table-scroll" role="region" aria-label="Research capability comparison" tabindex="0">
        <table>
          <thead><tr><th scope="col">Research area</th><th scope="col">China / Global baseline</th><th scope="col">Russian published capability</th><th scope="col">Current disposition</th></tr></thead>
          <tbody>{comparisons.map(row => <tr><th scope="row"><a href={href(row.link)}>{row.topic}</a></th><td>{row.baseline}</td><td>{row.russia}</td><td><span class="disposition">{row.disposition}</span></td></tr>)}</tbody>
        </table>
      </div>
      <a class="inline-link" href={href('/landscape')}>Read the complete source-backed comparison →</a>
    </section>

    <section class="directory" aria-labelledby="directory-title">
      <div class="section-intro"><p class="eyebrow">RESEARCH THREADS / INSTITUTIONS & PEOPLE</p><h2 id="directory-title">Which academic teams deserve attention?<span class="heading-cn" lang="zh-CN">值得关注的俄罗斯机构与学者</span></h2><p>Research capability and collaboration feasibility are separate questions. P1 is a feasibility thesis, not an approved joint project.</p></div>
      <div class="thread-list">
        {candidates.map(candidate => <article class="thread">
          <div class="thread-identity"><span>{candidate.status}</span><h3><a href={href(candidate.url)}>{candidate.name}</a></h3><p>{candidate.person}</p></div>
          <div class="thread-research"><strong>{candidate.topic}</strong><p>{candidate.gate}</p></div>
          <a class="thread-link" href={href(candidate.url)}>Institution detail ↗</a>
        </article>)}
      </div>
      <p class="secondary-thread">Method-only research reserves: <a href={href('/institutions')}>TSU (PCM transient modeling)</a> · <a href={href('/institutions')}>ITP Ural (LHP operability)</a> · <a href={href('/institutions')}>ICM (electronics heat-pipe integration)</a>. These are not equal-ranked collaboration approvals.</p>
    </section>

    <section class="outlook" aria-labelledby="outlook-title">
      <div class="section-intro"><p class="eyebrow">RESEARCH HORIZON / 2027–2029</p><h2 id="outlook-title">Unanswered thermal questions, not product forecasts<span class="heading-cn" lang="zh-CN">2027–2029 年值得研究的关键热问题</span></h2></div>
      <div class="notes">
        <article><h3>Failure-aware UTVC</h3><p>Which boiling states are reversible, observable and useful for validation margins?</p></article>
        <article><h3>Health-aware lifetime</h3><p>Can capillary degradation be detected before aggregate thermal output changes?</p></article>
        <article><h3>Transient buffer recovery</h3><p>How do thermal bursts, PCM reset time and module mass trade off under repeat cycles?</p></article>
        <article><h3>Thin two-phase limits</h3><p>How do capillary return, vapor resistance, startup and packaging height constrain design?</p></article>
      </div>
      <a class="inline-link" href={href('/directions')}>Explore all research directions →</a>
    </section>

    <section class="collaboration-value" aria-labelledby="collaboration-value-title">
      <div class="section-intro">
        <p class="eyebrow">COLLABORATION VALUE / BUILD-VS-PARTNER COUNTERFACTUAL</p>
        <h2 id="collaboration-value-title">Why partner instead of building internally?<span class="heading-cn" lang="zh-CN">合作价值：俄罗斯能补充哪些国内尚未证明拥有的研究增量？</span></h2>
        <p>A published method does not establish a collaboration advantage. Each hypothesis must beat the strongest Chinese/internal and independent global alternative on the same practical question.</p>
      </div>
      <div class="table-scroll" role="region" aria-label="Collaboration value counterfactual comparison" tabindex="0">
        <table>
          <thead><tr><th scope="col">Research thesis</th><th scope="col">Strong alternative</th><th scope="col">Incremental evidence required</th></tr></thead>
          <tbody>
            <tr><th scope="row"><a href={href('/partners')}>P1 · Kutateladze</a><p>Mechanism-resolved crisis-state labels</p></th><td>China phone dryout experiments, existing sensors, global wick-mode classification and segmentation.</td><td>Licensable repeatable experimental labels must change a held-out phone validation or protection decision; otherwise stop.</td></tr>
            <tr><th scope="row"><a href={href('/partners')}>P2 · MPEI</a><p>Long-duration capillary degradation</p><a class="source-direct" href={href('/papers/PAPER-RU-AGE-001')}>42-month original study ↗</a></th><td>Domestic oxidation grading, accelerated VC aging, and internal QA models.</td><td>The paper reports post-operation capillary imbibition decline, not a time-resolved early warning. <a class="source-direct" href={href('/claims/CLM-MPEI-008')}>Early-indicator hypothesis (OPEN) ↗</a> Require accessible intermediate states; otherwise reserve.</td></tr>
            <tr><th scope="row"><a href={href('/partners')}>TPU · HOLD</a><p>Surface engineering</p></th><td>Chinese laser-wick processing and mature handset integration capabilities.</td><td>Reopen only with a repeatable, phone-device-matched benefit that current alternatives do not offer.</td></tr>
          </tbody>
        </table>
      </div>
      <p class="method-boundary"><strong>Unverified external conditions:</strong> collaborator willingness, licensed raw data, IP rights, internal cost or staffing counterfactual, and phone-scale predictive gain. This is a research screening recommendation, not authorization to engage.</p>
    </section>

    <footer class="decision-footer">
      <p class="eyebrow">MANAGEMENT DECISION / EVIDENCE-LIMITED</p>
      <h2>Authorize a P1 feasibility inquiry — not product development?<span class="heading-cn" lang="zh-CN">建议决策：是否批准 P1 前期合作可行性接洽？</span></h2>
      <p lang="zh-CN">建议仅核实 Kutateladze 的实验条件、机理标注、原始数据及合作许可。MPEI 继续条件储备，TPU 保持 HOLD；尚无对外联系授权。</p>
      <div class="footer-links"><a href={href('/partners')}>Partner work packages ↗</a><a href={href('/claims')}>Audit Claims ↗</a><a href={href('/papers')}>Original Papers ↗</a><a href={href('/research-coverage')}>Coverage and limitations ↗</a></div>
    </footer>
  </div>

  <style>
    :global(body){background:#f7f9fb;color:#142b40}
    :global(main){max-width:1380px;padding-top:0}
    .editorial-page{font-size:16px;line-height:1.7}
    .eyebrow{font-size:12px;color:#236b99;font-weight:800;letter-spacing:.105em;margin:0 0 22px}
    .masthead{padding:64px 45px 60px;border-bottom:1px solid #d5e1e8}
    .masthead-grid{display:grid;grid-template-columns:minmax(0,2.15fr) minmax(260px,.85fr);gap:64px}
    h1,h2,h3,p{overflow-wrap:break-word}
    h1{font-size:clamp(36px,3.65vw,54px);line-height:1.18;letter-spacing:-.045em;margin:0 0 38px}
    .executive{font-size:21px;font-weight:750;line-height:1.6;max-width:820px;margin:0 0 32px}
    .technical-lead{font-size:18px;line-height:1.8;max-width:760px;color:#526879;margin:0 0 23px}
    .inline-link,.evidence-rail a,.citation>a:last-child,.thread-link,.secondary-thread a,.footer-links a{color:#236b99;font-weight:750;text-decoration:none}
    a:hover{text-decoration:underline;text-underline-offset:4px}
    a:focus-visible{outline:3px solid #236b99;outline-offset:4px}
    .evidence-rail{border-left:2px solid #b6d4e4;padding-left:28px;align-self:start}
    .heading-cn{display:block;margin-top:7px;font-family:var(--font-sans);font-size:.58em;font-weight:650;line-height:1.55;letter-spacing:0;color:#355a75}\n    .cn-inline{font-size:12px;letter-spacing:0;font-weight:650;color:#446b84}\n    .evidence-rail h2,.citation>span{font-size:12px;font-weight:850;letter-spacing:.09em;color:#236b99;margin:0 0 20px}
    .rail-entry{padding:0 0 15px;margin-bottom:16px;border-bottom:1px solid #d5e1e8}
    .rail-entry strong{font-size:16px}
    .rail-entry p{font-size:14px;color:#526879;margin:5px 0 0}
    .evidence-rail a{font-size:13px}
    .featured{display:grid;grid-template-columns:minmax(0,2fr) minmax(270px,.9fr);gap:70px;padding:68px 45px 76px;background:#fff;border-bottom:1px solid #d5e1e8}
    .study-body h2{font-size:35px;line-height:1.3;letter-spacing:-.035em;margin:0 0 24px}
    .study-body>p:not(.eyebrow){color:#40596b;font-size:17px;line-height:1.86;max-width:780px}
    .research-question{border-left:3px solid #236b99;padding:13px 23px;background:#f4f8fb;margin-top:30px}
    .research-question span{font-size:12px;letter-spacing:.08em;color:#236b99;font-weight:800}
    .research-question p{font-size:17px;font-weight:700;line-height:1.7;margin:9px 0}
    .citation{background:#e8f2f8;padding:28px;align-self:start}
    .paper-title{display:block;font-size:19px;font-weight:750;line-height:1.55;color:#142b40;text-decoration:none;margin-top:23px}
    .citation>p{font-size:14px;color:#526879}
    .citation-limit{border-top:1px solid #bfd5e1;border-bottom:1px solid #bfd5e1;padding:16px 0;margin:24px 0}
    .citation-limit strong{font-size:12px;color:#236b99}
    .citation-limit p{font-size:14px;margin:5px 0}
    .comparison,.directory,.outlook,.landscape-index,.collaboration-value{padding:64px 45px;border-bottom:1px solid #d5e1e8}
    .section-intro{max-width:990px;margin-bottom:32px}
    .section-intro h2{font-size:31px;line-height:1.34;letter-spacing:-.03em;margin:0 0 12px}
    .section-intro>p:last-child{font-size:16px;color:#526879;margin:0}
    .landscape-columns{display:grid;grid-template-columns:minmax(240px,.75fr) minmax(0,1.8fr);gap:46px}
    .landscape-context{border-left:3px solid #236b99;background:#e8f2f8;padding:24px;align-self:start}
    .landscape-context strong,.directory-labels{font-size:12px;letter-spacing:.06em;color:#236b99;font-weight:800}
    .landscape-context p{font-size:15px;line-height:1.8;color:#40596b}
    .landscape-context b{font-size:25px;color:#142b40}
    .landscape-context a{display:block;color:#236b99;margin-top:15px;text-decoration:none;font-weight:700;font-size:13px}
    .directory-labels{display:flex;justify-content:space-between;padding-bottom:10px}
    .actor-entry{display:flex;align-items:start;justify-content:space-between;gap:16px;padding:13px 0;border-top:1px solid #d5e1e8}
    .actor-name{font-size:16px;font-weight:750;color:#142b40;text-decoration:none}
    .actor-entry p{font-size:13px;color:#526879;margin:5px 0}
    .actor-entry>a{color:#236b99;font-size:13px;white-space:nowrap}
    .directory-hint,.method-boundary{font-size:14px;line-height:1.75;color:#526879}
    .directory-hint a{color:#236b99}
    .method-boundary{background:#e8f2f8;padding:17px 21px;margin:24px 0 0}
    .source-direct{display:inline-block;color:#236b99;font-size:13px;font-weight:700;margin-top:8px;text-decoration:underline;text-underline-offset:3px}\n    .collaboration-value tbody th p{font-size:13px;font-weight:400;color:#526879;margin:6px 0}
    .table-scroll{overflow-x:auto}
    table{width:100%;border-collapse:collapse;min-width:810px;text-align:left}
    th,td{padding:21px 16px 21px 0;border-bottom:1px solid #d5e1e8;vertical-align:top}
    thead th{font-size:12px;letter-spacing:.045em;text-transform:uppercase;color:#236b99}
    tbody th{font-size:15px;width:23%;font-weight:750}
    tbody th a{color:#142b40;text-decoration:none}
    td{font-size:14px;color:#40596b}
    .disposition{font-size:12px;font-weight:800;color:#236b99;white-space:nowrap}
    .comparison>.inline-link,.outlook>.inline-link{display:inline-block;margin-top:23px}
    .thread{display:grid;grid-template-columns:minmax(270px,1.35fr) minmax(300px,1.35fr) 150px;align-items:start;gap:20px;padding:22px 0;border-top:1px solid #d5e1e8}
    .thread:last-child{border-bottom:1px solid #d5e1e8}
    .thread-identity>span{font-size:12px;font-weight:850;letter-spacing:.05em;color:#236b99}
    .thread h3{font-size:18px;line-height:1.4;margin:7px 0}
    .thread h3 a{color:#142b40;text-decoration:none}
    .thread p{font-size:14px;color:#526879;margin:4px 0}
    .thread-research strong{font-size:16px}
    .thread-link{font-size:13px;justify-self:end}
    .secondary-thread{font-size:14px;color:#526879;margin-top:26px}
    .notes{display:grid;grid-template-columns:1fr 1fr;gap:32px 66px}
    .notes article{border-top:2px solid #d5e1e8;padding-top:13px}
    .notes h3{font-size:19px;margin:0 0 8px}
    .notes p{font-size:15px;color:#526879;margin:0}
    .decision-footer{padding:55px 45px 75px;background:#e8f2f8}
    .decision-footer h2{font-size:30px;margin:0 0 20px;line-height:1.4}
    .decision-footer>p:not(.eyebrow){max-width:900px;font-size:17px}
    .footer-links{display:flex;gap:24px;flex-wrap:wrap;margin-top:30px;font-size:14px}
    @media(max-width:1050px){.landscape-columns{gap:24px}.masthead-grid,.featured{gap:30px}.thread{grid-template-columns:1fr 1fr}.thread-link{grid-column:1/-1;justify-self:start}}
    @media(max-width:760px){.landscape-columns{grid-template-columns:1fr;gap:20px}.directory-labels span:last-child{display:none}.masthead,.featured,.comparison,.directory,.outlook,.landscape-index,.collaboration-value,.decision-footer{padding:36px 20px}.masthead-grid,.featured{grid-template-columns:1fr;gap:30px}.evidence-rail{border-left:0;background:#e8f2f8;padding:20px}.wide-only{display:none}h1{font-size:34px}.executive{font-size:18px}.technical-lead{font-size:16px}.study-body h2{font-size:27px}.study-body>p:not(.eyebrow){font-size:16px}.section-intro h2{font-size:26px}.thread{grid-template-columns:1fr;gap:12px}.thread-link{grid-column:auto}.notes{grid-template-columns:1fr;gap:22px}.citation{padding:20px}.decision-footer h2{font-size:26px}}
  </style>
</BaseLayout>
