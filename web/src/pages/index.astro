---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { buildOverviewVM } from '../view-models/builders';

const vm = buildOverviewVM();
const primaryPriority = vm.priorities.find((priority) => priority.priorityClass === 'Primary');
const reservePriority = vm.priorities.find((priority) => priority.priorityClass === 'Reserve');
const holdPriority = vm.priorities.find((priority) => priority.priorityClass === 'Hold');
const base = import.meta.env.BASE_URL;
const href = (path: string) => path === '/' ? base : `${base}${path.replace(/^\//, '')}`;
---

<BaseLayout title="Russia-Thermal — Research Intelligence" description={vm.summary}>
  <SiteHeader slot="header" />

  <section class="signal">
    <div class="signal-copy">
      <span class="tag">PORTFOLIO SIGNAL</span>
      <h1>{vm.title}</h1>
      <p>{vm.summary}</p>
      <div class="signal-links">
        <a href={href('/partners')}>Open partner portfolio</a>
        <a href={href('/research-coverage')}>See full research coverage</a>
        <a href={href('/research-map/russia')}>Explore Russia research map</a>
        <a href={href('/landscape')}>Review Russia vs China</a>
      </div>
    </div>
    <div class="scoreboard">
      <a href={href('/directions')}><b>{vm.stats.strategicCandidates}</b><span>STRATEGIC CANDIDATE</span></a>
      <a href={href('/directions')}><b>{vm.stats.reserves}</b><span>STRATEGIC RESERVES</span></a>
      <a href={href('/evidence')}><b>{vm.stats.deepReads}</b><span>DEEP READS</span></a>
    </div>
  </section>

  <section class="basis">
    <div class="bar-title"><span>WHY THIS CONCLUSION</span><span>{vm.thesisAssessedAt ?? 'CURRENT'}</span></div>
    <div class="basis-grid">
      {vm.theoryBasis.slice(0,3).map((item, index) => (
        <div><b>0{index + 1}</b><p>{item}</p></div>
      ))}
    </div>
  </section>

  <section class="management-strip">
    {primaryPriority && <article>
      <span>ACT NOW · {primaryPriority.rank}</span>
      <b>{primaryPriority.institutions[0]?.name ?? primaryPriority.id}</b>
      <p>{primaryPriority.rationale}</p>
      <a href={href(`/directions/${primaryPriority.directions[0]?.id ?? ''}`)}>Open direction</a>
    </article>}
    {reservePriority && <article>
      <span>CONDITIONAL RESERVE · {reservePriority.rank}</span>
      <b>{reservePriority.institutions[0]?.name ?? reservePriority.id}</b>
      <p>{reservePriority.rationale}</p>
      <a href={href(`/directions/${reservePriority.directions[0]?.id ?? ''}`)}>Open direction</a>
    </article>}
    {holdPriority && <article>
      <span>HOLD · {holdPriority.rank}</span>
      <b>{holdPriority.institutions[0]?.name ?? holdPriority.id}</b>
      <p>{holdPriority.rationale}</p>
      <a href={href(`/directions/${holdPriority.directions[0]?.id ?? ''}`)}>Open direction</a>
    </article>}
  </section>

  <section class="explore-strip">
    <div>
      <span>EXPLORE THE GRAPH</span>
      <b>Move from conclusion to geography, people, papers and claims.</b>
    </div>
    <nav aria-label="Deep research entry points">
      <a href={href('/research-coverage')}>Research Coverage</a>
      <a href={href('/research-map/russia')}>Russia Map</a>
      <a href={href('/institutions')}>Institutions</a>
      <a href={href('/scholars')}>Scholars</a>
      <a href={href('/directions')}>Directions</a>
      <a href={href('/claims')}>Claims</a>
      <a href={href('/papers')}>Papers</a>
      <a href={href('/evidence')}>Evidence</a>
    </nav>
  </section>

  <section id="act" class="panel">
    <div class="panel-head">
      <div><span>01 · ACT</span><h2>One primary action, one conditional reserve, one hold</h2></div>
      <p><b>Question answered:</b> which partner should move now, which one needs a data condition, and which one should not be proactively engaged?</p>
    </div>
    <div class="priority-stack">
      {vm.priorities.map((priority) => {
        const direction = priority.directions[0];
        const institution = priority.institutions[0];
        return (
          <article class="priority-row">
            <div class="priority-rank">
              <b>{priority.rank}</b>
              <small>{priority.priorityClass}</small>
              {institution?.href ? <a href={href(institution.href)}>{institution.name}</a> : <span>{institution?.name ?? priority.id}</span>}
            </div>
            <div class="priority-decision">
              <span>DECISION</span>
              {direction ? <a href={href(`/directions/${direction.id}`)}><strong>{direction.recommendation}</strong></a> : <strong>{priority.recommendedAction}</strong>}
              <p>{direction?.collaborationFocus ?? priority.rationale}</p>
            </div>
            <div class="priority-why">
              <span>WHY RUSSIA STILL ADDS VALUE</span>
              <p>{direction?.residualDifferentiation ?? priority.rationale}</p>
            </div>
            <div class="priority-gate">
              <span>NEXT GATE</span>
              <p>{direction?.nextQuestion ?? direction?.nextGate ?? priority.recommendedAction}</p>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section id="compare" class="panel">
    <div class="panel-head">
      <div><span>02 · COMPARE</span><h2>China leads the product stack; Russia retains selective specialist value</h2></div>
      <p><b>Question answered:</b> after comparator pressure, where does a Russian capability still change a smartphone decision?</p>
    </div>

    <div class="compare-summary">
      <b>Portfolio conclusion</b>
      <p>Do not compare countries in the abstract. Retain only direction-level residuals that survive a stronger China/global baseline and still clear a phone-relevant validation gate.</p>
      <a href={href('/landscape')}>Open full comparison →</a>
    </div>

    <div class="matrix">
      {vm.landscape.map((row) => (
        <article class="compare-row">
          <div class="compare-top">
            <div class="dir">
              <a href={href(`/directions/${row.direction.id}`)}><b>{row.direction.title}</b></a>
              <span>{row.direction.phoneTransferMaturity} phone maturity</span>
            </div>
            <div class="decision">
              <small>DECISION</small>
              <strong>{row.direction.recommendation}</strong>
            </div>
            <div class="focus">
              <small>COLLABORATION FOCUS</small>
              <p>{row.direction.collaborationFocus ?? row.direction.residualDifferentiation}</p>
            </div>
          </div>
          <div class="compare-detail">
            <div class="baseline">
              <small>{row.chinaLabel}</small>
              <p>{row.chinaBaseline}</p>
              <a href={href('/research-map/china')}>Open China research map</a>
            </div>
            <div class="residual">
              <small>{row.russiaLabel}</small>
              <p>{row.russiaResidual}</p>
              <a href={href('/research-map/russia')}>Open Russia research map</a>
            </div>
            <div class="next">
              <small>NEXT VALIDATION QUESTION</small>
              <p>{row.direction.nextQuestion ?? row.direction.nextGate}</p>
              <a href={href(`/directions/${row.direction.id}`)}>Open direction</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="lower">
    <div class="panel reject">
      <div class="panel-head">
        <div><span>03 · REJECT</span><h2>Broad theses we should not invest in</h2></div>
        <p>Rejection is part of the portfolio conclusion, not an appendix.</p>
      </div>
      {vm.killDecisions.slice(0,4).map((decision) => (
        <article class="kill">
          <b>×</b>
          <div><strong>{decision.subject}</strong><p>{decision.rationale}</p></div>
          <a href={href(`/decisions#${decision.id}`)}>Audit decision</a>
        </article>
      ))}
      <a class="panel-link" href={href('/decisions')}>Open full decision history →</a>
    </div>

    <div class="panel frontier">
      <div class="panel-head">
        <div><span>04 · WATCH</span><h2>Frontier coverage</h2></div>
        <p>Discovery coverage only. Not evidence of partner readiness.</p>
      </div>
      <div class="numbers">
        <b>{vm.frontier.coveredVenueCount}/{vm.frontier.venueCount}</b><span>venues represented</span>
        <b>{vm.frontier.matchedEvidence}</b><span>matched evidence records</span>
        <b>{vm.frontier.latestYear ?? '—'}</b><span>latest evidence year</span>
      </div>
      <a class="panel-link" href={href('/frontier')}>Open Frontier Watch →</a>
    </div>
  </section>

  <style>
    :global(body){
      background:
        radial-gradient(circle at 78% 0%, rgba(110,185,255,.20), transparent 34rem),
        linear-gradient(180deg,#f7fbff 0%,#eef6fc 100%);
      color:#17324d;
    }

    .signal{
      display:grid;
      grid-template-columns:minmax(0,1.8fr) minmax(380px,.8fr);
      border:1px solid #cfe1ee;
      border-radius:18px;
      overflow:hidden;
      background:#fff;
      box-shadow:0 14px 38px rgba(42,96,140,.08);
    }

    .signal-copy{padding:34px}
    .tag,.panel-head span,.bar-title,.explore-strip>div>span{
      font-size:12px;color:#0a6bb7;font-weight:850;letter-spacing:.09em;text-transform:uppercase;
    }

    .signal h1{
      font-size:36px;line-height:1.1;max-width:980px;margin:10px 0 16px;letter-spacing:-.035em;color:#153955;
    }

    .signal-copy>p{max-width:930px;color:#4d6477;margin:0;font-size:16px;line-height:1.65}

    .signal-links{display:flex;gap:9px;flex-wrap:wrap;margin-top:22px}
    .signal-links a{display:inline-flex;align-items:center;min-height:34px;padding:8px 11px;border:1px solid #c9dfed;border-radius:9px;background:#f7fbfe;color:#0b67b2;font-size:12px;font-weight:800;text-decoration:none}
    .signal-links a:hover,.signal-links a:focus-visible{border-color:#88bce0;background:#edf7fd;outline:none}

    .scoreboard{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      align-content:center;
      gap:1px;
      background:#d8e8f4;
      border-left:1px solid #d8e8f4;
    }

    .scoreboard a{
      display:grid;align-content:center;gap:7px;padding:20px;background:linear-gradient(145deg,#e8f4ff,#f4faff);
      text-decoration:none;
    }

    .scoreboard b{font-size:34px;color:#0b5fa9}
    .scoreboard span{font-size:12px;color:#4f687b;font-weight:800;line-height:1.35}

    .basis,.panel,.explore-strip{
      margin-top:18px;border:1px solid #cfe1ee;background:#fff;border-radius:16px;overflow:hidden;
      box-shadow:0 10px 28px rgba(42,96,140,.05);
    }

    .bar-title{display:flex;justify-content:space-between;padding:13px 16px;border-bottom:1px solid #dbe8f1}
    .bar-title span:last-child{color:#708697;font-weight:700}
    .basis-grid{display:grid;grid-template-columns:repeat(3,1fr)}
    .basis-grid>div{display:grid;grid-template-columns:38px 1fr;gap:12px;padding:20px;border-right:1px solid #e0ebf3}
    .basis-grid>div:last-child{border-right:0}
    .basis-grid b{color:#0a6bb7;font-size:13px}
    .basis-grid p{margin:0;font-size:14px;line-height:1.6;color:#435d70}

    .management-strip{
      display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:18px;border:1px solid #cfe1ee;
      border-radius:16px;overflow:hidden;background:#d7e6f2;box-shadow:0 10px 28px rgba(42,96,140,.05)
    }

    .management-strip>article{display:grid;gap:8px;padding:20px;background:#fff;color:inherit}
    .management-strip>article:hover{background:#f8fcff}
    .management-strip>article>a{width:fit-content;color:#0b67b2;font-size:12px;font-weight:850;text-decoration:none}.management-strip>article>a:hover,.management-strip>article>a:focus-visible{text-decoration:underline;text-underline-offset:.16em}
    .management-strip span{font-size:11px;font-weight:850;letter-spacing:.08em;color:#0a6bb7}
    .management-strip b{font-size:15px;line-height:1.35;color:#173f5e}
    .management-strip p{margin:0;font-size:14px;line-height:1.58;color:#405d70}

    .explore-strip{display:flex;justify-content:space-between;gap:28px;padding:18px 20px;align-items:center}
    .explore-strip>div{display:grid;gap:5px}
    .explore-strip>div>b{font-size:14px;color:#294f6b}
    .explore-strip nav{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
    .explore-strip nav a{padding:7px 9px;border-radius:8px;background:#eef6fb;color:#315f80;font-size:11px;font-weight:800;text-decoration:none}

    .panel-head{
      display:flex;justify-content:space-between;gap:30px;padding:19px 20px;border-bottom:1px solid #dbe8f1;
      background:linear-gradient(180deg,#fbfdff,#f6faff);
    }

    .panel-head h2{font-size:20px;margin:4px 0 0;color:#183c59;letter-spacing:-.02em}
    .panel-head p{font-size:14px;line-height:1.55;color:#496276;max-width:540px;margin:0}

    .priority-stack{display:grid}
    .priority-row{display:grid;grid-template-columns:150px minmax(270px,1.05fr) minmax(260px,1fr) minmax(280px,1.05fr);border-bottom:1px solid #dfeaf2}
    .priority-row>div{padding:20px;border-right:1px solid #e4edf4}
    .priority-rank{display:grid;align-content:start;gap:8px;background:#f7fbfe}
    .priority-rank b{font-size:25px;color:#0b67b2}
    .priority-rank small{width:fit-content;padding:3px 6px;border-radius:999px;background:#eaf4fb;color:#315f80;font-size:9px;font-weight:900;text-transform:uppercase;letter-spacing:.05em}
    .priority-rank a,.priority-rank span{font-size:13px;font-weight:750;color:#36566e;text-decoration:none}
    .priority-decision{background:#f1fbf7}
    .priority-decision>a{text-decoration:none}
    .priority-row div>span{display:block;margin-bottom:7px;font-size:11px;font-weight:850;letter-spacing:.07em;color:#607c90}
    .priority-decision strong{font-size:15px;color:#087a66}
    .priority-row p{margin:8px 0 0;font-size:14px;line-height:1.62;color:#314d61}
    .priority-gate{background:#f7fbff}

    .compare-summary{display:grid;grid-template-columns:170px 1fr auto;gap:18px;padding:15px 20px;background:#eaf5fd;border-bottom:1px solid #d7e6f2;align-items:start}
    .compare-summary b{font-size:12px;color:#0a67b0;text-transform:uppercase;letter-spacing:.06em}
    .compare-summary p{margin:0;font-size:13px;line-height:1.55;color:#405c70}
    .compare-summary a{font-size:11px;font-weight:800;color:#0b67b2;text-decoration:none;white-space:nowrap}

    .matrix{display:grid;gap:18px;padding:18px;background:#f6fafd}
    .compare-row{border:1px solid #cfe1ee;border-radius:14px;overflow:hidden;background:#fff;box-shadow:0 8px 20px rgba(38,89,130,.05)}
    .compare-top{display:grid;grid-template-columns:230px 190px minmax(0,1fr);border-bottom:1px solid #dce8f1;background:linear-gradient(180deg,#fbfdff,#f7fbfe)}
    .compare-top>div,.compare-detail>div{padding:18px;border-right:1px solid #e4edf4}
    .dir{display:grid;gap:7px;border-left:4px solid #4c9fe0}
    .dir a{text-decoration:none}.dir b{font-size:15px;color:#254a66}
    .dir span,small{font-size:11px;color:#617b8f;text-transform:uppercase;letter-spacing:.05em}
    .decision strong{display:block;margin-top:5px;font-size:13px;line-height:1.45;color:#0878c4}
    .focus p,.matrix p{font-size:14px;line-height:1.62;color:#314d61;margin:.45rem 0 0}
    .compare-detail{display:grid;grid-template-columns:1fr 1fr 1fr;border-top:4px solid #f1f6fa}
    .compare-detail>div{display:block;color:inherit}
    .baseline{background:#edf6ff}.residual{background:#eef9f6}.next{background:#f8fbfd}
    .compare-detail>div>a{display:inline-block;margin-top:10px;color:#0b67b2;font-size:11px;font-weight:850;text-decoration:none}.compare-detail>div>a:hover,.compare-detail>div>a:focus-visible{text-decoration:underline;text-underline-offset:.16em}

    .lower{display:grid;grid-template-columns:1.5fr .7fr;gap:18px}
    .kill{display:grid;grid-template-columns:34px 1fr auto;gap:10px;padding:16px 20px;border-bottom:1px solid #e0ebf3;font-size:13px;color:#344f63}
    .kill:hover{background:#fffafa}.kill>a{align-self:start;color:#0b67b2;font-size:11px;font-weight:850;text-decoration:none;white-space:nowrap}.kill>a:hover,.kill>a:focus-visible{text-decoration:underline;text-underline-offset:.16em}
    .kill>b{color:#c65454;font-size:16px}.kill strong{font-size:13px;color:#36536a}.kill p{margin:5px 0 0;color:#607688;line-height:1.5}
    .numbers{display:grid;grid-template-columns:auto 1fr;gap:14px 16px;padding:22px}
    .numbers b{font-size:28px;color:#0b64aa}.numbers span{font-size:12px;color:#5e7486;align-self:center;line-height:1.35}
    .panel-link{display:block;width:fit-content;margin:0 20px 18px;color:#0b67b2;font-size:12px;font-weight:850;text-decoration:none}

    @media(max-width:900px){
      .signal,.lower{grid-template-columns:1fr}
      .scoreboard{grid-template-columns:repeat(3,1fr);border-left:0;border-top:1px solid #d8e8f4}
      .basis-grid,.management-strip{grid-template-columns:1fr}
      .basis-grid>div{border-right:0;border-bottom:1px solid #e0ebf3}
      .priority-row,.compare-top,.compare-detail,.compare-summary{grid-template-columns:1fr}
      .priority-row>div,.compare-top>div,.compare-detail>div{border-right:0;border-bottom:1px solid #e4edf4}
      .explore-strip{align-items:flex-start;flex-direction:column}
      .explore-strip nav{justify-content:flex-start}
    }

    @media(max-width:640px){
      .signal h1{font-size:29px}
      .scoreboard{grid-template-columns:1fr}
      .signal-copy{padding:22px}
      .scoreboard a{padding:15px 20px}
    }
  </style>
</BaseLayout>
