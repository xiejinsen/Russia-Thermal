---
import ResearchVisualWorld from '../components/ResearchVisualWorld.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { questionCloseouts } from '../data/load-normalized';
import { currentActionBoundary } from '../view-models/action-boundary';

const base=import.meta.env.BASE_URL;
const href=(path:string)=>path==='/'?base:base+path.replace(/^\//,'');
const publicResearchAccepted=questionCloseouts.length;
const valueLanes=[
 {index:'01',label:'失效机理',name:'Dryout / 局部干斑演化',finding:'俄罗斯实验团队提供沸腾临界状态的红外与光学诊断研究，可作为失效状态标注方法的候选来源。',boundary:'研究装置不是手机密闭均热板；标注能否改进手机级验证仍需实验。',link:'/papers/PAPER-RU-DRY-001'},
 {index:'02',label:'长期退化',name:'毛细状态与运行寿命',finding:'MPEI 已有长时间运行后毛细状态变化的公开结果，可为长期可靠性研究提出新的追问。',boundary:'目前不是连续的早期退化时序证据，不能宣称已经实现寿命预警。',link:'/papers/PAPER-RU-AGE-001'},
 {index:'03',label:'专项方法',name:'润湿、瞬态与两相限制',finding:'俄罗斯部分团队在表面工程、相变瞬态模型及薄型两相系统边界方面具有可检索研究。',boundary:'对手机厚度、封装、成本和噪声的增量价值尚未确证。',link:'/capabilities'}
];
const decisions=[
 {order:'01',state:'优先开展可行性研究',name:'Kutateladze · 局部干涸状态诊断',summary:'目标是检验可重复的状态标签能否改善现有手机热管理验证，而不是直接引入新的散热器件。',requirement:'验证条件：可获取的实验标注、可重复性与相对于现有验证方法的增益。',href:'/institutions/ACT-KUTATELADZE',tone:'primary'},
 {order:'02',state:'条件性研究储备',name:'MPEI · 长期毛细退化研究',summary:'公开研究给出了长期运行终点状态，可为寿命研究提出研究问题。',requirement:'验证条件：中间状态数据、对设备退化的预测能力和使用授权。',href:'/institutions/ACT-MPEI',tone:'reserve'},
 {order:'03',state:'暂不推进',name:'TPU · 表面处理及润湿性研究',summary:'公开研究有学术价值，但尚不能证明相比国内手机工程实践具有可迁移的增量。',requirement:'重新评估条件：出现器件条件匹配的重复实验增益。',href:'/institutions/ACT-TPU',tone:'hold'}
];
---
<BaseLayout title="俄罗斯热管理科研洞察 | Russia-Thermal" description="俄罗斯热管理科研机构、研究证据、中俄技术对照与手机迁移边界" immersive>
 <SiteHeader slot="header"/>
 <ResearchVisualWorld/>
 <div class="homepage-story">
  <section class="thesis" aria-labelledby="home-thesis">
   <div class="thesis-main">
    <p class="kicker">RESEARCH SYNTHESIS / OCTOBER 2026</p>
    <h2 id="home-thesis">俄罗斯研究的补充价值在于<strong>失效机理、长期退化与专项研究方法</strong></h2>
    <p>从公开论文出发，俄罗斯的差异化机会更可能体现在科学观察和实验研究方法，而不是替代国内的手机均热板制造、整机集成与可靠性体系。</p>
    <div class="thesis-actions">
     <a class="button-primary" href={href('/research-questions')}>查看 {publicResearchAccepted} 项研究问题结论 ↗</a>
     <a href={href('/landscape')}>中俄与国际证据对照 ↗</a>
    </div>
   </div>
   <aside class="thesis-boundary">
    <span>SCIENTIFIC EVIDENCE ≠ PRODUCT PERFORMANCE</span>
    <b>公开证据尚不能证明俄罗斯方案具有手机器件级散热优势</b>
    <p>已确认的研究发现，与可部署的产品技术、数据获取权及合作意愿是不同层次的问题。</p>
    <a href={href('/smartphone-transfer')}>手机工程迁移边界 ↗</a>
   </aside>
  </section>

  <section class="research-values" aria-labelledby="value-heading">
   <div class="heading-line">
    <div><p class="kicker">02 / EVIDENCE-DRIVEN DIFFERENTIATION</p><h2 id="value-heading">哪些科学研究能够形成互补？</h2></div>
    <a href={href('/landscape')}>完整技术对照 ↗</a>
   </div>
   <div class="value-grid">
    {valueLanes.map(lane=><article class="value-card">
     <div class="value-top"><span>{lane.index}</span><small>{lane.label}</small></div>
     <h3>{lane.name}</h3>
     <p>{lane.finding}</p>
     <div class="transfer-limit"><strong>证据边界</strong><p>{lane.boundary}</p></div>
     <a href={href(lane.link)}>研究来源与能力档案 ↗</a>
    </article>)}
   </div>
   <div class="paper-feature">
    <div class="paper-identity"><p class="kicker">FEATURED ORIGINAL PAPER · 2026</p><h3>从局部 Dryout 研究到可检验的失效状态标签</h3><p>Surtaev 等人的介电液体沸腾实验，利用红外与光学观测记录临界热流附近的干斑演化。</p><small>开放沸腾实验 · 非手机密闭均热板测试</small></div>
    <div class="paper-links">
     <a href="https://doi.org/10.1016/j.ijheatmasstransfer.2025.127855" target="_blank" rel="noopener noreferrer">Surtaev et al. · <i>Investigation of heat transfer, critical heat flux and dry spots dynamics during boiling of dielectric fluids HFE-7100 and Novec 649</i> ↗</a>
     <a href={href('/papers/PAPER-RU-DRY-001')}>查看论文发现与限制 ↗</a>
     <a href={href('/claims/CLM-PAV-002')}>查看相关 Claim ↗</a>
    </div>
   </div>
  </section>

  <section class="decision-section" aria-labelledby="decision-heading">
   <div class="heading-line">
    <div><p class="kicker">03 / COLLABORATION DECISION</p><h2 id="decision-heading">哪些方向值得继续验证？</h2></div>
    <a href={href('/partners')}>完整合作方向 ↗</a>
   </div>
   <div class="decision-list">
    {decisions.map(item=><article class:list={['decision-item',item.tone]}>
     <div class="decision-basis"><span>{item.order}</span><strong>{item.state}</strong></div>
     <div class="decision-copy"><h3>{item.name}</h3><p>{item.summary}</p><small>{item.requirement}</small></div>
     <a href={href(item.href)} aria-label={'查看'+item.name+'机构档案'}>机构档案 ↗</a>
    </article>)}
   </div>
   <div class="decision-action">
    <div><p class="kicker">CURRENT ACTION BOUNDARY</p><h3>{currentActionBoundary.titleZh}</h3><p>{currentActionBoundary.detailZh} MPEI 继续条件研究储备，TPU 保持暂不推进。</p></div>
    <a href={href('/research-packages')}>研究工作包与批准条件 ↗</a>
   </div>
  </section>
  <footer class="home-footer">
   <div><p class="kicker">TRACEABLE RESEARCH / SOURCE OF TRUTH</p><h2>从结论追溯到机构、论文与原始证据</h2></div>
   <div class="source-links">
    <a href={href('/russia-atlas')}>俄罗斯科研能力 Atlas ↗</a>
    <a href={href('/evidence')}>原始证据目录 ↗</a>
    <a href={href('/claims')}>研究主张与反证 ↗</a>
    <a href={href('/site-directory')}>全部研究内容 ↗</a>
   </div>
  </footer>
 </div>
</BaseLayout>
<style>
:global(main){max-width:1380px;padding-top:0}
.homepage-story{display:grid;gap:26px;padding-bottom:54px;color:#183249}
.homepage-story>section,.home-footer{border-radius:17px;overflow:hidden}
.kicker{color:#176d95;font-size:11px;letter-spacing:.12em;font-weight:850;margin:0}
.thesis{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(285px,.73fr);background:linear-gradient(130deg,#edf7fd,#dbeefa);border:1px solid #467998;box-shadow:0 14px 36px #00182836}
.thesis-main{padding:clamp(26px,4vw,52px)}.thesis h2{font-size:clamp(29px,3.45vw,47px);line-height:1.35;letter-spacing:-.03em;color:#14334c;margin:17px 0 20px}
.thesis h2 strong{color:#075c83;font-weight:850}.thesis-main>p:not(.kicker){font-size:17px;line-height:1.86;color:#314d61;max-width:65ch}
.thesis-actions{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-top:26px}.thesis-actions a{color:#0d6089;font-size:14px;font-weight:800;text-decoration:none}
.thesis-actions a.button-primary{padding:13px 17px;background:#116b95;border-radius:8px;color:white}.thesis-actions a:hover,.heading-line a:hover,.home-footer a:hover{text-decoration:underline}
.thesis-boundary{padding:clamp(24px,3vw,40px);display:flex;flex-direction:column;justify-content:center;background:#0a3656;color:#e3f6fc}
.thesis-boundary span{font-size:11px;color:#81daf7;letter-spacing:.11em;font-weight:800}.thesis-boundary b{font-size:22px;line-height:1.4;color:white;margin:18px 0 12px}.thesis-boundary p{font-size:14px;line-height:1.8;color:#d4e9f4;margin:0 0 18px}.thesis-boundary a{color:#9eeeff;font-size:13px;font-weight:800}
.research-values,.decision-section{background:#e9f4fb;padding:clamp(22px,3.2vw,42px);border:1px solid #a8c9dd}
.heading-line{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:23px}.heading-line h2{color:#173b54;font-size:clamp(23px,2.6vw,32px);line-height:1.35;margin:9px 0 0}.heading-line a{font-size:13px;color:#0c638d;font-weight:800;text-decoration:none;white-space:nowrap}
.value-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.value-card{display:flex;flex-direction:column;background:white;border:1px solid #c1d9e8;border-radius:13px;padding:23px;min-width:0}.value-top{display:flex;align-items:center;gap:10px}.value-top span{font-size:25px;font-weight:850;color:#2c8cb2}.value-top small{font-size:12px;font-weight:800;color:#487087}.value-card h3{font-size:18px;line-height:1.4;color:#183950;margin:13px 0 11px}.value-card>p{font-size:14px;line-height:1.75;color:#375269;margin:0 0 20px;flex:1}
.transfer-limit{border-top:1px solid #d7e5ec;padding-top:14px}.transfer-limit strong{font-size:12px;color:#0c648c}.transfer-limit p{color:#587085;font-size:13px;line-height:1.7;margin:5px 0 13px}.value-card>a{margin-top:auto;font-weight:850;font-size:12px;color:#0b638e;text-decoration:none}
.paper-feature{display:grid;grid-template-columns:1.1fr 1fr;gap:30px;align-items:center;padding:26px 30px;border-radius:13px;margin-top:17px;background:linear-gradient(110deg,#d5e9f5,#f5fbff);border:1px solid #b9d3e5}.paper-identity h3{color:#173b53;font-size:21px;margin:10px 0}.paper-identity p{font-size:14px;line-height:1.8;color:#3c5b70}.paper-identity small{font-size:12px;color:#476b85}.paper-links{display:grid;gap:11px;border-left:2px solid #b3d2e5;padding-left:20px}.paper-links a{font-size:13px;line-height:1.7;color:#135d88;font-weight:700;text-decoration:none}
.decision-list{display:grid;gap:10px}.decision-item{display:grid;grid-template-columns:175px minmax(0,1fr) auto;gap:20px;align-items:center;border:1px solid #c4d9e7;border-radius:12px;background:white;padding:22px}.decision-basis{display:grid;gap:7px}.decision-basis span{color:#337d9f;font-size:25px;font-weight:850}.decision-basis strong{font-size:13px;color:#205a7a}.decision-item.reserve .decision-basis strong{color:#4d6680}.decision-item.hold .decision-basis strong{color:#5c6e7d}.decision-copy h3{font-size:17px;color:#173b54;line-height:1.35;margin:0 0 7px}.decision-copy p{font-size:13px;line-height:1.75;color:#496176;margin:0 0 7px}.decision-copy small{font-size:12px;line-height:1.6;color:#597384}.decision-item>a{white-space:nowrap;font-weight:850;font-size:13px;color:#0c618b;text-decoration:none}
.decision-action{display:flex;justify-content:space-between;align-items:center;gap:24px;background:#d8eaf5;padding:24px;margin-top:16px;border-left:4px solid #1b739d;border-radius:8px}.decision-action h3{font-size:20px;line-height:1.45;margin:8px 0;color:#153b56}.decision-action p{font-size:13px;color:#3c596d;line-height:1.7}.decision-action>a{font-size:13px;font-weight:850;color:#0b648d;flex:0 0 auto}
.home-footer{display:flex;justify-content:space-between;align-items:center;gap:26px;padding:34px;background:#0a2d4b;border:1px solid #286082;color:#e4f6ff}.home-footer .kicker{color:#82d9f8}.home-footer h2{color:white;font-size:21px;line-height:1.4;margin:9px 0 0}.source-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 22px}.source-links a{white-space:nowrap;color:#b5ebff;font-size:13px;text-decoration:none;font-weight:800}
@media(max-width:970px){.thesis,.paper-feature{grid-template-columns:1fr}.value-grid{grid-template-columns:1fr 1fr}.paper-links{border-left:none;border-top:1px solid #b3d2e5;padding:16px 0 0}.decision-item{grid-template-columns:130px minmax(0,1fr)}.decision-item>a{grid-column:2}}
@media(max-width:690px){.value-grid{grid-template-columns:1fr}.research-values,.decision-section{padding:22px 16px}.heading-line{align-items:start;flex-direction:column}.decision-item{grid-template-columns:1fr;gap:10px;padding:18px}.decision-basis{display:flex;align-items:center}.decision-item>a{grid-column:1}.decision-action,.home-footer{flex-direction:column;align-items:start}.source-links{grid-template-columns:1fr}.thesis-main{padding:24px}.thesis-boundary{padding:26px}.paper-feature{padding:19px}}
@media(prefers-reduced-motion:reduce){.homepage-story *{scroll-behavior:auto}}
</style>