---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StatStrip from '../components/StatStrip.astro';
import SectionHeader from '../components/SectionHeader.astro';
import InstitutionCard from '../components/cards/InstitutionCard.astro';
import ScholarCard from '../components/cards/ScholarCard.astro';
import DirectionCard from '../components/cards/DirectionCard.astro';
import { buildOverviewVM } from '../view-models/builders';

const vm = buildOverviewVM();
---

<BaseLayout title="Russia-Thermal — Overview" description={vm.summary}>
  <SiteHeader slot="header" />

  <section class="hero">
    <p class="eyebrow">{vm.eyebrow}</p>
    <h1>{vm.title}</h1>
    <p>{vm.summary}</p>
  </section>

  <StatStrip items={[
    { label: 'Institutions / labs', value: vm.stats.institutions },
    { label: 'People', value: vm.stats.people },
    { label: 'Capabilities', value: vm.stats.capabilities },
    { label: 'Directions', value: vm.stats.directions },
    { label: 'Active / reserve', value: vm.stats.activeDirections }
  ]} />

  <section class="page-section">
    <SectionHeader
      eyebrow="Portfolio"
      title="Retained directions"
      description="Ordered by canonical investment lane; cards are built from normalized Direction records."
    />
    <div class="content-grid">
      {vm.directions.map((model) => <DirectionCard model={model} />)}
    </div>
  </section>

  <section class="page-section">
    <SectionHeader
      eyebrow="Actors"
      title="Institutions and labs connected to retained directions"
      description="Resolved through Direction → Capability → Actor relations."
    />
    <div class="content-grid">
      {vm.institutions.map((model) => <InstitutionCard model={model} />)}
    </div>
  </section>

  <section class="page-section">
    <SectionHeader
      eyebrow="People"
      title="Key people connected through capabilities"
      description="Affiliation and role come from normalized Actor records."
    />
    <div class="content-grid">
      {vm.scholars.map((model) => <ScholarCard model={model} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .page-section {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-16);
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
  }
</style>
