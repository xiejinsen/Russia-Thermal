---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ExplorerLinkStrip from '../../components/ExplorerLinkStrip.astro';
import DetailHero from '../../components/detail/DetailHero.astro';
import MetricStrip from '../../components/detail/MetricStrip.astro';
import EvidencePressure from '../../components/detail/EvidencePressure.astro';
import RelationPath from '../../components/detail/RelationPath.astro';
import { buildDirectionPageVM, directionIds } from '../../view-models/builders';

export function getStaticPaths() {
  return directionIds().map((id) => ({ params: { id } }));
}

const id = Astro.params.id!;
const vm = buildDirectionPageVM(id);
if (!vm) throw new Error(`Unknown direction: ${id}`);

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
const laneTone =
  vm.direction.lane.tone === 'critical' ? 'critical' :
  vm.direction.lane.tone === 'warning' ? 'warning' :
  vm.direction.lane.tone === 'positive' ? 'positive' : 'neutral';
---

<BaseLayout title={`Russia-Thermal — ${vm.direction.title}`} description={vm.direction.collaborationFocus ?? vm.direction.problem}>
  <SiteHeader slot="header" />

  <DetailHero
    eyebrow={`Direction detail · ${vm.direction.role}`}
    title={vm.direction.title}
    summary={vm.direction.collaborationFocus ?? vm.direction.problem}
    meta={[
      `Phone maturity · ${vm.direction.phoneTransferMaturity}`,
      `Differentiation · ${vm.direction.differentiationConfidence}`
    ]}
    badge={vm.direction.lane.label}
    badgeTone={laneTone}
  >
    <div slot="actions">
      <ExplorerLinkStrip
        links={[
          { label: 'Claims', href: href(`/claims?direction=${encodeURIComponent(vm.direction.id)}`) },
          { label: 'Papers', href: href(`/papers?direction=${encodeURIComponent(vm.direction.id)}`) },
          { label: 'All Evidence', href: href(`/evidence?direction=${encodeURIComponent(vm.direction.id)}`), primary: true }
        ]}
      />
    </div>
    <MetricStrip
      slot="aside"
      items={[
        { label: 'Sources', value: vm.evidenceStats.evidenceCount },
        { label: 'Deep Reads', value: vm.evidenceStats.deepReadCount },
        { label: 'Claims', value: vm.evidenceStats.claimCount },
        { label: 'Capabilities', value: vm.capabilities.length }
      ]}
    />
  </DetailHero>

  <div class="detail-stack">
    <EvidencePressure
      russia={vm.evidenceStats.russiaSourceCount}
      comparator={vm.evidenceStats.comparatorSourceCount}
      deepReads={vm.evidenceStats.deepReadCount}
      total={vm.evidenceStats.evidenceCount}
      papers={vm.evidenceStats.paperCount}
      patents={vm.evidenceStats.patentCount}
      baseline={vm.strongestBaseline}
      residual={vm.direction.residualDifferentiation}
    />

    <RelationPath
      nodes={[
        { label: 'Direction', value: vm.direction.lane.label },
        { label: 'Capabilities', value: vm.capabilities.length },
        { label: 'Scholars', value: vm.scholars.length },
        { label: 'Claims', value: vm.evidenceStats.claimCount, href: href(`/claims?direction=${encodeURIComponent(vm.direction.id)}`) },
        { label: 'Evidence', value: vm.evidenceStats.evidenceCount, href: href(`/evidence?direction=${encodeURIComponent(vm.direction.id)}`) },
        { label: 'Decisions', value: vm.decisions.length }
      ]}
    />

    <section class="thesis-grid">
      {vm.direction.problem && <article>
        <span>Problem</span>
        <h2>What problem is worth solving?</h2>
        <p>{vm.direction.problem}</p>
      </article>}
      {vm.strongestBaseline && <article class="baseline">
        <span>China / global baseline</span>
        <h2>What must the Russian hypothesis beat?</h2>
        <p>{vm.strongestBaseline}</p>
      </article>}
      {vm.direction.residualDifferentiation && <article class="residual">
        <span>Surviving Russia residual</span>
        <h2>What is still plausibly differentiated?</h2>
        <p>{vm.direction.residualDifferentiation}</p>
      </article>}
      {vm.direction.ourControlBoundary && <article>
        <span>Internal control boundary</span>
        <h2>What must remain internally owned?</h2>
        <p>{vm.direction.ourControlBoundary}</p>
      </article>}
    </section>

    <section class="gate-panel">
      <div>
        <p class="section-kicker">Decision gate</p>
        <h2>The direction advances only if evidence changes the decision</h2>
      </div>
      <div class="gate-grid">
        {vm.direction.nextQuestion && <article><span>Next question</span><p>{vm.direction.nextQuestion}</p></article>}
        {vm.direction.nextGate && <article class="promote"><span>Promotion gate</span><p>{vm.direction.nextGate}</p></article>}
        {vm.direction.killGate && <article class="kill"><span>Kill / downgrade gate</span><p>{vm.direction.killGate}</p></article>}
      </div>
    </section>

    <section class="panel">
      <header class="panel-head">
        <div><p class="section-kicker">Actors + capability</p><h2>Who owns the mechanism and what can they actually do?</h2></div>
        <span>{vm.institutions.length} institutions · {vm.scholars.length} scholars</span>
      </header>
      <div class="actor-cap-grid">
        <div class="actor-side">
          <h3>Institutions / labs</h3>
          {vm.institutions.map((inst) => <a href={href(inst.href ?? `/institutions/${inst.id}`)}>
            <div><b>{inst.name}</b><span>{inst.kindLabel} · {inst.country}</span></div>
            <p>{inst.summary}</p>
          </a>)}
          {vm.scholars.length > 0 && <div class="scholar-strip">
            <h3>Key scholars</h3>
            <div>{vm.scholars.map((scholar) => <a href={href(scholar.href ?? `/scholars/${scholar.id}`)}>{scholar.name}</a>)}</div>
          </div>}
        </div>
        <div class="capability-side">
          <h3>Linked capabilities</h3>
          {vm.capabilities.map((capability) => <article>
            <a href={href(`/capabilities/${capability.id}`)}>{capability.statement}</a>
            <div class="cap-meta">
              <span>Maturity · {capability.maturity}</span>
              <span>Evidence · {capability.evidenceConfidence}</span>
              <span>Target fit · {capability.targetFit}</span>
            </div>
            {capability.transferBoundary && <p>{capability.transferBoundary}</p>}
          </article>)}
        </div>
      </div>
    </section>

    <section class="panel">
      <header class="panel-head">
        <div><p class="section-kicker">Claims</p><h2>Claims that support, constrain or pressure the direction</h2></div>
        <a href={href(`/claims?direction=${encodeURIComponent(vm.direction.id)}`)}>All {vm.claims.length} claims →</a>
      </header>
      <div class="claim-list">
        {vm.claims.slice(0, 10).map((claim) => <a href={href(claim.href)}>
          <div class="claim-state"><span>{claim.status}</span><small>{claim.confidence}</small></div>
          <b>{claim.proposition}</b>
          <strong>Open →</strong>
        </a>)}
      </div>
      {vm.claims.length > 10 && <p class="more-note">Showing 10 representative claims. The summary metrics above use the complete set linked to this direction.</p>}
    </section>

    <section class="panel">
      <header class="panel-head">
        <div><p class="section-kicker">Evidence</p><h2>Primary sources behind the surviving thesis</h2></div>
        <a href={href(`/evidence?direction=${encodeURIComponent(vm.direction.id)}`)}>All {vm.evidence.length} sources →</a>
      </header>
      <div class="evidence-list">
        {vm.evidence.slice(0, 12).map((item) => <article>
          <div class="source-meta">
            <span>{item.year ?? 'n.d.'}</span>
            <span>{item.sourceType}</span>
            {item.countryContext && <span>{item.countryContext}</span>}
            {item.deepReadLevel && <span class="deep">{item.deepReadLevel}</span>}
          </div>
          <div class="source-copy">
            <h3>{item.title}</h3>
            {item.findings[0] && <p>{item.findings[0]}</p>}
            <small>{item.supportingClaims.length} supporting · {item.contradictingClaims.length} pressure claims</small>
          </div>
          <div class="source-actions">
            {item.id.startsWith('PAPER-') && <a href={href(`/papers/${item.id}`)}>Open detail →</a>}
            {item.id.startsWith('PATENT-') && <a href={href(`/patents/${item.id}`)}>Patent detail →</a>}
            <a href={item.primaryUrl} target="_blank" rel="noreferrer">Original ↗</a>
          </div>
        </article>)}
      </div>
      {vm.evidence.length > 12 && <p class="more-note">Showing 12 representative sources. Evidence Pressure uses the complete source set linked to this direction.</p>}
    </section>

    <section class="panel">
      <header class="panel-head">
        <div><p class="section-kicker">Decision history</p><h2>How the direction changed after comparator pressure</h2></div>
        <span>{vm.decisions.length} recorded events</span>
      </header>
      {vm.decisions.length > 0 ? <div class="decision-list">
        {vm.decisions.map((event) => <article>
          <div class="decision-state">
            <span>{event.date ?? 'undated'} · {event.eventType.label}</span>
            <b>{event.previousState ?? '—'} → {event.newState}</b>
          </div>
          <p>{event.rationale ?? 'No concise rationale is currently recorded for this event.'}</p>
          {event.reopenCondition && <small>Reopen only if: {event.reopenCondition}</small>}
        </article>)}
      </div> : <p class="empty">No decision event is currently recorded specifically for this direction.</p>}
    </section>
  </div>
</BaseLayout>

<style>
  .detail-stack{display:grid;gap:1rem;margin-top:1rem}
  .section-kicker{margin:0;color:var(--accent-vivid);font-size:.62rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}
  .thesis-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .thesis-grid article,.gate-panel,.panel{border:1px solid var(--line);border-radius:1rem;background:var(--surface)}
  .thesis-grid article{padding:1.1rem;border-top:3px solid #8ca9bc}
  .thesis-grid article.baseline{border-top-color:#5d98c4;background:#f5faff}
  .thesis-grid article.residual{border-top-color:#5b9b82;background:#f5fbf8}
  .thesis-grid span,.gate-grid span{font-size:.61rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase;color:#667f92}
  .thesis-grid h2,.gate-panel h2{margin:.35rem 0 0;font-size:1.05rem;letter-spacing:-.025em}
  .thesis-grid p,.gate-grid p{margin:.55rem 0 0;color:var(--text-muted);font-size:.76rem;line-height:1.65}
  .gate-panel{padding:1.1rem}
  .gate-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;margin-top:1rem}
  .gate-grid article{padding:.85rem;border:1px solid var(--line);border-radius:.7rem;background:#fafcfe}
  .gate-grid .promote{border-color:#c8e4d7;background:#f4faf7}
  .gate-grid .promote span{color:var(--positive)}
  .gate-grid .kill{border-color:#ead0d0;background:#fff8f8}
  .gate-grid .kill span{color:var(--critical)}
  .panel{overflow:hidden}
  .panel-head{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding:1rem 1.1rem;border-bottom:1px solid var(--line);background:#f9fcfe}
  .panel-head h2{margin:.28rem 0 0;font-size:1.1rem;letter-spacing:-.03em}
  .panel-head>span,.panel-head>a{font-size:.67rem;color:#6c8394;font-weight:800;text-decoration:none}
  .actor-cap-grid{display:grid;grid-template-columns:minmax(18rem,.7fr) minmax(0,1.3fr)}
  .actor-side,.capability-side{padding:1rem}
  .actor-side{border-right:1px solid var(--line)}
  .actor-side>h3,.capability-side>h3,.scholar-strip h3{margin:0 0 .45rem;font-size:.72rem;color:#5e7486}
  .actor-side>a{display:grid;grid-template-columns:minmax(10rem,.55fr) minmax(0,1fr);gap:.8rem;padding:.75rem 0;border-top:1px solid #e8eff4;text-decoration:none}
  .actor-side>a div{display:grid;gap:.12rem}
  .actor-side>a b{font-size:.76rem}
  .actor-side>a span{font-size:.6rem;color:#708798}
  .actor-side>a p{margin:0;color:#61798b;font-size:.68rem;line-height:1.5}
  .scholar-strip{margin-top:1rem;padding-top:.8rem;border-top:1px solid var(--line)}
  .scholar-strip>div{display:flex;gap:.38rem;flex-wrap:wrap}
  .scholar-strip a{padding:.33rem .45rem;border-radius:.42rem;background:#edf5fa;color:#2b5672;font-size:.65rem;font-weight:750;text-decoration:none}
  .capability-side article{padding:.85rem 0;border-top:1px solid #e8eff4}
  .capability-side article>a{font-size:.78rem;font-weight:850;line-height:1.45;color:#153f5e;text-decoration:none}
  .cap-meta{display:flex;gap:.35rem;flex-wrap:wrap;margin-top:.4rem}
  .cap-meta span{padding:.25rem .36rem;border-radius:.35rem;background:#f0f5f8;color:#647d90;font-size:.58rem}
  .capability-side article p{margin:.45rem 0 0;color:#708596;font-size:.66rem;line-height:1.5}
  .claim-list a{display:grid;grid-template-columns:8.5rem minmax(0,1fr) auto;gap:1rem;align-items:start;padding:.85rem 1.1rem;border-bottom:1px solid #e8eff4;text-decoration:none}
  .claim-state{display:grid;gap:.12rem}
  .claim-state span{font-size:.62rem;font-weight:850;color:#285f84}
  .claim-state small{font-size:.58rem;color:#7890a0}
  .claim-list b{font-size:.76rem;line-height:1.5}
  .claim-list strong{font-size:.65rem;color:#0b67b2;white-space:nowrap}
  .evidence-list article{display:grid;grid-template-columns:10rem minmax(0,1fr) auto;gap:1rem;padding:.9rem 1.1rem;border-bottom:1px solid #e8eff4}
  .source-meta{display:flex;align-content:start;gap:.3rem;flex-wrap:wrap}
  .source-meta span{height:max-content;padding:.23rem .35rem;border-radius:.35rem;background:#f1f6f9;color:#667f91;font-size:.58rem;font-weight:800}
  .source-meta .deep{background:#e8f4ef;color:var(--positive)}
  .source-copy h3{margin:0;font-size:.78rem;line-height:1.45}
  .source-copy p{margin:.32rem 0 0;color:#61798b;font-size:.68rem;line-height:1.5}
  .source-copy small{display:block;margin-top:.35rem;color:#8294a1;font-size:.6rem}
  .source-actions{display:grid;gap:.34rem;justify-items:end}
  .source-actions a{font-size:.65rem;color:#0b67b2;font-weight:800;text-decoration:none;white-space:nowrap}
  .decision-list article{display:grid;grid-template-columns:minmax(14rem,.55fr) minmax(0,1.1fr);gap:1rem;padding:.9rem 1.1rem;border-bottom:1px solid #e8eff4}
  .decision-state{display:grid;gap:.18rem}
  .decision-state span{font-size:.6rem;color:#6b8293;text-transform:uppercase}
  .decision-state b{font-size:.72rem}
  .decision-list p{margin:0;color:#5e7688;font-size:.7rem;line-height:1.55}
  .decision-list small{grid-column:2;color:#8a6e4f;font-size:.63rem}
  .more-note,.empty{margin:0;padding:.7rem 1.1rem;color:#758a9a;font-size:.65rem}
  @media(max-width:860px){
    .thesis-grid,.gate-grid,.actor-cap-grid{grid-template-columns:1fr}
    .actor-side{border-right:0;border-bottom:1px solid var(--line)}
    .claim-list a,.evidence-list article,.decision-list article{grid-template-columns:1fr}
    .source-actions{justify-items:start}
    .decision-list small{grid-column:1}
  }
</style>
