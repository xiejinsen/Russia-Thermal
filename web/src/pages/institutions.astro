---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import DenseObjectRow from '../components/DenseObjectRow.astro';
import ExplorerToolbar from '../components/ExplorerToolbar.astro';
import { actors, capabilities, directions, priorities } from '../data/load-normalized';
import { buildInstitutionsCollectionVM } from '../view-models/builders';
import { directionTitle, humanize } from '../view-models/helpers';

const vm = buildInstitutionsCollectionVM();
const actorById = new Map(actors.map((actor) => [actor.id, actor]));

function descendantIds(rootId: string) {
  const ids = new Set<string>([rootId]);
  let changed = true;
  while (changed) {
    changed = false;
    for (const actor of actors) {
      if (actor.parentId && ids.has(actor.parentId) && !ids.has(actor.id)) {
        ids.add(actor.id);
        changed = true;
      }
    }
  }
  return ids;
}

const researchSortOrder = { PRIMARY: 0, SELECTIVE: 1, CONTEXT_ONLY: 2 } as const;

const records = vm.records.map((model) => {
  const actor = actorById.get(model.id);
  const scopedIds = descendantIds(model.id);
  const scopedCapabilities = capabilities.filter((capability) => scopedIds.has(capability.actorId));
  const capabilityIds = new Set(scopedCapabilities.map((capability) => capability.id));
  const linkedDirections = directions.filter((direction) =>
    direction.capabilityIds.some((id) => capabilityIds.has(id))
  );
  const priorityRanks = priorities
    .filter((priority) => priority.targetActorIds.some((id) => scopedIds.has(id)))
    .map((priority) => priority.rank);
  const dispositions = [...new Set(scopedCapabilities.map((capability) => capability.portfolioDisposition))];
  const relations = [
    ...(priorityRanks.length ? ['PRIORITY'] : []),
    ...dispositions,
    ...(!scopedCapabilities.length ? ['NO_CAPABILITY'] : [])
  ];
  const parent = actor?.parentId ? actorById.get(actor.parentId) : undefined;
  const peopleNames = [...new Set([
    ...scopedCapabilities.flatMap((capability) => capability.keyPeopleIds),
    ...actors.filter((person) => person.type === 'PERSON' && person.parentId && scopedIds.has(person.parentId)).map((person) => person.id)
  ])]
    .map((id) => actorById.get(id)?.name)
    .filter((value): value is string => Boolean(value));

  return {
    model,
    actor,
    parent,
    priorityRanks,
    dispositions,
    relations,
    directionIds: linkedDirections.map((direction) => direction.id),
    linkedDirections,
    scopedCapabilities,
    peopleNames,
    search: [
      model.name,
      model.summary,
      actor?.city ?? '',
      actor?.region ?? '',
      parent?.name ?? '',
      ...peopleNames,
      ...scopedCapabilities.map((capability) => capability.statement),
      ...linkedDirections.map((direction) => directionTitle(direction.id))
    ].join(' ')
  };
}).sort((a, b) => {
  const ad = a.actor?.researchDepth as keyof typeof researchSortOrder | undefined;
  const bd = b.actor?.researchDepth as keyof typeof researchSortOrder | undefined;
  const research = (ad ? researchSortOrder[ad] : 3) - (bd ? researchSortOrder[bd] : 3);
  if (research) return research;
  const country = (a.actor?.country ?? '').localeCompare(b.actor?.country ?? '');
  if (country) return country;
  const ak = a.actor?.type === 'ORGANIZATION' ? 0 : 1;
  const bk = b.actor?.type === 'ORGANIZATION' ? 0 : 1;
  return ak - bk || (a.parent?.name ?? a.model.name).localeCompare(b.parent?.name ?? b.model.name) || a.model.name.localeCompare(b.model.name);
});

const countryValues = [...new Set(records.map((record) => record.actor?.country).filter((value): value is string => Boolean(value)))].sort();
const relationOptions = [
  { value: 'PRIORITY', label: 'P1 / P2 / P3 related' },
  { value: 'DIRECTION_LINKED', label: 'Direction-linked' },
  { value: 'SUPPORT_ONLY', label: 'Russia support-only' },
  { value: 'COMPARATOR_ONLY', label: 'China comparator-only' },
  { value: 'BACKGROUND_KILLED_THESIS', label: 'Background / killed thesis' },
  { value: 'NO_CAPABILITY', label: 'Actor only / no capability' }
];
const directionOptions = directions
  .map((direction) => ({ value: direction.id, label: directionTitle(direction.id) }))
  .sort((a, b) => a.label.localeCompare(b.label));
---

<BaseLayout title="Russia-Thermal — Institutions & Labs" description={vm.summary}>
  <SiteHeader slot="header" />

  <div data-explorer-root>
    <section class="collection-hero">
      <div>
        <p class="eyebrow">Institution & lab explorer</p>
        <h1>Institutions & labs</h1>
        <p>
          Academic universities and research institutes lead this list; applied institutes and companies are retained as contextual engineering evidence. Browse also the labs that were researched but not promoted as partners.
          Each horizontal record keeps hierarchy, capability context, people and strategic role visible without reverting to large cards.
        </p>
      </div>
      <div class="count">{records.length} records</div>
    </section>

    <ExplorerToolbar
      sticky
      compact
      total={records.length}
      searchPlaceholder="Search institution, lab, person, capability or direction…"
      filters={[
        {
          key: 'country',
          label: 'Country',
          options: countryValues.map((value) => ({ value, label: value === 'RU' ? 'Russia' : value === 'CN' ? 'China' : value }))
        },
        {
          key: 'kind',
          label: 'Kind',
          options: [
            { value: 'ORGANIZATION', label: 'Organization' },
            { value: 'LAB', label: 'Lab / team' },
            { value: 'COMPANY', label: 'Company' }
          ]
        },
        {
          key: 'research',
          label: 'Organization class',
          options: [
            { value: 'ACADEMIC_UNIVERSITY', label: 'Academic university' },
            { value: 'ACADEMIC_RESEARCH_INSTITUTE', label: 'Academic research institute' },
            { value: 'APPLIED_RESEARCH_ORG', label: 'Applied research institute' },
            { value: 'INDUSTRIAL_ORG', label: 'Industrial organization' },
            { value: 'COMPANY', label: 'Company' }
          ]
        },
        { key: 'relation', label: 'Research role', options: relationOptions },
        { key: 'direction', label: 'Direction', options: directionOptions }
      ]}
    />

    <section class="dense-list" aria-label="Institution and lab records">
      {records.map((record) => (
        <div
          data-explorer-record
          data-country={record.actor?.country ?? ''}
          data-kind={record.actor?.type ?? ''}
          data-research={record.actor?.researchClass ?? ''}
          data-relation={record.relations.join('|')}
          data-direction={record.directionIds.join('|')}
          data-search={record.search}
        >
          <DenseObjectRow
            layout="balanced"
            href={record.model.href ? `${import.meta.env.BASE_URL}${record.model.href.replace(/^\//, '')}` : undefined}
            ariaLabel={record.model.name}
          >
            <div slot="main" class="inst-main">
              <div class="topline">
                <span>{record.actor?.researchClass ? humanize(record.actor.researchClass) : record.actor?.type === 'LAB' ? 'LAB / TEAM' : 'ORGANIZATION'}</span>
                <b>{record.actor?.country ?? record.model.country}</b>
                {record.actor?.researchDepth && <em>{humanize(record.actor.researchDepth)} research</em>}
                {record.priorityRanks.map((rank) => <em>{rank}</em>)}
              </div>
              {record.model.href ? (
                <a class="title" href={`${import.meta.env.BASE_URL}${record.model.href.replace(/^\//, '')}`}>{record.model.name}</a>
              ) : <strong class="title">{record.model.name}</strong>}
              <div class="hierarchy-line">
                {record.parent && <span>Parent · {record.parent.name}</span>}
                {record.actor?.city && <span>{record.actor.city}{record.actor.region ? ` · ${record.actor.region}` : ''}</span>}
              </div>
            </div>

            <div slot="details" class="inst-details">
              <p>{record.model.summary}</p>
              {record.peopleNames.length > 0 && (
                <div class="people-line">
                  <span>Key people</span>
                  <p>{record.peopleNames.slice(0,4).join(' · ')}{record.peopleNames.length > 4 ? ' …' : ''}</p>
                </div>
              )}
            </div>

            <div slot="meta" class="inst-meta">
              <div class="metrics">
                <span><b>{record.scopedCapabilities.length}</b> capabilities</span>
                <span><b>{record.peopleNames.length}</b> people</span>
              </div>
              <div class="tags">
                {record.dispositions.slice(0,3).map((value) => <em>{humanize(value)}</em>)}
                {!record.dispositions.length && <em>Actor only</em>}
              </div>
              {record.linkedDirections.length > 0 && (
                <div class="direction-line">
                  <span>Directions</span>
                  <p>{record.linkedDirections.slice(0,2).map((direction) => directionTitle(direction.id)).join(' · ')}{record.linkedDirections.length > 2 ? ' …' : ''}</p>
                </div>
              )}
            </div>

            <div slot="actions" class="row-actions">
              {(record.model.id === 'ACT-KUTATELADZE' || record.model.id === 'ACT-KUT-LAB13' || record.model.id === 'ACT-MPEI') && (
                <a href={`${import.meta.env.BASE_URL}representative-works/#${record.model.id === 'ACT-MPEI' ? 'ACT-MPEI' : 'ACT-KUT-LAB13'}`}>Selected works</a>
              )}
              <a href={`${import.meta.env.BASE_URL}claims?actor=${encodeURIComponent(record.model.id)}`}>Claims</a>
              <a href={`${import.meta.env.BASE_URL}papers?actor=${encodeURIComponent(record.model.id)}`}>Papers</a>
              <a href={`${import.meta.env.BASE_URL}evidence?actor=${encodeURIComponent(record.model.id)}`}>Evidence</a>
            </div>
          </DenseObjectRow>
        </div>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .collection-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;max-width:none}
  .collection-hero>div:first-child{max-width:72rem}
  .collection-hero h1{margin:0;font-size:clamp(1.7rem,2.7vw,2.35rem);letter-spacing:-.05em;line-height:1.08}
  .collection-hero>div>p:not(.eyebrow){margin:.55rem 0 0;color:var(--text-muted);max-width:82ch;line-height:1.6}
  .count{flex:0 0 auto;width:fit-content;padding:.45rem .8rem;border-radius:999px;background:var(--accent-soft);color:var(--accent);font-weight:800}

  .dense-list{margin-top:12px;border:1px solid var(--line);border-radius:var(--radius-md);overflow:hidden;background:var(--surface);box-shadow:var(--shadow-1)}
  .inst-main,.inst-details,.inst-meta{display:grid;gap:6px;min-width:0}
  .topline{display:flex;gap:5px;align-items:center;flex-wrap:wrap}.topline span,.topline b,.topline em{padding:3px 6px;border-radius:999px;font-size:.54rem;font-style:normal;font-weight:900;letter-spacing:.04em;text-transform:uppercase}.topline span{background:#eef6fb;color:#315f80}.topline b{background:#eef4f8;color:#587185}.topline em{background:#e7f6ef;color:#087a66}
  .title{width:fit-content;color:#1d405a;font-size:.98rem;font-weight:850;line-height:1.35;text-decoration:none}.title:hover,.title:focus-visible{text-decoration:underline;text-underline-offset:.16em}
  .hierarchy-line{display:flex;gap:8px;flex-wrap:wrap;color:#51697b;font-size:.75rem}

  .inst-details>p{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:3;margin:0;color:#22394b;font-size:.88rem;font-weight:600;line-height:1.55}
  .people-line{display:grid;gap:3px}.people-line span,.direction-line span{color:#0b67b2;font-size:.55rem;font-weight:900;letter-spacing:.05em;text-transform:uppercase}.people-line p,.direction-line p{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;margin:0;color:#40596b;font-size:.78rem;font-weight:600;line-height:1.5}

  .metrics{display:flex;gap:10px;flex-wrap:wrap}.metrics span{color:#6a8192;font-size:.64rem}.metrics b{color:#0b67b2;font-size:.85rem}
  .tags{display:flex;gap:4px;flex-wrap:wrap}.tags em{padding:3px 5px;border-radius:5px;background:#f1f5f8;color:#587185;font-size:.62rem;font-style:normal;font-weight:750}.direction-line{display:grid;gap:3px}

  .row-actions{display:flex;gap:5px;flex-wrap:wrap}.row-actions a{padding:5px 7px;border:1px solid #d8e7f1;border-radius:6px;color:#43677f;font-size:.7rem;font-weight:800;text-decoration:none;white-space:nowrap}.row-actions a:hover{background:#eef6fb;color:#0b67b2}

  [hidden]{display:none!important}
  @media(max-width:850px){.collection-hero{align-items:flex-start;flex-direction:column}}
</style>
