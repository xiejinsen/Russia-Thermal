---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import selectedJson from '../../data/generated/representativeWorks.json';
import { actors, evidence } from '../data/load-normalized';

type Selection = {
  id: string; teamId: string; sourceId: string | null; sourceUrl: string;
  title: string; authors: string; venue: string; year: number | null;
  researchLane: string; selectionReason: string; evidenceState: string;
  deepReadPriority: string; selectionLimit: string;
};
const records = selectedJson.records as Selection[];
const canonical = new Map(evidence.map((source) => [source.id, source]));
const base = import.meta.env.BASE_URL;
const url = (path: string) => base + path.replace(/^\//, '');
/** Editorial interpretation of bounded reviewed works, not a list of all institute output. */
const summaries: Record<string, { short: string; theme: string; boundary: string; status: string }> = {
  'ACT-KUT-LAB13': {
    short: 'Kutateladze · Laboratory 1.3',
    theme: '介电液体沸腾干斑与临界失效的实验观察',
    boundary: 'HFE-7100 / Novec 649 开放实验，不是手机密封铜水均热板；标签数据使用权仍未知。',
    status: '优先可行性 / P1'
  },
  'ACT-MPEI': {
    short: 'MPEI · Ivanov 研究线',
    theme: '两相热虹吸管表面与 42 个月周期运行',
    boundary: '只有运行后状态不足以证明早期预警；缺少时序数据与手机应用验证。',
    status: '条件储备 / P2'
  },
  'ACT-ITP-UBRAS': {
    short: 'ITP Ural · LHP 实验室',
    theme: '环路热管运行边界、铜毛细芯和氨工质实验',
    boundary: '装置尺寸、回流结构和工质不能直接外推到超薄手机 VC。',
    status: '科研方法观察'
  },
  'ACT-TPU': {
    short: 'TPU · 表面热物理',
    theme: '表面粗糙度、润湿性与开放液滴蒸发',
    boundary: '2026 IJHMT 液滴实验与 Surfaces and Interfaces 激光疏水化是不同论文；逐人归属尚不完整。',
    status: '暂缓 / HOLD'
  },
  'ACT-TSU': {
    short: 'TSU · 热流体计算实验室',
    theme: 'PCM 热缓冲、泡沫/肋片和周期热负载数值研究',
    boundary: '现有论文主要是模型，没有手机级样机与重新凝固周期验证。',
    status: '科研方法观察'
  },
  'ACT-ICM-KRASN': {
    short: 'ICM Krasnoyarsk · 两条独立研究线',
    theme: '一组做热管/电子模块实测；另一组研究液气界面理论',
    boundary: '不得合并两组人员；期刊 Dmitry Nesterov 与官方 Denis Nesterov 不能擅自合一。',
    status: '方法储备'
  }
};
const actorById = new Map(actors.map(actor => [actor.id, actor]));
const preferredOrder = ['ACT-KUT-LAB13','ACT-MPEI','ACT-ITP-UBRAS','ACT-TPU','ACT-TSU','ACT-ICM-KRASN'];
const panels = [...new Set(records.map(record => record.teamId))]
  .sort((a,b) => (preferredOrder.indexOf(a) < 0 ? 99 : preferredOrder.indexOf(a)) -
                  (preferredOrder.indexOf(b) < 0 ? 99 : preferredOrder.indexOf(b)) || a.localeCompare(b))
  .map((id,index) => ({
    id,
    ordinal: String(index+1).padStart(2,'0'),
    title: summaries[id]?.short ?? actorById.get(id)?.name ?? id,
    description: summaries[id]?.theme ?? actorById.get(id)?.researchRelevance ?? '已整理的科研研究线索',
    detail: summaries[id]?.boundary ?? '原始科研结论与手机迁移边界须逐篇核对。',
    status: summaries[id]?.status ?? '研究资料',
    institutionHref: `/institutions/${id}`
  }));
const priority = (r: Selection) => r.deepReadPriority === 'DECISIVE' ? 0 : r.deepReadPriority === 'SUPPORTING' ? 1 : 2;
const stage = (r: Selection) => r.evidenceState === 'CANONICAL' ? 'Source 已归档' : r.evidenceState === 'ORIGINAL_REVIEWED' ? '已核对出处 · 代表作补充' : r.evidenceState === 'SECONDARY_ONLY' ? '原文方法待核查' : '书目或人员归属待核验';
const stateCount = (value:string) => records.filter(r=>r.evidenceState===value).length;
const formalPaperCount=evidence.filter(s=>s.sourceType==='PAPER').length;
---
<BaseLayout title="Representative Works — Russia-Thermal" description="Representative research papers and scientific contributions of Russia thermal research groups, with evidence provenance and smartphone-transfer limits.">
  <SiteHeader slot="header" />
  <div class="works-page">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={url('research-coverage/')}>Explore / Research Coverage</a><span aria-hidden="true">›</span><span>Representative Works</span></nav>
    <header class="intro">
      <p class="eyebrow">Academic research · evidence review</p>
      <h1>Representative research works</h1>
      <p>俄罗斯主要机构有哪些值得阅读的代表论文？实验、模型和手机适用性的边界分别是什么？</p>
      <p class="note">本页是一份按研究团队整理的代表作清单，不是研究结论所使用的全部论文库。论文的书目核验、正式 Source 归档，以及用于支持哪条 Claim，是三个不同步骤。</p>
    </header>
    <section class="evidence-guide" aria-labelledby="evidence-guide-heading">
      <div class="guide-intro">
        <p class="eyebrow">SOURCE GRAPH / DECISION TRACE</p>
        <h2 id="evidence-guide-heading">结论依据来自正式证据链，代表作清单另行维护</h2>
        <p>正式证据库目前有 <strong>{formalPaperCount} 个论文 Source 对象</strong>，结题材料通过 Source → Claim → Capability / Direction / Decision 追溯论据。下方 <strong>{records.length} 篇</strong>是机构代表作选目，其中 <strong>{stateCount('CANONICAL')} 篇</strong>已直接建立 Source 关联。其他条目根据核验程度保留为补充研究资料，<strong>不能仅凭选目标签作为独立的结论证明</strong>。</p>
      </div>
      <div class="evidence-levels">
        <div><strong>{stateCount('CANONICAL')}</strong><span>正式 Source 关联</span></div>
        <div><strong>{stateCount('ORIGINAL_REVIEWED')}</strong><span>原始出处或身份已核对</span></div>
        <div><strong>{stateCount('SECONDARY_ONLY') + stateCount('PENDING_IDENTITY')}</strong><span>存在原文或身份核验缺口</span></div>
      </div>
      <div class="decision-source-links">
        <a href={url('/papers/PAPER-RU-DRY-001')}>P1：Kutateladze 干斑原始论文 ↗</a>
        <a href={url('/claims/CLM-PAV-002')}>P1：实验结论的 Claim ↗</a>
        <a href={url('/papers/PAPER-RU-AGE-001')}>P2：MPEI 42 个月原始论文 ↗</a>
        <a href={url('/claims/CLM-MPEI-008')}>P2：尚待验证的退化假说 ↗</a>
        <a href={url('/research-questions#Q04')}>Q04：代表论文结题范围与限制 ↗</a>
        <a href="https://github.com/xiejinsen/Russia-Thermal/blob/main/analysis/audits/representative-evidence-link-audit-2026-10-13.md" target="_blank" rel="noopener noreferrer">27 篇逐项证据关联审计 ↗</a>
      </div>
    </section>
    <nav class="team-jump" aria-label="Research team quick navigation">
      {panels.map((panel) => (
        <a class="jump-card" href={`#${panel.id}`}>
          <span class="org-index">INSTITUTION / TEAM {panel.ordinal}</span>
          <span class="jump-label">{panel.status}</span>
          <strong>{panel.title}</strong>
          <span class="jump-count"><b>{records.filter((r) => r.teamId === panel.id).length}</b> representative papers</span>
          <span class="jump-desc">{panel.description}</span>
          <span class="jump-action">View research papers ↓</span>
        </a>
      ))}
    </nav>
    {panels.map((panel) => (
      <section id={panel.id} class="team" aria-label={panel.title}>
        <div class="team-head">
          <span class="section-number" aria-label={`Team ${panel.ordinal}`}>{panel.ordinal}</span>
          <div>
            <p class="eyebrow">{panel.status}</p>
            <h2>{panel.title}</h2>
            <p>{panel.description}</p>
            <p><a href={url(panel.institutionHref)}>核对机构、实验室及学者归属 →</a></p>
          </div>
          <p class="team-takeaway">{panel.detail}</p>
        </div>
        <div class="papers">
          {records.filter((r) => r.teamId === panel.id).sort((a,b) => priority(a) - priority(b) || (b.year ?? 0)-(a.year ?? 0)).map((r, paperIndex) => {
            const source = r.sourceId ? canonical.get(r.sourceId) : undefined;
            return (
              <article class:list={['paper', { featured: r.deepReadPriority === 'DECISIVE' }]}>
                <span class="paper-index" aria-label={`Paper ${panel.ordinal}.${String(paperIndex+1).padStart(2, '0')}`}>{panel.ordinal}.{String(paperIndex+1).padStart(2, '0')}</span>
                <div class="paper-body">
                <div class="paper-top">
                  <span class="focus">{r.deepReadPriority === 'DECISIVE' ? 'Key paper' : r.deepReadPriority === 'SUPPORTING' ? 'Supporting study' : 'Context'}</span>
                  <span class:list={['status',r.evidenceState.toLowerCase()]}>{stage(r)}</span>
                </div>
                <h3><a href={r.sourceUrl} target="_blank" rel="noopener noreferrer">{source?.title ?? r.title}</a></h3>
                <p class="citation">{r.authors} · <em>{r.venue}</em> · {r.year ?? 'Publication year not verified'}</p>
                <p><strong>研究价值：</strong> {r.selectionReason}</p>
                {panel.id === 'ACT-ICM-KRASN' && <p class="research-track"><strong>科研组别：</strong>{r.researchLane.startsWith('TRACK_A') ? '电子散热与热管实验研究线' : '液气界面与热毛细理论研究线'}（两组独立）</p>}
                {r.sourceId
                  ? <p class="evidence-path"><a href={url(`/papers/${r.sourceId}`)}>正式证据记录：{r.sourceId} ↗</a></p>
                  : <p class="evidence-path pending">此条为补充代表作选目，暂无独立 Source–Claim 证据关联；不能据此直接支持产品或合作结论。</p>}
                <p><strong>不支持的外推：</strong> {r.selectionLimit}</p>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))}
    <p class="footnote">Scientific credibility and smartphone product readiness are different questions. The P1/P2 collaboration rankings are unchanged. <a href={url('research-coverage/')}>Back to research coverage</a>.</p>
  </div>
</BaseLayout>

<style>
  .evidence-guide{margin:4px 0 34px;padding:25px 30px;background:linear-gradient(110deg,#e8f4fa,#f7fbfd);border:1px solid #b9d5e5;border-radius:13px}
  .evidence-guide h2{font-size:23px;color:#173951;line-height:1.4;margin:6px 0 12px}
  .guide-intro>p:last-child{font-size:15px;line-height:1.8;color:#31546d;max-width:980px;margin:0}
  .evidence-levels{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:21px 0}
  .evidence-levels div{display:flex;align-items:center;gap:12px;border:1px solid #c1d9e8;background:white;border-radius:9px;padding:13px}
  .evidence-levels strong{font-size:28px;color:#0c658e;line-height:1}
  .evidence-levels span{font-size:12px;color:#385f78;line-height:1.4}
  .decision-source-links{display:flex;gap:10px 21px;flex-wrap:wrap;padding-top:16px;border-top:1px solid #c8dce8}
  .decision-source-links a{font-size:12px;line-height:1.7;color:#0c5e85;font-weight:750}
  .status{font-size:12px;color:#315876;font-weight:750}
  .status.canonical{color:#116955}
  .status.original_reviewed{color:#1e5b83}
  .status.secondary_only,.status.pending_identity{color:#856027}
  .evidence-path{font-size:13px!important;line-height:1.6;color:#2b607b}
  .evidence-path.pending{color:#546a7a}
  @media(max-width:700px){.evidence-guide{padding:19px}.evidence-levels{grid-template-columns:1fr}}
  .works-page {width:min(1080px,calc(100% - 40px));margin:auto;padding:28px 0 76px;color:#172b44;}
  .crumbs {display:flex;gap:12px;align-items:center;font-size:14px;margin-bottom:28px;color:#476788}
  a {color:#165ca8;text-decoration:underline;text-underline-offset:3px}
  .intro {max-width:900px;margin-bottom:36px}
  .eyebrow {font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#336eaa}
  h1 {font-size:clamp(30px,3.1vw,42px);line-height:1.2;margin:9px 0 14px;color:#173a5d}
  .intro>p:not(.eyebrow) {font-size:18px;line-height:1.6}
  .intro .note {font-size:15px!important;color:#3d5268}
  /* Organizations: navigational, solid blue header with large ordinal. */
  .team-jump {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:24px 0 40px}
  .jump-card {display:flex;flex-direction:column;gap:10px;border:1px solid #2d6b9f;border-radius:8px;padding:22px 24px;background:#205987;color:white;text-decoration:none;min-height:224px}
  .jump-card:hover,.jump-card:focus-visible {background:#16496f;color:white;outline:3px solid #b4d7f1;outline-offset:2px}
  .org-index {font-size:14px;letter-spacing:.12em;font-weight:800;color:#cce5f8}
  .jump-label {font-size:13px;font-weight:750;color:#e0eef9;text-transform:uppercase;letter-spacing:.035em}
  .jump-card strong {font-size:22px;line-height:1.3;color:white}
  .jump-count {font-size:15px;color:#e8f3fc}
  .jump-count b {font-size:25px;margin-right:5px;color:white}
  .jump-desc {font-size:15px;line-height:1.5;color:#eef6fc}
  .jump-action {margin-top:auto;padding-top:10px;font-weight:750;font-size:15px;color:white}
  .team {margin:44px 0;scroll-margin-top:95px}
  .team-head {display:grid;grid-template-columns:62px minmax(0,1.25fr) minmax(230px,1fr);gap:18px;align-items:start;padding:24px 12px 24px 0;border:0;border-top:3px solid #25669a;border-bottom:1px solid #ccdbe8;border-radius:0;background:transparent}
  .section-number {font-size:35px;font-weight:800;line-height:1.1;color:#1a5b91;letter-spacing:-.04em}
  .team-head h2 {font-size:25px;line-height:1.25;color:#173a5d;margin:8px 0 10px}
  .team-head p {line-height:1.55;font-size:16px;margin:8px 0}
  .team-takeaway {border-left:3px solid #8db6d8;padding-left:18px;font-weight:600}
  /* Papers: numbered bibliography rows, deliberately not colored organization cards. */
  .papers {display:grid;gap:0;margin-top:16px}
  .paper {display:grid;grid-template-columns:65px minmax(0,1fr);gap:15px;border:0;border-bottom:1px solid #d0deeb;border-radius:0;padding:23px 12px 23px 0;background:white}
  .paper.featured {border-bottom:1px solid #91b6d6;background:linear-gradient(90deg,#eaf4fc 0,#fff 72%)}
  .paper-index {font-size:17px;font-weight:800;color:#25669a;font-variant-numeric:tabular-nums;padding-top:3px}
  .paper-body {min-width:0}
  .paper-top {display:flex;flex-wrap:wrap;gap:9px;align-items:center;font-size:13px;font-weight:650;color:#365d86}
  .focus {border-left:3px solid #2b6c9f;padding:2px 7px;color:#1d578f;font-weight:800}
  .status {color:#4a6279}
  .paper h3 {font-size:20px;line-height:1.4;margin:10px 0 7px}
  .paper p {font-size:16px;line-height:1.55;margin:9px 0}
  .paper .citation {font-size:15px;color:#425c75;margin-bottom:15px}
  .footnote {margin-top:34px;font-size:15px;color:#36546f}
  @media(max-width:1030px){.team-jump{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:700px) {.team-jump{grid-template-columns:1fr}.works-page{width:calc(100% - 28px)}.team-head{grid-template-columns:45px minmax(0,1fr);padding:18px 0}.team-takeaway{grid-column:2}.section-number{font-size:28px}.paper{grid-template-columns:48px minmax(0,1fr);gap:10px;padding:17px 0}.paper-index{font-size:14px}.paper h3{font-size:18px}}
</style>
