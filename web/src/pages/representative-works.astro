---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import selectedJson from '../../data/generated/representativeWorks.json';
import { evidence } from '../data/load-normalized';

type Selection = {
  id: string; teamId: string; sourceId: string | null; sourceUrl: string;
  title: string; authors: string; venue: string; year: number | null;
  researchLane: string; selectionReason: string; evidenceState: string;
  deepReadPriority: string; selectionLimit: string;
};
const records = selectedJson.records as Selection[];
const canonical = new Map(evidence.map((source) => [source.id, source]));
const base = import.meta.env.BASE_URL;
const url = (path: string) => base + path.replace(/^\//, '');
const panels = [
  { id: 'ACT-KUT-LAB13', title: 'Kutateladze Institute · Laboratory 1.3',
    description: 'P1 — studying how local dry spots develop into boiling failure.',
    leader: 'Alexander Pavlenko; key researcher Anton Surtaev',
    detail: 'Potential contribution: detailed experimental labels for failure mechanisms. Not yet proven in a sealed, ultra-thin smartphone vapor chamber.' },
  { id: 'ACT-MPEI', title: 'Moscow Power Engineering Institute · Ivanov research line',
    description: 'P2 reserve — surface coatings and long-term thermosyphon behavior.',
    leader: 'Nikita Ivanov; academic coauthor Yuri Kuzma-Kichta',
    detail: 'Potential contribution: observing hidden capillary degradation after long-term operation. No validated early-warning model or phone-scale result.' },
];
const priority = (r: Selection) => r.deepReadPriority === 'DECISIVE' ? 0 : r.deepReadPriority === 'SUPPORTING' ? 1 : 2;
const stage = (r: Selection) => r.evidenceState === 'CANONICAL' ? 'In evidence graph' : r.evidenceState === 'ORIGINAL_REVIEWED' ? 'Original reviewed · not yet linked' : r.evidenceState === 'SECONDARY_ONLY' ? 'Bibliographic lead · needs verification' : 'Research lead · identity pending';
---
<BaseLayout title="Representative Works — Russia-Thermal" description="Representative research papers and scientific contributions of Russia thermal research groups, with evidence provenance and smartphone-transfer limits.">
  <SiteHeader slot="header" />
  <div class="works-page">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={url('research-coverage/')}>Explore / Research Coverage</a><span aria-hidden="true">›</span><span>Representative Works</span></nav>
    <header class="intro">
      <p class="eyebrow">Academic research · evidence review</p>
      <h1>Representative research works</h1>
      <p>Which papers best demonstrate each team's research capability — and what remains unproven for smartphone thermal management?</p>
      <p class="note">A selected scientific sample, not a complete publication census. Papers awaiting canonical evidence linking are clearly marked, even where their original article has been reviewed.</p>
    </header>
    <nav class="team-jump" aria-label="Research team quick navigation">
      {panels.map((panel) => (
        <a class="jump-card" href={`#${panel.id}`}>
          <span class="jump-label">{panel.id === 'ACT-KUT-LAB13' ? 'P1 · priority candidate' : 'P2 · conditional reserve'}</span>
          <strong>{panel.title}</strong>
          <span class="jump-count">{records.filter((r) => r.teamId === panel.id).length} selected papers</span>
          <span class="jump-desc">{panel.description}</span>
          <span class="jump-action">View research papers ↓</span>
        </a>
      ))}
    </nav>
    {panels.map((panel) => (
      <section id={panel.id} class="team" aria-label={panel.title}>
        <div class="team-head">
          <div>
            <p class="eyebrow">{panel.id === 'ACT-KUT-LAB13' ? 'Priority research candidate' : 'Conditional research reserve'}</p>
            <h2>{panel.title}</h2>
            <p>{panel.description}</p>
            <p><strong>Key researchers:</strong> {panel.leader}</p>
          </div>
          <p class="team-takeaway">{panel.detail}</p>
        </div>
        <div class="papers">
          {records.filter((r) => r.teamId === panel.id).sort((a,b) => priority(a) - priority(b) || (b.year ?? 0)-(a.year ?? 0)).map((r) => {
            const source = r.sourceId ? canonical.get(r.sourceId) : undefined;
            return (
              <article class:list={['paper', { featured: r.deepReadPriority === 'DECISIVE' }]}>
                <div class="paper-top">
                  <span class="focus">{r.deepReadPriority === 'DECISIVE' ? 'Key paper' : r.deepReadPriority === 'SUPPORTING' ? 'Supporting study' : 'Context'}</span>
                  <span class="status">{stage(r)}</span>
                </div>
                <h3><a href={r.sourceUrl} target="_blank" rel="noopener noreferrer">{source?.title ?? r.title}</a></h3>
                <p class="citation">{r.authors} · <em>{r.venue}</em> · {r.year ?? 'Publication year not verified'}</p>
                <p><strong>Why this matters:</strong> {r.selectionReason}</p>
                <p><strong>What it does not prove:</strong> {r.selectionLimit}</p>
              </article>
            );
          })}
        </div>
      </section>
    ))}
    <p class="footnote">Scientific credibility and smartphone product readiness are different questions. The P1/P2 collaboration rankings are unchanged. <a href={url('research-coverage/')}>Back to research coverage</a>.</p>
  </div>
</BaseLayout>

<style>
  .works-page {width:min(1080px,calc(100% - 40px));margin:auto;padding:28px 0 76px;color:#172b44;}
  .crumbs {display:flex;gap:12px;align-items:center;font-size:14px;margin-bottom:28px;color:#476788}
  a {color:#165ca8;text-decoration:underline;text-underline-offset:3px}
  .intro {max-width:900px;margin-bottom:36px}
  .eyebrow {font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:#336eaa}
  h1 {font-size:clamp(30px,3.1vw,42px);line-height:1.2;margin:9px 0 14px;color:#173a5d}
  .intro>p:not(.eyebrow) {font-size:18px;line-height:1.6}
  .intro .note {font-size:15px!important;color:#3d5268}
  .team-jump {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:24px 0 40px}
  .jump-card {display:flex;flex-direction:column;gap:9px;border:1px solid #b8d1e7;border-radius:12px;padding:21px 23px;background:#f2f8fd;color:#183c60;text-decoration:none}
  .jump-card:hover,.jump-card:focus-visible {border-color:#397db4;background:#e8f3fd;outline:2px solid transparent;box-shadow:0 0 0 2px #8cbee9}
  .jump-label {font-size:13px;font-weight:750;color:#336eaa;text-transform:uppercase;letter-spacing:.035em}
  .jump-card strong {font-size:21px;line-height:1.3}
  .jump-count {font-size:20px;font-weight:800;color:#1d578f}
  .jump-desc {font-size:15px;line-height:1.5;color:#345470}
  .jump-action {margin-top:auto;padding-top:10px;font-weight:750;font-size:15px;color:#165ca8}
  .team {margin:40px 0;scroll-margin-top:95px}
  .team-head {display:grid;grid-template-columns:minmax(0,1.25fr) minmax(250px,1fr);gap:24px;align-items:center;padding:24px;border:1px solid #c6dbec;border-radius:14px;background:#eaf4fc}
  .team-head h2 {font-size:25px;line-height:1.25;color:#173a5d;margin:8px 0 10px}
  .team-head p {line-height:1.55;font-size:16px;margin:8px 0}
  .team-takeaway {border-left:4px solid #3880be;padding-left:18px;font-weight:600}
  .papers {display:grid;gap:14px;margin-top:16px}
  .paper {border:1px solid #d1deea;border-radius:12px;padding:21px 24px;background:#fff}
  .paper.featured {border-color:#85b2dd;background:#f3f8fe}
  .paper-top {display:flex;flex-wrap:wrap;gap:9px;align-items:center;font-size:13px;font-weight:650;color:#365d86}
  .focus {background:#e2effb;border-radius:5px;padding:4px 8px;color:#1d578f}
  .status {color:#4a6279}
  .paper h3 {font-size:20px;line-height:1.4;margin:10px 0 7px}
  .paper p {font-size:16px;line-height:1.55;margin:9px 0}
  .paper .citation {font-size:15px;color:#425c75;margin-bottom:15px}
  .footnote {margin-top:34px;font-size:15px;color:#36546f}
  @media(max-width:700px) {.team-jump{grid-template-columns:1fr}.works-page {width:calc(100% - 28px)}.team-head {grid-template-columns:1fr;padding:18px}.paper {padding:18px}.paper h3 {font-size:18px}}
</style>
