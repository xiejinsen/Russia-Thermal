---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ResearchSchematicAtlas from '../../components/ResearchSchematicAtlas.astro';
import { buildResearchMapVM } from '../../view-models/builders';
const vm=buildResearchMapVM('RU');
---
<BaseLayout title="Russia Illustrated Research Atlas | Russia-Thermal" description="Evidence-linked editorial infographic with research organizations, cities, scholars and research directions." immersive>
  <SiteHeader slot="header" />
  <ResearchSchematicAtlas vm={vm} country="RU" />
</BaseLayout>
