---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base=import.meta.env.BASE_URL;
const href=(path:string)=>`${base}${path.replace(/^\//,'')}`;
---
<BaseLayout title="Russia-Thermal — Research Maps">
  <main class="hub">
    <p>RESEARCH GEOGRAPHY</p>
    <h1>Explore the research graph by place.</h1>
    <div class="cards">
      <a href={href('/research-map/russia')}><b>Russia Research Map</b><span>Institutions · scholars · capabilities · directions</span></a>
      <a href={href('/research-map/china')}><b>China Research Map</b><span>Comparator institutions · scholars · technical clusters</span></a>
    </div>
  </main>
  <style>
    :global(body){background:#f3f9fd;color:#17324d}
    :global(body>main){width:auto;margin:0;padding:0}
    .hub{max-width:1100px;margin:auto;padding:80px 24px}.hub>p{font-size:11px;font-weight:850;letter-spacing:.1em;color:#0b67b2}.hub h1{max-width:800px;font-size:48px;line-height:1.02;letter-spacing:-.04em}.cards{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:40px}.cards a{display:grid;gap:10px;min-height:220px;padding:26px;border:1px solid #cee0ed;border-radius:16px;background:#fff;text-decoration:none}.cards b{font-size:24px}.cards span{color:#60798d}@media(max-width:720px){.cards{grid-template-columns:1fr}}
  </style>
</BaseLayout>
