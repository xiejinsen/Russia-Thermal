---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { buildResearchMapVM } from '../../view-models/builders';
const base=import.meta.env.BASE_URL;
const href=(path:string)=>path==='/'?base:base+path.replace(/^\//,'');
const ru=buildResearchMapVM('RU');
const cn=buildResearchMapVM('CN');
---
<BaseLayout title="科研研究版图 · Illustrated Research Atlases | Russia-Thermal" description="Russia and China thermal research organizations, people, capabilities and evidence shown in schematic infographics rather than interactive GIS maps." immersive>
 <SiteHeader slot="header" />
 <div class="atlas-hub">
  <header class="intro"><p>RESEARCH NETWORK / ILLUSTRATED SCIENCE ATLAS</p><h1>热管理科研版图</h1><p class="subtitle">以地图示意图连接机构、学者、研究方向和可追溯的原始证据。这里不是地理信息系统，也不把机构数量当作科研实力排名。</p></header>
  <div class="atlas-choices">
   <a href={href('/research-map/russia/')} class="atlas-choice">
    <div class="photo"><img src={href('/assets/russia-editorial-outline.svg')} alt="俄罗斯热管理科研地理轮廓示意图"/></div>
    <div class="content"><span>01 · RUSSIA / MAIN RESEARCH</span><h2>俄罗斯科研网络</h2><p>查看俄罗斯研究机构、关键人员和科学能力；理解能否补充手机热管理研究。</p><strong>{ru.mappedActorCount} 个有位置记录的根机构 · {ru.unmappedActorCount} 个位置缺口</strong><em>进入俄罗斯科研图解 ↗</em></div>
   </a>
   <a href={href('/research-map/china/')} class="atlas-choice">
    <div class="photo"><img src={href('/assets/china-editorial-outline.svg')} alt="中国研究对照地理轮廓示意图"/></div>
    <div class="content"><span>02 · CHINA / COMPARATOR RESEARCH</span><h2>中国研究对照网络</h2><p>以国内公开研究资料为对照，不将科研方法与手机器件级成熟度混为一谈。</p><strong>{cn.mappedActorCount} 个有位置记录的根机构 · {cn.unmappedActorCount} 个位置缺口</strong><em>进入中国科研图解 ↗</em></div>
   </a>
  </div>
  <footer><a href={href('/landscape')}>中俄与全球技术对照 ↗</a><a href={href('/representative-works')}>代表性原始论文 ↗</a><a href={href('/russia-atlas')}>俄罗斯能力档案 ↗</a></footer>
 </div>
</BaseLayout>
<style>
.atlas-hub{padding:28px 0 70px;color:#eefaff}.intro{padding:42px 0}.intro>p:first-child{color:#88def8;font-size:12px;font-weight:800;letter-spacing:.12em}.intro h1{color:white;font-size:clamp(36px,5vw,62px);margin:16px 0}.subtitle{max-width:780px;font-size:18px;line-height:1.85;color:#d2e7f5}.atlas-choices{display:grid;grid-template-columns:1fr 1fr;gap:23px}.atlas-choice{text-decoration:none;color:#eefaff;background:linear-gradient(135deg,#103e65,#051d34);border-radius:18px;overflow:hidden;border:1px solid #39759a;transition:transform .2s}.atlas-choice:hover{transform:translateY(-5px)}.atlas-choice:focus-visible{outline:3px solid #b0f1ff;outline-offset:4px}.photo{height:235px;overflow:hidden;background:radial-gradient(ellipse at 45% 35%,#226b97,#041b33)}.photo img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 0 20px #24b6ff88)}.content{padding:27px}.content>span{font-size:11px;color:#76e2f7;letter-spacing:.1em;font-weight:800}.content h2{color:white;font-size:28px;margin:12px 0}.content p{font-size:15px;color:#cfe5f1;min-height:60px;line-height:1.75}.content strong{display:block;font-size:13px;color:#b5e6fb;font-weight:750}.content em{font-style:normal;display:block;margin-top:22px;color:#8de9ff;font-size:14px;font-weight:850}.atlas-hub footer{display:flex;flex-wrap:wrap;gap:14px 27px;border-top:1px solid #34627c;padding:27px 0;margin-top:37px}.atlas-hub footer a{color:#b3e8fb;font-weight:750;font-size:14px}@media(max-width:760px){.atlas-choices{grid-template-columns:1fr}.intro{padding:22px 0}.photo{height:200px}.content{padding:20px}}@media(prefers-reduced-motion:reduce){.atlas-choice{transition:none}}
</style>