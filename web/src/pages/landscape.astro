---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import CapabilityMatrix from '../components/CapabilityMatrix.astro';
import { buildLandscapeVM } from '../view-models/builders';

const vm = buildLandscapeVM();
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---
<BaseLayout title="Russia-Thermal — China / Russia / Global Evidence" description={vm.summary}>
  <SiteHeader slot="header" />
  <section class="hero">
    <p class="eyebrow">{vm.eyebrow}</p>
    <h1>{vm.title}</h1>
    <p>{vm.summary}</p>
    <p class="source-boundary" lang="zh-CN"><strong>阅读边界：</strong>比较的单位是“技术问题与原始装置”，不是俄罗斯和中国高校的总量排名。中国器件实测、国际基础模型和内部可用技术不能混为同一个“中国结果”；实验的 CHF、寿命和热阻不能跨不同工质、厚度和装置直接排序。来源仅证明其自身研究条件下的结论。</p>
  </section>

  <CapabilityMatrix rows={vm.rows} />

  <section class="next-steps" aria-label="Scientific transfer and cooperation gate">
    <div>
      <h2>对照后还必须回答两个问题</h2>
      <p>什么研究机理或数据能改变手机级设计判断？哪些与俄方机构有关的研究任务可以提出、但还未获得外联和 PoC 授权？</p>
    </div>
    <nav>
      <a href={href('/smartphone-transfer')}>手机技术迁移条件与停止门槛 →</a>
      <a href={href('/research-packages')}>俄方合作研究任务与授权边界 →</a>
      <a href={href('/research-questions#Q05')}>最终 Q05/Q08 原始研究结论 →</a>
    </nav>
  </section>
</BaseLayout>
<style>
.source-boundary{font-size:.87rem;line-height:1.7;margin-top:18px;padding:14px 20px;border-left:3px solid #6596b7;background:#eef5f9;color:#304f66}
.next-steps{margin:48px 0 72px;border-top:2px solid #34769e;padding:24px 0;display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,.55fr);gap:35px}
.next-steps h2{font-size:1.3rem;margin:0 0 12px}.next-steps p{line-height:1.7;margin:0;color:#466079}
.next-steps nav{display:grid;gap:12px;align-content:start}.next-steps a{font-size:.9rem;font-weight:700;color:#17608e}
@media(max-width:740px){.next-steps{grid-template-columns:1fr;gap:18px}}
</style>
