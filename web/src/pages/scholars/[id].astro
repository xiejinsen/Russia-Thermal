---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import InstitutionCard from '../../components/cards/InstitutionCard.astro';
import DirectionCard from '../../components/cards/DirectionCard.astro';
import CapabilityDetail from '../../components/CapabilityDetail.astro';
import { buildScholarPageVM, scholarIds } from '../../view-models/builders';

export function getStaticPaths() {
  return scholarIds().map((id) => ({ params: { id } }));
}

const vm = buildScholarPageVM(Astro.params.id!);
if (!vm) throw new Error(`Unknown scholar actor: ${Astro.params.id}`);
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<BaseLayout title={`Russia-Thermal — ${vm.name}`} description={vm.relevance ?? vm.name}>
  <SiteHeader slot="header" />

  <section class="detail-hero">
    <p class="eyebrow">Scholar</p>
    <h1>{vm.name}</h1>
    <p class="meta">{vm.country}{vm.role ? ` · ${vm.role}` : ''}</p>
    {vm.relevance && <p class="summary">{vm.relevance}</p>}
    {vm.officialUrl && <a class="official" href={vm.officialUrl} target="_blank" rel="noopener noreferrer">Official source ↗</a>}
    <nav class="relation-strip" aria-label="Explore related research objects">
      <a href={href(`/claims?person=${encodeURIComponent(vm.id)}`)}>Related Claims</a>
      <a href={href(`/papers?person=${encodeURIComponent(vm.id)}`)}>Related Papers</a>
      <a href={href(`/evidence?person=${encodeURIComponent(vm.id)}`)}>All Evidence</a>
    </nav>
  </section>

  {vm.affiliation && (
    <section class="page-section">
      <SectionHeader eyebrow="Affiliation" title="Organization / lab" />
      <div class="single-card"><InstitutionCard model={vm.affiliation} /></div>
    </section>
  )}

  {vm.capabilityContexts.map((context) => (
    <section class="page-section">
      <SectionHeader
        eyebrow="Capability context"
        title={context.institution.name}
        description="Resolved from Capability.actorId and Capability.keyPeopleIds."
      />
      <div class="single-card"><InstitutionCard model={context.institution} /></div>
      <CapabilityDetail model={context.capability} />
      {context.directions.length > 0 && (
        <div class="content-grid">
          {context.directions.map((model) => <DirectionCard model={model} />)}
        </div>
      )}
    </section>
  ))}
</BaseLayout>

<style>
  .detail-hero {
    max-width: 58rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.7rem, 2.8vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .meta, .summary {
    color: var(--text-muted);
  }

  .summary {
    max-width: 70ch;
  }

  .official {
    display: inline-block;
    margin-top: var(--space-3);
    font-weight: 700;
  }

  .relation-strip {
    display: flex;
    gap: .45rem;
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }

  .relation-strip a {
    padding: .48rem .62rem;
    border: 1px solid var(--line);
    border-radius: .5rem;
    background: var(--surface-muted);
    color: var(--accent);
    font-size: .76rem;
    font-weight: 800;
    text-decoration: none;
  }

  .relation-strip a:hover,
  .relation-strip a:focus-visible {
    background: var(--accent-soft);
  }

  .page-section {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-16);
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
  }

  .single-card {
    max-width: 30rem;
  }
</style>
