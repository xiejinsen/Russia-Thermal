---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ExplorerToolbar from '../../components/ExplorerToolbar.astro';
import DenseResearchTable from '../../components/DenseResearchTable.astro';
import { directions } from '../../data/load-normalized';
import { buildPaperExplorerVM } from '../../view-models/builders';
import { directionTitle } from '../../view-models/helpers';

const vm = buildPaperExplorerVM();
const deepReadCount = vm.records.filter((paper) => Boolean(paper.deepReadLevel)).length;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;

const countries = [...new Set(vm.records.map((paper) => paper.countryContext).filter((value): value is string => Boolean(value)))].sort();
const years = [...new Set(vm.records.map((paper) => paper.year).filter((value): value is number => typeof value === 'number'))].sort((a,b)=>b-a);
const directionOptions = directions
  .filter((direction) => vm.records.some((paper) => paper.directionIds.includes(direction.id)))
  .map((direction) => ({ value: direction.id, label: directionTitle(direction.id) }))
  .sort((a,b)=>a.label.localeCompare(b.label));

const records = vm.records.map((paper) => ({
  ...paper,
  search: [
    paper.id,
    paper.title,
    paper.venue ?? '',
    paper.authors.join(' '),
    paper.countryContext ?? '',
    paper.deepReadLevel ?? '',
    paper.reviewStatus ?? '',
    ...paper.directionIds.map(directionTitle)
  ].join(' '),
  deepClass: paper.deepReadLevel ? 'DEEP_READ' : 'REFERENCE_ONLY'
}));
---

<BaseLayout title="Russia-Thermal — Papers" description={vm.summary}>
  <SiteHeader slot="header" />

  <div data-explorer-root>
    <section class="hero compact-hero">
      <div>
        <p class="eyebrow">Research objects · dense explorer</p>
        <h1>{vm.title}</h1>
        <p>{vm.summary}</p>
      </div>
      <div class="summary-chips">
        <span>{vm.records.length} Paper sources · all also in Evidence</span>
        <span>{deepReadCount} Deep Reads</span>
        <span>{vm.records.length - deepReadCount} reference / supporting only</span>
      </div>
    </section>

    <ExplorerToolbar
      sticky
      compact
      total={records.length}
      urlFilterKeys={['claim', 'capability', 'actor', 'person', 'relation']}
      searchPlaceholder="Search title, author, venue, ID, Direction…"
      filters={[
        {
          key: 'country',
          label: 'Country',
          options: countries.map((value) => ({ value, label: value === 'RU' ? 'Russia' : value === 'CN' ? 'China' : value }))
        },
        {
          key: 'year',
          label: 'Year',
          options: years.map((value) => ({ value: String(value), label: String(value) }))
        },
        {
          key: 'deep',
          label: 'Read depth',
          options: [
            { value: 'DEEP_READ', label: 'Deep Read complete' },
            { value: 'REFERENCE_ONLY', label: 'Reference / supporting only' }
          ]
        },
        { key: 'direction', label: 'Direction', options: directionOptions }
      ]}
    />

    <DenseResearchTable minWidth="76rem" maxHeight="calc(100vh - 13.8rem)" label="Paper research index">
      <tr slot="head">
        <th style="width:38%">Paper</th>
        <th style="width:7%">Year</th>
        <th style="width:7%">Country</th>
        <th style="width:17%">Venue</th>
        <th style="width:14%">Deep Read</th>
        <th style="width:7%">Claims</th>
        <th style="width:10%">Directions</th>
      </tr>

      {records.map((paper) => (
        <tr
          data-explorer-record
          data-country={paper.countryContext ?? ''}
          data-year={paper.year ? String(paper.year) : ''}
          data-deep={paper.deepClass}
          data-direction={paper.directionIds.join('|')}
          data-claim={[...new Set([...paper.supportingClaimIds, ...paper.pressureClaimIds])].join('|')}
          data-supporting-claim={paper.supportingClaimIds.join('|')}
          data-pressure-claim={paper.pressureClaimIds.join('|')}
          data-capability={paper.capabilityIds.join('|')}
          data-actor={paper.institutionIds.join('|')}
          data-person={paper.peopleIds.join('|')}
          data-search={paper.search}
        >
          <td class="paper-cell">
            <a href={href(paper.href)}>
              <strong>{paper.title}</strong>
              <small>{paper.id}{paper.authors.length ? ` · ${paper.authors.slice(0,3).join(', ')}${paper.authors.length > 3 ? ' et al.' : ''}` : ''}</small>
            </a>
          </td>
          <td class="mono">{paper.year ?? '—'}</td>
          <td><span class="country-pill">{paper.countryContext ?? '—'}</span></td>
          <td class="venue" title={paper.venue ?? ''}>{paper.venue ?? '—'}</td>
          <td>
            {paper.deepReadLevel ? (
              <div class="deep-state">
                <b>{paper.deepReadLevel}</b>
                <small title={paper.reviewStatus ?? ''}>{paper.reviewStatus ?? ''}</small>
              </div>
            ) : <span class="muted">Reference only</span>}
          </td>
          <td class="number">{paper.claimCount}</td>
          <td>
            {paper.directionIds.length ? (
              <div class="direction-cell" title={paper.directionIds.map(directionTitle).join(' · ')}>
                <b>{paper.directionCount}</b>
                <span>{paper.directionIds.slice(0,2).map(directionTitle).join(' · ')}</span>
              </div>
            ) : <span class="muted">0</span>}
          </td>
        </tr>
      ))}
    </DenseResearchTable>
  </div>

  <style>
    .compact-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:24px}
    .compact-hero>div:first-child{max-width:72rem}
    .compact-hero h1{margin:0;font-size:clamp(1.65rem,2.5vw,2.25rem);letter-spacing:-.045em}
    .compact-hero p:not(.eyebrow){margin:.55rem 0 0;max-width:82ch;color:var(--text-muted);line-height:1.55}
    .summary-chips{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:6px;min-width:20rem}
    .summary-chips span{padding:5px 8px;border-radius:999px;background:#eef6fb;color:#365f7c;font-size:9px;font-weight:850;white-space:nowrap}

    .paper-cell a{display:grid;gap:3px}
    .paper-cell strong{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;color:#203f57;font-size:11.5px;line-height:1.32}
    .paper-cell small{display:block;overflow:hidden;color:#718696;font-size:9px;text-overflow:ellipsis;white-space:nowrap}
    .mono{font-variant-numeric:tabular-nums}
    .number{font-size:13px;font-weight:850;color:#0b67b2;text-align:center}
    .venue{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .country-pill{display:inline-flex;padding:3px 6px;border-radius:999px;background:#eef4f8;color:#47667d;font-size:9px;font-weight:850}
    .deep-state{display:grid;gap:2px}.deep-state b{width:fit-content;padding:3px 6px;border-radius:999px;background:#e7f6ef;color:#087a66;font-size:8px;text-transform:uppercase}.deep-state small{display:block;overflow:hidden;color:#668092;font-size:8px;text-overflow:ellipsis;white-space:nowrap}
    .direction-cell{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:6px}.direction-cell b{color:#0b67b2;font-size:12px}.direction-cell span{display:block;overflow:hidden;color:#668092;font-size:8px;text-overflow:ellipsis;white-space:nowrap}
    .muted{color:#8798a5;font-size:9px}
    @media(max-width:850px){.compact-hero{align-items:flex-start;flex-direction:column}.summary-chips{justify-content:flex-start;min-width:0}}
  </style>
</BaseLayout>
