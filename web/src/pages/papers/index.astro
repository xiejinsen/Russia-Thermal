---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ExplorerToolbar from '../../components/ExplorerToolbar.astro';
import DenseObjectRow from '../../components/DenseObjectRow.astro';
import { directions, evidence } from '../../data/load-normalized';
import { buildPaperExplorerVM } from '../../view-models/builders';
import { directionTitle } from '../../view-models/helpers';
import {sourceContext, sourceEmphasis, countryName} from '../../view-models/source-emphasis';

const vm = buildPaperExplorerVM();
const deepReadCount = vm.records.filter((paper) => Boolean(paper.deepReadLevel)).length;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
const evidenceById = new Map(evidence.map((item) => [item.id, item]));

const countries = [...new Set(vm.records.map((paper) => paper.countryContext).filter((value): value is string => Boolean(value)))].sort();
const years = [...new Set(vm.records.map((paper) => paper.year).filter((value): value is number => typeof value === 'number'))].sort((a,b)=>b-a);
const directionOptions = directions
  .filter((direction) => vm.records.some((paper) => paper.directionIds.includes(direction.id)))
  .map((direction) => ({ value: direction.id, label: directionTitle(direction.id) }))
  .sort((a,b)=>a.label.localeCompare(b.label));

const records = vm.records.map((paper) => {
  const source = evidenceById.get(paper.id);
  return {
    ...paper,
    source,
    search: [
      paper.id,
      paper.title,
      paper.venue ?? '',
      paper.authors.join(' '),
      paper.countryContext ?? '',
      paper.deepReadLevel ?? '',
      paper.reviewStatus ?? '',
      ...(source?.directFindings ?? []),
      source?.boundary ?? '',
      ...paper.directionIds.map(directionTitle)
    ].join(' '),
    deepClass: paper.deepReadLevel ? 'DEEP_READ' : 'REFERENCE_ONLY'
  };
});
---

<BaseLayout title="原始论文与深读记录 | Russia-Thermal" description={vm.summary}>
  <SiteHeader slot="header" />

  <div data-explorer-root>
    <section class="hero compact-hero">
      <div>
        <p class="eyebrow">PAPERS / ORIGINAL EVIDENCE</p>
        <h1>原始论文与深读记录</h1>
        <p>{vm.summary}</p>
      </div>
      <div class="summary-chips">
        <span>{vm.records.length} 篇正式论文 Source</span>
        <span>{deepReadCount} 篇已建深读记录</span>
        <span>{vm.records.length - deepReadCount} 篇作为引用资料</span>
      </div>
    </section>

    <ExplorerToolbar
      sticky
      compact
      total={records.length}
      urlFilterKeys={['claim', 'capability', 'actor', 'person', 'relation']}
      searchPlaceholder="检索论文、作者、期刊、结论或研究方向…"
      filters={[
        {
          key: 'country',
          label: '国家／地区',
          options: countries.map((value) => ({ value, label: value === 'RU' ? '俄罗斯' : value === 'CN' ? '中国' : value }))
        },
        {
          key: 'year',
          label: '年份',
          options: years.map((value) => ({ value: String(value), label: String(value) }))
        },
        {
          key: 'deep',
          label: '阅读深度',
          options: [
            { value: 'DEEP_READ', label: '有深读记录' },
            { value: 'REFERENCE_ONLY', label: '常规引用资料' }
          ]
        },
        { key: 'direction', label: '研究方向', options: directionOptions }
      ]}
    />

    <section class="dense-list" aria-label="Paper research index">
      {records.map((paper) => (
        <div
          data-explorer-record
          data-importance={sourceEmphasis(paper.id)}
          data-country={paper.countryContext ?? ''}
          data-year={paper.year ? String(paper.year) : ''}
          data-deep={paper.deepClass}
          data-direction={paper.directionIds.join('|')}
          data-claim={[...new Set([...paper.supportingClaimIds, ...paper.pressureClaimIds])].join('|')}
          data-supporting-claim={paper.supportingClaimIds.join('|')}
          data-pressure-claim={paper.pressureClaimIds.join('|')}
          data-capability={paper.capabilityIds.join('|')}
          data-actor={paper.institutionIds.join('|')}
          data-person={paper.peopleIds.join('|')}
          data-search={paper.search}
        >
          <DenseObjectRow layout="detail-heavy" href={href(paper.href)} ariaLabel={paper.title}>
            <div slot="main" class="paper-main">
              <div class="topline">
                <span>{paper.id}</span>
                {sourceContext(paper.id)&&<strong class:list={["source-priority",sourceEmphasis(paper.id)]}>{sourceContext(paper.id)?.label}</strong>}
                {paper.year && <b>{paper.year}</b>}
                {paper.countryContext && <em>{countryName(paper.countryContext)}</em>}
              </div>
              <a class="title" href={href(paper.href)}>{paper.title}</a>
              <p class="authors">{paper.authors.slice(0,4).join(' · ')}{paper.authors.length > 4 ? ' et al.' : ''}</p>
              {paper.venue && <p class="venue">{paper.venue}</p>}
            </div>

            <div slot="details" class="paper-details">
              {paper.source?.directFindings?.length ? (
                <div>
                  <span>论文直接报告的发现</span>
                  <p>{paper.source.directFindings[0]}</p>
                </div>
              ) : (
                <p class="muted">尚无已归档的直接实验发现。</p>
              )}
              {paper.source?.boundary && (
                <div>
                  <span>证据边界</span>
                  <p>{paper.source.boundary}</p>
                </div>
              )}
            </div>

            <div slot="meta" class="paper-meta">
              <div class="relation-metrics">
                <span><b>{paper.claimCount}</b> 关联主张</span>
                <span><b>{paper.directionCount}</b> 研究方向</span>
              </div>
              {paper.deepReadLevel ? (
                <div class="deep-state">
                  <b>{paper.deepReadLevel} 深读记录</b>
                  <span>{paper.reviewStatus ?? '已记录核验依据'}</span>
                </div>
              ) : <span class="reference-state">常规引用资料</span>}
              {paper.directionIds.length > 0 && (
                <div class="direction-line">
                  <span>关联研究方向</span>
                  <p>{paper.directionIds.slice(0,2).map(directionTitle).join(' · ')}{paper.directionIds.length > 2 ? ' …' : ''}</p>
                </div>
              )}
            </div>

            <div slot="actions" class="row-actions">
              {paper.source?.primaryUrl && <a href={paper.source.primaryUrl} target="_blank" rel="noopener noreferrer">论文原文 ↗</a>}
              {paper.claimCount > 0 && <a href={href(`/claims?q=${encodeURIComponent(paper.id)}`)}>相关主张</a>}
            </div>
          </DenseObjectRow>
        </div>
      ))}
    </section>
  </div>

  <style>
[data-explorer-record][data-importance="decision"]{border-left:5px solid #237ba6;background:#f0f8fd}[data-explorer-record][data-importance="comparator"]{border-left:5px solid #7581a5;background:#f4f6fb}.source-priority{display:inline-flex;border:1px solid #92c5de;background:#dfedf7;color:#205e7d;border-radius:4px;padding:3px 7px;font-size:11px;font-weight:850}.source-priority.comparator{border-color:#c4cadc;background:#e8ebf6;color:#485c87}

    .compact-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:24px}.compact-hero>div:first-child{max-width:72rem}.compact-hero h1{margin:0;font-size:clamp(1.65rem,2.5vw,2.25rem);letter-spacing:-.045em}.compact-hero p:not(.eyebrow){margin:.55rem 0 0;max-width:82ch;color:var(--text-muted);line-height:1.55}
    .summary-chips{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:6px;min-width:20rem}.summary-chips span{padding:5px 8px;border-radius:999px;background:#eef6fb;color:#365f7c;font-size:9px;font-weight:850;white-space:nowrap}
    .dense-list{margin-top:12px;border:1px solid var(--line);border-radius:var(--radius-md);overflow:hidden;background:var(--surface);box-shadow:var(--shadow-1)}

    .paper-main,.paper-details,.paper-meta{display:grid;gap:6px;min-width:0}.topline{display:flex;gap:5px;align-items:center;flex-wrap:wrap}.topline span,.topline b,.topline em{padding:3px 6px;border-radius:999px;font-size:.54rem;font-style:normal;font-weight:900;letter-spacing:.04em}.topline span{background:#eef6fb;color:#315f80}.topline b{background:#eef4f8;color:#587185}.topline em{background:#e7f6ef;color:#087a66}
    .title{color:#1d405a;font-size:.94rem;font-weight:850;line-height:1.4;text-decoration:none}.title:hover,.title:focus-visible{text-decoration:underline;text-underline-offset:.16em}.authors,.venue{margin:0;color:#708696;font-size:.68rem;line-height:1.4}.venue{font-style:italic}

    .paper-details>div{display:grid;gap:3px}.paper-details span,.direction-line>span{color:#0b67b2;font-size:.56rem;font-weight:900;letter-spacing:.05em;text-transform:uppercase}.paper-details p{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;margin:0;color:#182b3d;font-size:.9rem;font-weight:650;line-height:1.55}.direction-line p{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;margin:0;color:#536d80;font-size:.75rem;line-height:1.5}.muted{margin:0;color:#536d80;font-size:.82rem;font-weight:600}
    .relation-metrics{display:flex;gap:12px;flex-wrap:wrap}.relation-metrics span{color:#6a8192;font-size:.64rem}.relation-metrics b{color:#0b67b2;font-size:.88rem}.deep-state{display:grid;gap:3px}.deep-state>b{width:fit-content;padding:3px 6px;border-radius:999px;background:#e7f6ef;color:#087a66;font-size:.56rem;text-transform:uppercase}.deep-state span,.reference-state{color:#687f90;font-size:.62rem}.direction-line{display:grid;gap:3px}

    .row-actions{display:flex;gap:5px;flex-wrap:wrap}.row-actions a{padding:5px 7px;border:1px solid #d8e7f1;border-radius:6px;color:#43677f;font-size:.62rem;font-weight:800;text-decoration:none;white-space:nowrap}.row-actions a:hover{background:#eef6fb;color:#0b67b2}
    [hidden]{display:none!important}@media(max-width:850px){.compact-hero{align-items:flex-start;flex-direction:column}.summary-chips{justify-content:flex-start;min-width:0}}
  </style>
</BaseLayout>
