---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { buildPaperExplorerVM } from '../../view-models/builders';

const vm = buildPaperExplorerVM();
const deepReadCount = vm.records.filter((paper) => Boolean(paper.deepReadLevel)).length;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<BaseLayout title="Russia-Thermal — Papers" description={vm.summary}>
  <SiteHeader slot="header" />

  <section class="hero">
    <p class="eyebrow">Research objects</p>
    <h1>{vm.title}</h1>
    <p>{vm.summary}</p>
    <div class="summary-chips">
      <span>{vm.records.length} paper sources</span>
      <span>{deepReadCount} deep reads</span>
      <span>{vm.records.length - deepReadCount} reference / supporting reads pending</span>
    </div>
  </section>

  <section class="paper-list">
    {vm.records.map((paper) => (
      <a class="paper-card" href={href(paper.href)}>
        <div class="paper-main">
          <span>{paper.year ?? 'n.d.'}{paper.countryContext ? ` · ${paper.countryContext}` : ''}{paper.venue ? ` · ${paper.venue}` : ''}</span>
          {paper.deepReadLevel && <div class="deep-badge">{paper.deepReadLevel} Deep Read · {paper.reviewStatus}</div>}
          <h2>{paper.title}</h2>
          {paper.authors.length > 0 && <p>{paper.authors.join(', ')}</p>}
        </div>
        <div class="paper-meta">
          <div><b>{paper.claimCount}</b><span>claims</span></div>
          <div><b>{paper.directionCount}</b><span>directions</span></div>
          <strong>Open paper →</strong>
        </div>
      </a>
    ))}
  </section>

  <style>
    .paper-list{display:grid;gap:12px;margin-top:28px}
    .paper-card{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(260px,.55fr);gap:20px;padding:18px 20px;border:1px solid #d2e3ef;border-radius:14px;background:#fff;text-decoration:none;color:inherit}
    .paper-card:hover{border-color:#79b3df;box-shadow:0 10px 26px rgba(42,96,140,.07)}
    .summary-chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}.summary-chips span{padding:5px 8px;border-radius:999px;background:#eef6fb;color:#365f7c;font-size:10px;font-weight:800}
    .paper-main>span{font-size:10px;color:#0b67b2;font-weight:800;text-transform:uppercase;letter-spacing:.05em}
    .deep-badge{width:fit-content;margin-top:7px;padding:4px 7px;border-radius:999px;background:#e8f6ef;color:#087a66;font-size:9px;font-weight:900;text-transform:uppercase}
    .paper-main h2{margin:5px 0 7px;font-size:15px;line-height:1.45}
    .paper-main p{margin:0;color:#637b8e;font-size:11px}
    .paper-meta{display:grid;grid-template-columns:1fr 1fr;gap:8px;align-content:center}
    .paper-meta>div{display:grid;gap:2px;padding:9px;background:#f6fafd;border-radius:8px}
    .paper-meta b{font-size:18px;color:#0b67b2}
    .paper-meta span{font-size:9px;color:#6c8293;text-transform:uppercase}
    .paper-meta strong{grid-column:1/-1;justify-self:end;color:#0b67b2;font-size:11px}
    @media(max-width:760px){.paper-card{grid-template-columns:1fr}}
  </style>
</BaseLayout>
