---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StatStrip from '../components/StatStrip.astro';
import EvidenceCard from '../components/EvidenceCard.astro';
import { buildEvidenceExplorerVM } from '../view-models/builders';

const vm = buildEvidenceExplorerVM();
---

<BaseLayout title="Russia-Thermal — Evidence Explorer" description={vm.summary}>
  <SiteHeader slot="header" />
  <section class="hero">
    <p class="eyebrow">{vm.eyebrow}</p>
    <h1>{vm.title}</h1>
    <p>{vm.summary}</p>
  </section>

  <StatStrip items={[
    { label: 'Evidence records', value: vm.totalEvidence },
    { label: 'Claims', value: vm.totalClaims }
  ]} />

  <section class="stack" aria-label="Evidence records">
    {vm.records.map((model) => <EvidenceCard model={model} />)}
  </section>
</BaseLayout>

<style>
  .stack { display: grid; gap: var(--space-6); margin-top: var(--space-12); }
</style>
