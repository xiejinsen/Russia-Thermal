---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ExplorerToolbar from '../components/ExplorerToolbar.astro';
import DenseObjectRow from '../components/DenseObjectRow.astro';
import { buildEvidenceExplorerVM } from '../view-models/builders';
import { directionTitle } from '../view-models/helpers';

const vm = buildEvidenceExplorerVM();
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;

const sourceTypes = [...new Set(vm.records.map((record) => record.sourceType))].sort();
const countries = [...new Set(vm.records.map((record) => record.countryContext).filter((value): value is string => Boolean(value)))].sort();
const years = [...new Set(vm.records.map((record) => record.year).filter((value): value is number => typeof value === 'number'))].sort((a,b)=>b-a);
const usageRoles = [...new Set(vm.records.map((record) => record.usageRole).filter((value): value is string => Boolean(value)))].sort();
const directionOptions = [...new Map(
  vm.records.flatMap((record) => record.linkedDirections).map((direction) => [direction.id, direction.title])
).entries()]
  .map(([value,label])=>({value,label}))
  .sort((a,b)=>a.label.localeCompare(b.label));

const paperCount = vm.records.filter((record) => record.id.startsWith('PAPER-')).length;
const patentCount = vm.records.filter((record) => record.id.startsWith('PATENT-')).length;
const otherSourceCount = vm.records.length - paperCount - patentCount;

const records = vm.records.map((record) => {
  const directionIds = record.linkedDirections.map((direction) => direction.id);
  const relation = [
    ...(record.supportingClaims.length ? ['supporting'] : []),
    ...(record.contradictingClaims.length ? ['pressure'] : []),
    ...(!record.supportingClaims.length && !record.contradictingClaims.length ? ['context'] : [])
  ];
  const isPaper = record.id.startsWith('PAPER-');
  const isPatent = record.id.startsWith('PATENT-');
  const localDetailHref = isPaper ? `/papers/${record.id}` : isPatent ? `/patents/${record.id}` : undefined;

  return {
    ...record,
    directionIds,
    relation,
    isPaper,
    isPatent,
    localDetailHref,
    search: [
      record.id,
      record.title,
      record.sourceType,
      record.usageRole ?? '',
      record.venue ?? '',
      ...record.authors,
      record.countryContext ?? '',
      ...record.findings,
      record.boundary ?? '',
      ...record.supportingClaims.map((claim) => `${claim.id} ${claim.proposition}`),
      ...record.contradictingClaims.map((claim) => `${claim.id} ${claim.proposition}`),
      ...record.linkedCapabilities.map((capability) => `${capability.id} ${capability.statement}`),
      ...record.institutionNames,
      ...record.peopleNames,
      ...record.linkedDirections.map((direction) => `${direction.id} ${direction.title}`)
    ].join(' ')
  };
});
---

<BaseLayout title="Russia-Thermal — Evidence Explorer" description={vm.summary}>
  <SiteHeader slot="header" />

  <div data-explorer-root>
    <section class="hero compact-hero">
      <div>
        <p class="eyebrow">{vm.eyebrow}</p>
        <h1>{vm.title}</h1>
        <p>{vm.summary}</p>
      </div>
      <div class="summary-chips">
        <span>{vm.totalEvidence} sources</span>
        <span>{paperCount} Paper sources</span>
        <span>{patentCount} Patent sources</span>
        <span>{otherSourceCount} other sources</span>
      </div>
    </section>

    <ExplorerToolbar
      sticky
      compact
      total={records.length}
      urlFilterKeys={['claim', 'capability', 'actor', 'person']}
      searchPlaceholder="Search source, finding, boundary, author, institution, person, Claim…"
      filters={[
        { key:'sourceType', label:'Type', options:sourceTypes.map((value)=>({value,label:value})) },
        {
          key:'country',
          label:'Country',
          options:countries.map((value)=>({value,label:value === 'RU' ? 'Russia' : value === 'CN' ? 'China' : value}))
        },
        { key:'year', label:'Year', options:years.map((value)=>({value:String(value),label:String(value)})) },
        {
          key:'usageRole',
          label:'Role',
          options:[...usageRoles.map((value)=>({value,label:value})),{value:'NO_ROLE',label:'Claim-linked / no context role'}]
        },
        {
          key:'relation',
          label:'Relation',
          options:[
            {value:'supporting',label:'Supports Claim'},
            {value:'pressure',label:'Pressures Claim'},
            {value:'context',label:'Context only'}
          ]
        },
        { key:'direction', label:'Direction', options:directionOptions }
      ]}
    />

    <section class="dense-list" aria-label="Evidence research index">
      {records.map((record) => (
        <div
          data-explorer-record
          data-source-type={record.sourceType}
          data-country={record.countryContext ?? ''}
          data-year={record.year ? String(record.year) : ''}
          data-usage-role={record.usageRole ?? 'NO_ROLE'}
          data-relation={record.relation.join('|')}
          data-direction={record.directionIds.join('|')}
          data-claim={[...new Set([...record.supportingClaims.map((claim)=>claim.id), ...record.contradictingClaims.map((claim)=>claim.id)])].join('|')}
          data-supporting-claim={record.supportingClaims.map((claim)=>claim.id).join('|')}
          data-pressure-claim={record.contradictingClaims.map((claim)=>claim.id).join('|')}
          data-capability={record.linkedCapabilities.map((capability)=>capability.id).join('|')}
          data-actor={record.institutionIds.join('|')}
          data-person={record.peopleIds.join('|')}
          data-search={record.search}
        >
          <DenseObjectRow
            layout="detail-heavy"
            href={record.localDetailHref ? href(record.localDetailHref) : undefined}
            ariaLabel={record.title}
          >
            <div slot="main" class="source-main">
              <div class="topline">
                <span>{record.id}</span>
                <b>{record.sourceType}</b>
                {record.year && <em>{record.year}</em>}
                {record.countryContext && <i>{record.countryContext}</i>}
              </div>
              {record.localDetailHref ? (
                <a class="title" href={href(record.localDetailHref)}>{record.title}</a>
              ) : (
                <a class="title" href={record.primaryUrl} target="_blank" rel="noopener noreferrer">{record.title} ↗</a>
              )}
              <p class="source-line">
                {record.venue ?? ''}
                {record.authors.length > 0 ? `${record.venue ? ' · ' : ''}${record.authors.slice(0,3).join(' · ')}${record.authors.length > 3 ? ' et al.' : ''}` : ''}
              </p>
            </div>

            <div slot="details" class="source-details">
              {record.findings.length > 0 ? (
                <div>
                  <span>Direct finding</span>
                  <p>{record.findings[0]}</p>
                </div>
              ) : (
                <p class="muted">Context source without a technical direct-finding statement.</p>
              )}
              {record.boundary && (
                <div>
                  <span>Boundary</span>
                  <p>{record.boundary}</p>
                </div>
              )}
            </div>

            <div slot="meta" class="source-meta">
              <div class="relation-metrics">
                <span><b>{record.supportingClaims.length}</b> support</span>
                <span class="pressure"><b>{record.contradictingClaims.length}</b> pressure</span>
                <span><b>{record.linkedCapabilities.length}</b> capabilities</span>
              </div>
              <div class="role-line">
                <span>Role</span>
                <b>{record.usageRole ?? 'Claim-linked'}</b>
              </div>
              {record.linkedDirections.length > 0 && (
                <div class="direction-line">
                  <span>Direction context</span>
                  <p>{record.linkedDirections.slice(0,2).map((direction)=>direction.title || directionTitle(direction.id)).join(' · ')}{record.linkedDirections.length > 2 ? ' …' : ''}</p>
                </div>
              )}
            </div>

            <div slot="actions" class="row-actions">
              {record.localDetailHref && <a href={href(record.localDetailHref)}>Detail</a>}
              <a href={record.primaryUrl} target="_blank" rel="noopener noreferrer">Original ↗</a>
              {(record.supportingClaims.length > 0 || record.contradictingClaims.length > 0) && <a href={href(`/claims?q=${encodeURIComponent(record.id)}`)}>Claims</a>}
              {record.linkedCapabilities.slice(0,2).map((capability) => <a href={href(`/capabilities/${capability.id}`)}>{capability.id}</a>)}
            </div>
          </DenseObjectRow>
        </div>
      ))}
    </section>
  </div>

  <style>
    .compact-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:24px}.compact-hero>div:first-child{max-width:72rem}.compact-hero h1{margin:0;font-size:clamp(1.65rem,2.5vw,2.25rem);letter-spacing:-.045em}.compact-hero p:not(.eyebrow){margin:.55rem 0 0;max-width:84ch;color:var(--text-muted);line-height:1.55}
    .summary-chips{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:6px;min-width:20rem}.summary-chips span{padding:5px 8px;border-radius:999px;background:#eef6fb;color:#365f7c;font-size:9px;font-weight:850;white-space:nowrap}
    .dense-list{margin-top:12px;border:1px solid var(--line);border-radius:var(--radius-md);overflow:hidden;background:var(--surface);box-shadow:var(--shadow-1)}

    .source-main,.source-details,.source-meta{display:grid;gap:6px;min-width:0}.topline{display:flex;gap:5px;align-items:center;flex-wrap:wrap}.topline span,.topline b,.topline em,.topline i{padding:3px 6px;border-radius:999px;font-size:.54rem;font-style:normal;font-weight:900;letter-spacing:.04em}.topline span{background:#eef6fb;color:#315f80}.topline b{background:#eef4f8;color:#587185}.topline em{background:#f3f0fb;color:#60558a}.topline i{background:#e7f6ef;color:#087a66}
    .title{color:#1d405a;font-size:.92rem;font-weight:850;line-height:1.4;text-decoration:none}.title:hover,.title:focus-visible{text-decoration:underline;text-underline-offset:.16em}.source-line{margin:0;color:#708696;font-size:.67rem;line-height:1.4;font-style:italic}

    .source-details>div{display:grid;gap:3px}.source-details span,.role-line>span,.direction-line>span{color:#0b67b2;font-size:.56rem;font-weight:900;letter-spacing:.05em;text-transform:uppercase}.source-details p,.direction-line p{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;margin:0;color:#536d80;font-size:.75rem;line-height:1.5}.muted{margin:0;color:#8798a5;font-size:.72rem}
    .relation-metrics{display:flex;gap:10px;flex-wrap:wrap}.relation-metrics span{color:#6a8192;font-size:.62rem}.relation-metrics b{color:#0b67b2;font-size:.86rem}.relation-metrics .pressure b{color:#a6662d}.role-line{display:grid;gap:2px}.role-line b{color:#5d668b;font-size:.62rem}.direction-line{display:grid;gap:3px}

    .row-actions{display:flex;gap:5px;flex-wrap:wrap}.row-actions a{padding:5px 7px;border:1px solid #d8e7f1;border-radius:6px;color:#43677f;font-size:.62rem;font-weight:800;text-decoration:none;white-space:nowrap}.row-actions a:hover{background:#eef6fb;color:#0b67b2}
    [hidden]{display:none!important}@media(max-width:850px){.compact-hero{align-items:flex-start;flex-direction:column}.summary-chips{justify-content:flex-start;min-width:0}}
  </style>
</BaseLayout>
