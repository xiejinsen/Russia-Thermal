---
import DesignLabLayout from '../../layouts/DesignLabLayout.astro';
import { buildOverviewVM } from '../../view-models/builders';
const vm=buildOverviewVM(); const base=import.meta.env.BASE_URL; const href=(p:string)=>`${base}${p.replace(/^\//,'')}`;
---
<DesignLabLayout title="Russia-Thermal — Intelligence prototype" description={vm.summary} theme="intelligence">
<div class="app">
<aside class="rail"><div class="logo">RT</div><a class="active" href="#">OV</a><a href="#act">P1</a><a href="#compare">C×R</a><a href={href('/evidence')}>EV</a><a href={href('/decisions')}>DC</a></aside>
<div class="workspace">
<header><div><b>Russia-Thermal Intelligence</b><span>smartphone thermal collaboration landscape</span></div><div class="updated">SYNTHESIS · {vm.thesisAssessedAt ?? 'CURRENT'}</div></header>
<main>
<section class="signal">
  <div><span class="tag">PORTFOLIO SIGNAL</span><h1>{vm.title}</h1><p>{vm.summary}</p></div>
  <div class="scoreboard"><div><b>{vm.priorities.length}</b><span>PRIORITY PACKAGES</span></div><div><b>{vm.stats.activeDirections}</b><span>ACTIVE / RESERVE</span></div><div><b>{vm.stats.capabilities}</b><span>CAPABILITIES</span></div></div>
</section>
<section class="basis">
  <div class="bar-title"><span>THESIS BASIS</span><span>3 strongest reasons</span></div>
  <div class="basis-grid">{vm.theoryBasis.slice(0,3).map((x,i)=><div><b>0{i+1}</b><p>{x}</p></div>)}</div>
</section>
<section id="act" class="panel">
  <div class="panel-head"><div><span>ACTION QUEUE</span><h2>Priority collaboration packages</h2></div><p>Only packages with a bounded technical proposition and an explicit next gate appear here.</p></div>
  <div class="table">
    <div class="tr head"><span>Rank</span><span>Partner</span><span>Technical focus</span><span>Decision</span><span>Next gate</span></div>
    {vm.priorities.map((p)=>{const d=p.directions[0];return <div class="tr"><b>{p.rank}</b><span>{p.institutions[0]?.name}</span><span>{d?.title}</span><span class="status">{d?.recommendation}</span><span>{d?.nextQuestion ?? d?.nextGate}</span></div>})}
  </div>
</section>
<section id="compare" class="panel">
  <div class="panel-head"><div><span>COMPARATOR</span><h2>Where residual value survives</h2></div><p>China/global baseline on the left. Russian residual on the right. Decision in the middle.</p></div>
  <div class="matrix">
    {vm.landscape.map((row)=><article>
      <div class="dir"><b>{row.direction.title}</b><span>{row.direction.phoneTransferMaturity} phone maturity</span></div>
      <div class="baseline"><small>{row.chinaLabel}</small><p>{row.chinaBaseline}</p></div>
      <div class="decision"><span>{row.direction.recommendation}</span></div>
      <div class="residual"><small>{row.russiaLabel}</small><p>{row.russiaResidual}</p></div>
    </article>)}
  </div>
</section>
<section class="lower">
 <div class="panel reject"><div class="panel-head"><div><span>REJECTION LOG</span><h2>Killed theses</h2></div></div>{vm.killDecisions.slice(0,4).map(d=><div class="kill"><b>×</b><span>{d.subject}</span></div>)}</div>
 <div class="panel frontier"><div class="panel-head"><div><span>FRONTIER WATCH</span><h2>Coverage</h2></div></div><div class="numbers"><b>{vm.frontier.coveredVenueCount}/{vm.frontier.venueCount}</b><span>venues represented</span><b>{vm.frontier.matchedEvidence}</b><span>matched evidence records</span><b>{vm.frontier.latestYear}</b><span>latest evidence year</span></div></div>
</section>
</main></div></div>
</DesignLabLayout>
<style>
:global(body){
  background:
    radial-gradient(circle at 78% 0%, rgba(110,185,255,.20), transparent 34rem),
    linear-gradient(180deg,#f7fbff 0%,#eef6fc 100%);
  color:#17324d;
}
.app{min-height:100vh}
.rail{
  position:fixed;
  inset:0 auto 0 0;
  z-index:20;
  width:76px;
  height:100vh;
  background:linear-gradient(180deg,#0b5ea8 0%,#0a4f91 100%);
  border-right:1px solid rgba(6,56,102,.18);
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:10px;
  padding:18px 0;
  box-shadow:8px 0 30px rgba(25,82,132,.10);
}
.rail .logo{
  width:42px;height:42px;display:grid;place-items:center;
  background:#fff;color:#0b5ea8;font-weight:900;font-size:14px;
  border-radius:12px;margin-bottom:18px;
  box-shadow:0 6px 18px rgba(0,0,0,.12);
}
.rail a{
  font-size:12px;font-weight:800;letter-spacing:.03em;text-decoration:none;color:#d9edff;
  width:48px;height:42px;display:grid;place-items:center;border-radius:10px;
}
.rail a.active,.rail a:hover{background:rgba(255,255,255,.18);color:#fff}
.workspace{margin-left:76px;min-width:0}
.workspace header{
  position:sticky;top:0;z-index:10;height:64px;display:flex;align-items:center;justify-content:space-between;
  padding:0 28px;border-bottom:1px solid #d7e6f2;background:rgba(248,252,255,.92);
  backdrop-filter:blur(12px);
}
.workspace header div:first-child{display:flex;gap:16px;align-items:baseline}
.workspace header b{font-size:15px;color:#143b5c}
.workspace header span,.updated{
  font-size:12px;color:#60778a;text-transform:uppercase;letter-spacing:.07em
}
.updated{color:#0b67b2;font-weight:800}
main{padding:26px;max-width:1660px;margin:0 auto}
.signal{
  display:grid;grid-template-columns:minmax(0,1.8fr) minmax(380px,.8fr);gap:0;
  border:1px solid #cfe1ee;border-radius:18px;overflow:hidden;
  background:#fff;box-shadow:0 14px 38px rgba(42,96,140,.08)
}
.signal>div{background:#fff;padding:34px}
.tag,.panel-head span,.bar-title{
  font-size:12px;color:#0a6bb7;font-weight:850;letter-spacing:.09em;text-transform:uppercase
}
.signal h1{
  font-size:36px;line-height:1.1;max-width:980px;margin:10px 0 16px;letter-spacing:-.035em;color:#153955
}
.signal p{max-width:930px;color:#4d6477;margin:0;font-size:16px;line-height:1.65}
.scoreboard{
  display:grid!important;grid-template-columns:repeat(3,1fr)!important;align-content:center;gap:18px!important;
  background:linear-gradient(145deg,#e8f4ff,#f4faff)!important;border-left:1px solid #d8e8f4
}
.scoreboard div{display:grid;gap:7px}
.scoreboard b{font-size:34px;color:#0b5fa9}
.scoreboard span{font-size:11px;color:#5f7587;font-weight:800;line-height:1.35}
.basis{
  margin-top:18px;border:1px solid #cfe1ee;background:#fff;border-radius:16px;overflow:hidden;
  box-shadow:0 10px 28px rgba(42,96,140,.05)
}
.bar-title{display:flex;justify-content:space-between;padding:13px 16px;border-bottom:1px solid #dbe8f1}
.bar-title span:last-child{color:#708697;font-weight:700}
.basis-grid{display:grid;grid-template-columns:repeat(3,1fr)}
.basis-grid>div{
  display:grid;grid-template-columns:38px 1fr;gap:12px;padding:20px;border-right:1px solid #e0ebf3
}
.basis-grid>div:last-child{border-right:0}
.basis-grid b{color:#0a6bb7;font-size:13px}
.basis-grid p{margin:0;font-size:14px;line-height:1.6;color:#435d70}
.panel{
  margin-top:18px;background:#fff;border:1px solid #cfe1ee;border-radius:16px;overflow:hidden;
  box-shadow:0 10px 28px rgba(42,96,140,.05)
}
.panel-head{
  display:flex;justify-content:space-between;gap:30px;padding:19px 20px;border-bottom:1px solid #dbe8f1;
  background:linear-gradient(180deg,#fbfdff,#f6faff)
}
.panel-head h2{font-size:20px;margin:4px 0 0;color:#183c59;letter-spacing:-.02em}
.panel-head p{font-size:13px;line-height:1.55;color:#5e7485;max-width:540px;margin:0}
.table{overflow-x:auto}
.tr{
  display:grid;grid-template-columns:76px 190px 230px 205px minmax(360px,1fr);
  min-width:1060px;border-bottom:1px solid #e0ebf3
}
.tr>*{padding:16px 14px;border-right:1px solid #e6eef4;font-size:13px;line-height:1.55;color:#334f63}
.tr.head{background:#f2f8fc;color:#587187;text-transform:uppercase;letter-spacing:.05em;font-weight:800}
.tr.head>*{font-size:11px}
.tr b{color:#0a67b0}
.status{color:#087a66!important;font-weight:800;background:#f2fbf8}
.matrix article{
  display:grid;grid-template-columns:210px 1fr 175px 1fr;border-bottom:1px solid #dfeaf2
}
.matrix article>div{padding:18px;border-right:1px solid #e4edf4}
.dir{display:grid;gap:7px;background:#fbfdff}
.dir b{font-size:14px;color:#254a66}
.dir span,small{font-size:11px;color:#617b8f;text-transform:uppercase;letter-spacing:.05em}
.baseline{background:#edf6ff}
.residual{background:#eef9f6}
.matrix p{font-size:13px;line-height:1.62;color:#3e596c;margin:.55rem 0 0}
.decision{display:grid;place-items:center;text-align:center;background:#f8fbfd}
.decision span{font-size:12px;font-weight:850;color:#0a68b1;line-height:1.45}
.lower{display:grid;grid-template-columns:1.5fr .7fr;gap:18px}
.kill{display:grid;grid-template-columns:34px 1fr;padding:16px 20px;border-bottom:1px solid #e0ebf3;font-size:13px;color:#344f63}
.kill b{color:#c65454;font-size:16px}
.numbers{display:grid;grid-template-columns:auto 1fr;gap:14px 16px;padding:22px}
.numbers b{font-size:28px;color:#0b64aa}
.numbers span{font-size:12px;color:#5e7486;align-self:center;line-height:1.35}

@media(max-width:900px){
  .rail{position:static;width:100%;height:58px;flex-direction:row;justify-content:center;padding:8px}
  .rail .logo{width:38px;height:38px;margin:0 12px 0 0}
  .rail a{height:38px;width:46px}
  .workspace{margin-left:0}
  .workspace header span{display:none}
  .signal,.lower{grid-template-columns:1fr}
  .scoreboard{grid-template-columns:repeat(3,1fr)!important;border-left:0;border-top:1px solid #d8e8f4}
  .basis-grid{grid-template-columns:1fr}
  .basis-grid>div{border-right:0;border-bottom:1px solid #e0ebf3}
  .matrix article{grid-template-columns:1fr}
  .matrix article>div{border-right:0}
  main{padding:16px}
}
</style>