---
import DesignLabLayout from '../../layouts/DesignLabLayout.astro';
import { buildOverviewVM } from '../../view-models/builders';
const vm=buildOverviewVM(); const base=import.meta.env.BASE_URL; const href=(p:string)=>`${base}${p.replace(/^\//,'')}`;
---
<DesignLabLayout title="Russia-Thermal — Intelligence prototype" description={vm.summary} theme="intelligence">
<div class="app">
<div class="workspace">
<header class="topbar">
  <div class="brand-block">
    <div class="logo">RT</div>
    <div><b>Russia-Thermal Intelligence</b><span>smartphone thermal collaboration landscape</span></div>
  </div>
  <nav class="topnav" aria-label="Research intelligence navigation">
    <a class="active" href="#">Overview</a>
    <a href="#act">Act</a>
    <a href="#compare">Compare</a>
    <a href={href('/evidence')}>Evidence</a>
    <a href={href('/decisions')}>Decisions</a>
  </nav>
  <div class="updated">SYNTHESIS · {vm.thesisAssessedAt ?? 'CURRENT'}</div>
</header>
<main>
<section class="signal">
  <div><span class="tag">PORTFOLIO SIGNAL</span><h1>{vm.title}</h1><p>{vm.summary}</p></div>
  <div class="scoreboard"><div><b>{vm.priorities.length}</b><span>PRIORITY PACKAGES</span></div><div><b>{vm.stats.activeDirections}</b><span>ACTIVE / RESERVE</span></div><div><b>{vm.stats.capabilities}</b><span>CAPABILITIES</span></div></div>
</section>
<section class="basis">
  <div class="bar-title"><span>WHY THIS CONCLUSION</span><span>3 strongest reasons</span></div>
  <div class="basis-grid">{vm.theoryBasis.slice(0,3).map((x,i)=><div><b>0{i+1}</b><p>{x}</p></div>)}</div>
</section>

<section class="management-strip">
  <div><span>DO NOW</span><b>Validate the three priority collaboration packages</b><p>Advance only where Russian residual capability can add decision-relevant value beyond the China/global baseline.</p></div>
  <div><span>DO NOT</span><b>Do not fund broad Russia-over-China superiority theses</b><p>Country-level narratives already killed by comparator pressure stay out of the investment case.</p></div>
  <div><span>KEEP WATCH</span><b>Maintain frontier coverage without treating it as partner evidence</b><p>New venue evidence can trigger reassessment, but discovery alone does not promote a direction.</p></div>
</section>
<section id="act" class="panel">
  <div class="panel-head">
    <div><span>01 · ACT</span><h2>Advance three bounded collaboration packages</h2></div>
    <p><b>Question answered:</b> who should we engage first, what should we work on, and what must be proven before promotion?</p>
  </div>
  <div class="priority-stack">
    {vm.priorities.map((p)=>{const d=p.directions[0];return <article class="priority-row">
      <div class="priority-rank"><b>{p.rank}</b><span>{p.institutions[0]?.name}</span></div>
      <div class="priority-decision"><span>DECISION</span><strong>{d?.recommendation}</strong><p>{d?.collaborationFocus ?? p.rationale}</p></div>
      <div class="priority-why"><span>WHY RUSSIA STILL ADDS VALUE</span><p>{d?.residualDifferentiation ?? p.rationale}</p></div>
      <div class="priority-gate"><span>NEXT GATE</span><p>{d?.nextQuestion ?? d?.nextGate}</p></div>
    </article>})}
  </div>
</section>
<section id="compare" class="panel">
  <div class="panel-head">
    <div><span>02 · COMPARE</span><h2>China leads the product stack; Russia retains selective specialist value</h2></div>
    <p><b>Question answered:</b> after comparator pressure, where does a Russian capability still change a smartphone decision?</p>
  </div>
  <div class="compare-summary">
    <b>Portfolio conclusion</b>
    <p>Do not compare countries in the abstract. Retain only direction-level residuals that survive a stronger China/global baseline and still clear a phone-relevant validation gate.</p>
  </div>
  <div class="matrix">
    {vm.landscape.map((row)=><article class="compare-row">
      <div class="compare-top">
        <div class="dir"><b>{row.direction.title}</b><span>{row.direction.phoneTransferMaturity} phone maturity</span></div>
        <div class="decision"><small>DECISION</small><strong>{row.direction.recommendation}</strong></div>
        <div class="focus"><small>COLLABORATION FOCUS</small><p>{row.direction.collaborationFocus ?? row.direction.residualDifferentiation}</p></div>
      </div>
      <div class="compare-detail">
        <div class="baseline"><small>{row.chinaLabel}</small><p>{row.chinaBaseline}</p></div>
        <div class="residual"><small>{row.russiaLabel}</small><p>{row.russiaResidual}</p></div>
        <div class="next"><small>NEXT VALIDATION QUESTION</small><p>{row.direction.nextQuestion ?? row.direction.nextGate}</p></div>
      </div>
    </article>)}
  </div>
</section>
<section class="lower">
 <div class="panel reject">
   <div class="panel-head"><div><span>03 · REJECT</span><h2>Broad theses we should not invest in</h2></div><p>Rejection is part of the portfolio conclusion, not an appendix.</p></div>
   {vm.killDecisions.slice(0,4).map(d=><div class="kill"><b>×</b><div><strong>{d.subject}</strong><p>{d.rationale}</p></div></div>)}
 </div>
 <div class="panel frontier">
   <div class="panel-head"><div><span>04 · WATCH</span><h2>Frontier coverage</h2></div><p>Discovery coverage only. Not evidence of partner readiness.</p></div>
   <div class="numbers"><b>{vm.frontier.coveredVenueCount}/{vm.frontier.venueCount}</b><span>venues represented</span><b>{vm.frontier.matchedEvidence}</b><span>matched evidence records</span><b>{vm.frontier.latestYear}</b><span>latest evidence year</span></div>
 </div>
</section>
</main></div></div>
</DesignLabLayout>
<style>
:global(body){
  background:
    radial-gradient(circle at 78% 0%, rgba(110,185,255,.20), transparent 34rem),
    linear-gradient(180deg,#f7fbff 0%,#eef6fc 100%);
  color:#17324d;
}
.app{min-height:100vh}
.workspace{min-width:0}
.topbar{
  position:sticky;top:0;z-index:20;
  min-height:72px;
  display:grid;
  grid-template-columns:minmax(260px,1fr) auto auto;
  align-items:center;
  gap:24px;
  padding:10px 28px;
  border-bottom:1px solid #d7e6f2;
  background:rgba(248,252,255,.94);
  backdrop-filter:blur(12px);
  box-shadow:0 6px 20px rgba(38,89,130,.05);
}
.brand-block{display:flex;align-items:center;gap:12px;min-width:0}
.logo{
  width:42px;height:42px;display:grid;place-items:center;
  background:linear-gradient(145deg,#0b67b2,#0a5598);
  color:#fff;font-weight:900;font-size:13px;border-radius:11px;
  box-shadow:0 6px 16px rgba(11,94,168,.18);
  flex:0 0 auto;
}
.brand-block>div:last-child{display:grid;gap:2px;min-width:0}
.brand-block b{font-size:15px;color:#143b5c;white-space:nowrap}
.brand-block span{
  font-size:11px;color:#60778a;text-transform:uppercase;letter-spacing:.06em;white-space:nowrap
}
.topnav{display:flex;align-items:center;gap:4px}
.topnav a{
  padding:9px 12px;border-radius:9px;text-decoration:none;
  font-size:12px;font-weight:750;color:#3f6079
}
.topnav a:hover,.topnav a.active{background:#e8f3fb;color:#0b67b2}
.updated{
  font-size:11px;color:#0b67b2;font-weight:800;text-transform:uppercase;letter-spacing:.06em;white-space:nowrap
}
main{padding:26px;max-width:1660px;margin:0 auto}
.signal{
  display:grid;grid-template-columns:minmax(0,1.8fr) minmax(380px,.8fr);gap:0;
  border:1px solid #cfe1ee;border-radius:18px;overflow:hidden;
  background:#fff;box-shadow:0 14px 38px rgba(42,96,140,.08)
}
.signal>div{background:#fff;padding:34px}
.tag,.panel-head span,.bar-title{
  font-size:12px;color:#0a6bb7;font-weight:850;letter-spacing:.09em;text-transform:uppercase
}
.signal h1{
  font-size:36px;line-height:1.1;max-width:980px;margin:10px 0 16px;letter-spacing:-.035em;color:#153955
}
.signal p{max-width:930px;color:#4d6477;margin:0;font-size:16px;line-height:1.65}
.scoreboard{
  display:grid!important;grid-template-columns:repeat(3,1fr)!important;align-content:center;gap:18px!important;
  background:linear-gradient(145deg,#e8f4ff,#f4faff)!important;border-left:1px solid #d8e8f4
}
.scoreboard div{display:grid;gap:7px}
.scoreboard b{font-size:34px;color:#0b5fa9}
.scoreboard span{font-size:11px;color:#5f7587;font-weight:800;line-height:1.35}
.basis{
  margin-top:18px;border:1px solid #cfe1ee;background:#fff;border-radius:16px;overflow:hidden;
  box-shadow:0 10px 28px rgba(42,96,140,.05)
}
.bar-title{display:flex;justify-content:space-between;padding:13px 16px;border-bottom:1px solid #dbe8f1}
.bar-title span:last-child{color:#708697;font-weight:700}
.basis-grid{display:grid;grid-template-columns:repeat(3,1fr)}
.basis-grid>div{
  display:grid;grid-template-columns:38px 1fr;gap:12px;padding:20px;border-right:1px solid #e0ebf3
}
.basis-grid>div:last-child{border-right:0}
.basis-grid b{color:#0a6bb7;font-size:13px}
.basis-grid p{margin:0;font-size:14px;line-height:1.6;color:#435d70}
.management-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:18px;border:1px solid #cfe1ee;border-radius:16px;overflow:hidden;background:#d7e6f2;box-shadow:0 10px 28px rgba(42,96,140,.05)}
.management-strip>div{display:grid;gap:8px;padding:20px;background:#fff}
.management-strip span{font-size:11px;font-weight:850;letter-spacing:.08em;color:#0a6bb7}
.management-strip b{font-size:15px;line-height:1.35;color:#173f5e}
.management-strip p{margin:0;font-size:13px;line-height:1.55;color:#5a7183}
.panel{
  margin-top:18px;background:#fff;border:1px solid #cfe1ee;border-radius:16px;overflow:hidden;
  box-shadow:0 10px 28px rgba(42,96,140,.05)
}
.panel-head{
  display:flex;justify-content:space-between;gap:30px;padding:19px 20px;border-bottom:1px solid #dbe8f1;
  background:linear-gradient(180deg,#fbfdff,#f6faff)
}
.panel-head h2{font-size:20px;margin:4px 0 0;color:#183c59;letter-spacing:-.02em}
.panel-head p{font-size:13px;line-height:1.55;color:#5e7485;max-width:540px;margin:0}
.priority-stack{display:grid}
.priority-row{display:grid;grid-template-columns:150px minmax(270px,1.05fr) minmax(260px,1fr) minmax(280px,1.05fr);border-bottom:1px solid #dfeaf2}
.priority-row>div{padding:20px;border-right:1px solid #e4edf4}
.priority-rank{display:grid;align-content:start;gap:8px;background:#f7fbfe}
.priority-rank b{font-size:25px;color:#0b67b2}
.priority-rank span{font-size:13px;font-weight:750;color:#36566e}
.priority-decision{background:#f1fbf7}
.priority-row div>span{display:block;margin-bottom:7px;font-size:10px;font-weight:850;letter-spacing:.07em;color:#607c90}
.priority-decision strong{font-size:15px;color:#087a66}
.priority-row p{margin:8px 0 0;font-size:13px;line-height:1.6;color:#405c70}
.priority-why{background:#fff}
.priority-gate{background:#f7fbff}
.compare-summary{display:grid;grid-template-columns:170px 1fr;gap:18px;padding:15px 20px;background:#eaf5fd;border-bottom:1px solid #d7e6f2}
.compare-summary b{font-size:12px;color:#0a67b0;text-transform:uppercase;letter-spacing:.06em}
.compare-summary p{margin:0;font-size:13px;line-height:1.55;color:#405c70}
.compare-row{border-bottom:1px solid #dfeaf2}
.compare-top{display:grid;grid-template-columns:230px 190px minmax(0,1fr);border-bottom:1px solid #e3edf4;background:#fbfdff}
.compare-top>div,.compare-detail>div{padding:18px;border-right:1px solid #e4edf4}
.dir{display:grid;gap:7px}
.dir b{font-size:15px;color:#254a66}
.dir span,small{font-size:10px;color:#617b8f;text-transform:uppercase;letter-spacing:.05em}
.decision strong{display:block;margin-top:5px;font-size:13px;line-height:1.45;color:#0878c4}
.focus p,.matrix p{font-size:13px;line-height:1.62;color:#3e596c;margin:.45rem 0 0}
.compare-detail{display:grid;grid-template-columns:1fr 1fr 1fr}
.baseline{background:#edf6ff}
.residual{background:#eef9f6}
.next{background:#f8fbfd}
.lower{display:grid;grid-template-columns:1.5fr .7fr;gap:18px}
.kill{display:grid;grid-template-columns:34px 1fr;padding:16px 20px;border-bottom:1px solid #e0ebf3;font-size:13px;color:#344f63}
.kill b{color:#c65454;font-size:16px}.kill strong{font-size:13px;color:#36536a}.kill p{margin:5px 0 0;color:#607688;line-height:1.5}
.numbers{display:grid;grid-template-columns:auto 1fr;gap:14px 16px;padding:22px}
.numbers b{font-size:28px;color:#0b64aa}
.numbers span{font-size:12px;color:#5e7486;align-self:center;line-height:1.35}

@media(max-width:900px){
  .topbar{grid-template-columns:1fr;gap:8px;padding:10px 14px}
  .brand-block span,.updated{display:none}
  .topnav{overflow-x:auto;justify-content:flex-start;padding-bottom:2px}
  .topnav a{white-space:nowrap}
  .signal,.lower{grid-template-columns:1fr}
  .scoreboard{grid-template-columns:repeat(3,1fr)!important;border-left:0;border-top:1px solid #d8e8f4}
  .basis-grid,.management-strip{grid-template-columns:1fr}
  .basis-grid>div{border-right:0;border-bottom:1px solid #e0ebf3}
  .priority-row,.compare-top,.compare-detail,.compare-summary{grid-template-columns:1fr}
  .priority-row>div,.compare-top>div,.compare-detail>div{border-right:0;border-bottom:1px solid #e4edf4}
  main{padding:16px}
}
</style>