---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { buildClaimPageVM, claimIds } from '../../view-models/builders';
export function getStaticPaths(){ return claimIds().map((id)=>({params:{id}})); }
const id=Astro.params.id!;
const vm=buildClaimPageVM(id);
if(!vm) throw new Error(`Unknown claim: ${id}`);
const base=import.meta.env.BASE_URL;
const href=(path:string)=>`${base}${path.replace(/^\//,'')}`;
---
<BaseLayout title={`Russia-Thermal — ${vm.id}`} description={vm.proposition}>
  <SiteHeader slot="header" />
  <section class="claim-hero">
    <p class="eyebrow">Claim detail · {vm.status}</p>
    <h1>{vm.proposition}</h1>
    <div class="chips"><span>{vm.confidence} confidence</span>{vm.decisionRole && <span>{vm.decisionRole}</span>}<span>{vm.supportingEvidence.length} supporting sources</span><span>{vm.contradictingEvidence.length} contradicting sources</span></div>
    {vm.boundary && <p class="boundary"><b>Boundary:</b> {vm.boundary}</p>}
  </section>

  <section class="evidence-grid">
    <div class="bucket support">
      <div class="head"><span>SUPPORTING EVIDENCE</span><div class="head-actions"><b>{vm.supportingEvidence.length}</b><a href={href(`/evidence?claim=${encodeURIComponent(vm.id)}&relation=supporting`)}>All sources →</a><a href={href(`/papers?claim=${encodeURIComponent(vm.id)}&relation=supporting`)}>Papers →</a></div></div>
      {vm.supportingEvidence.map((item)=><article><span>{item.year ?? 'n.d.'} · {item.sourceType}</span><h2>{item.title}</h2>{item.findings[0] && <p>{item.findings[0]}</p>}<div class="source-actions">{item.id.startsWith('PAPER-') && <a href={href(`/papers/${item.id}`)}>Open paper →</a>}<a href={item.primaryUrl} target="_blank" rel="noreferrer">Original source ↗</a></div></article>)}
    </div>
    <div class="bucket pressure">
      <div class="head"><span>CONTRADICTING / PRESSURE EVIDENCE</span><div class="head-actions"><b>{vm.contradictingEvidence.length}</b><a href={href(`/evidence?claim=${encodeURIComponent(vm.id)}&relation=pressure`)}>All sources →</a><a href={href(`/papers?claim=${encodeURIComponent(vm.id)}&relation=pressure`)}>Papers →</a></div></div>
      {vm.contradictingEvidence.length ? vm.contradictingEvidence.map((item)=><article><span>{item.year ?? 'n.d.'} · {item.sourceType}</span><h2>{item.title}</h2>{item.findings[0] && <p>{item.findings[0]}</p>}<div class="source-actions">{item.id.startsWith('PAPER-') && <a href={href(`/papers/${item.id}`)}>Open paper →</a>}<a href={item.primaryUrl} target="_blank" rel="noreferrer">Original source ↗</a></div></article>) : <p class="empty">No contradicting source currently linked.</p>}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><span>IMPACT GRAPH</span><h2>What this claim influences</h2></div>
    <div class="impact four">
      <div><h3>Capabilities</h3>{vm.capabilities.map((cap)=><a href={href(`/capabilities/${cap.id}`)}><b>{cap.statement}</b><span>{cap.maturity} · {cap.evidenceConfidence}</span></a>)}</div>
      <div><h3>Directions</h3>{vm.directions.map((d)=><a href={href(`/directions/${d.id}`)}><b>{d.title}</b><span>{d.recommendation}</span></a>)}</div>
      <div><h3>Institutions</h3>{vm.institutions.map((i)=><a href={href(i.href ?? `/institutions/${i.id}`)}><b>{i.name}</b><span>{i.summary}</span></a>)}</div>
      <div><h3>Scholars</h3>{vm.scholars.map((s)=><a href={href(s.href ?? `/scholars/${s.id}`)}><b>{s.name}</b><span>{s.affiliation}</span></a>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><span>DECISION IMPACT</span><h2>Decisions triggered by this claim</h2></div>
    {vm.decisions.length ? <div class="decisions">{vm.decisions.map((d)=><article><span>{d.date ?? 'undated'} · {d.eventType.label}</span><b>{d.subject} → {d.newState}</b>{d.rationale && <p>{d.rationale}</p>}</article>)}</div> : <p class="empty">No Decision Event currently lists this Claim as a trigger.</p>}
  </section>

  <style>
    .claim-hero{padding:28px;border:1px solid #cfe1ee;border-radius:17px;background:#fff;box-shadow:0 10px 30px rgba(42,96,140,.06)}.claim-hero h1{max-width:1100px;font-size:24px;line-height:1.28;letter-spacing:-.03em}.chips{display:flex;gap:8px;flex-wrap:wrap}.chips span{padding:6px 8px;border-radius:999px;background:#eef6fb;color:#315f80;font-size:10px;font-weight:800}.boundary{margin:18px 0 0;padding-top:15px;border-top:1px solid #e2ebf2;color:#60788b;font-size:13px;line-height:1.6}
    .evidence-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:18px}.bucket{border:1px solid #d3e3ee;border-radius:14px;overflow:hidden;background:#fff}.bucket .head{display:flex;justify-content:space-between;padding:13px 15px;background:#f7fbfe;border-bottom:1px solid #e0ebf3}.bucket .head span{font-size:10px;font-weight:850;letter-spacing:.07em;color:#0b67b2}.bucket .head b{color:#0b67b2}.head-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.head-actions a{font-size:9px;color:#0b67b2;font-weight:850;text-decoration:none;white-space:nowrap}.bucket article{padding:15px;border-bottom:1px solid #e7eef4}.bucket article>span{font-size:9px;color:#6a8192}.bucket h2{font-size:13px;line-height:1.4;margin:5px 0}.bucket p{font-size:11px;line-height:1.5;color:#5d7486}.bucket a{font-size:10px;color:#0b67b2;font-weight:800}.source-actions{display:flex;gap:10px;flex-wrap:wrap}.pressure{background:#fffdfb}.empty{padding:16px;color:#718697;font-size:12px}
    .section{margin-top:18px;border:1px solid #d3e3ee;border-radius:14px;background:#fff;overflow:hidden}.section-head{padding:15px 18px;border-bottom:1px solid #e0ebf3;background:#f9fcfe}.section-head span{font-size:9px;color:#0b67b2;font-weight:850}.section-head h2{margin:4px 0 0;font-size:18px}.impact{display:grid;grid-template-columns:repeat(3,1fr)}.impact.four{grid-template-columns:repeat(4,1fr)}.impact>div{padding:16px}.impact>div+div{border-left:1px solid #e5edf3}.impact h3{font-size:12px;color:#5d7588}.impact a{display:grid;gap:3px;padding:10px 0;border-top:1px solid #edf2f6;text-decoration:none}.impact a b{font-size:11px}.impact a span{font-size:10px;line-height:1.4;color:#6a8192}.decisions article{display:grid;gap:5px;padding:14px 18px;border-bottom:1px solid #e5edf3}.decisions span{font-size:9px;color:#6a8192}.decisions b{font-size:12px}.decisions p{margin:0;color:#5f7789;font-size:11px;line-height:1.5}@media(max-width:800px){.evidence-grid,.impact,.impact.four{grid-template-columns:1fr}.impact>div+div{border-left:0;border-top:1px solid #e5edf3}}
  </style>
</BaseLayout>
