---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { buildClaimExplorerVM } from '../../view-models/builders';
const vm = buildClaimExplorerVM();
const base = import.meta.env.BASE_URL;
const href=(path:string)=>`${base}${path.replace(/^\//,'')}`;
---
<BaseLayout title="Russia-Thermal — Claims" description={vm.summary}>
  <SiteHeader slot="header" />
  <section class="hero">
    <p class="eyebrow">Research objects</p>
    <h1>{vm.title}</h1>
    <p>{vm.summary}</p>
  </section>
  <section class="claims">
    {vm.records.map((claim)=><a href={href(claim.href)}>
      <div><span>{claim.status} · {claim.confidence}{claim.decisionRole ? ` · ${claim.decisionRole}` : ''}</span><h2>{claim.proposition}</h2></div>
      <dl>
        <div><dt>Support</dt><dd>{claim.supportingCount}</dd></div>
        <div><dt>Pressure</dt><dd>{claim.contradictingCount}</dd></div>
        <div><dt>Directions</dt><dd>{claim.directionCount}</dd></div>
      </dl>
    </a>)}
  </section>
  <style>
    .claims{display:grid;gap:12px;margin-top:28px}.claims>a{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(260px,.5fr);gap:20px;padding:18px 20px;border:1px solid #d3e3ee;border-radius:13px;background:#fff;text-decoration:none;color:inherit}.claims>a:hover{border-color:#79b3df}.claims span{font-size:10px;color:#0b67b2;font-weight:800;text-transform:uppercase}.claims h2{margin:5px 0 0;font-size:15px;line-height:1.45}.claims dl{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:0}.claims dl>div{padding:9px;background:#f6fafd;border-radius:8px}.claims dt{font-size:9px;color:#6a8192;text-transform:uppercase}.claims dd{margin:2px 0 0;font-size:16px;font-weight:800;color:#0b67b2}@media(max-width:720px){.claims>a{grid-template-columns:1fr}}
  </style>
</BaseLayout>
