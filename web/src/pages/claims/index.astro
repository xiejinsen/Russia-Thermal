---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ExplorerToolbar from '../../components/ExplorerToolbar.astro';
import DenseObjectRow from '../../components/DenseObjectRow.astro';
import { directions, claims as claimRecords } from '../../data/load-normalized';
import { buildClaimExplorerVM } from '../../view-models/builders';
import { directionTitle } from '../../view-models/helpers';

const vm = buildClaimExplorerVM();
const base = import.meta.env.BASE_URL;
const href=(path:string)=>`${base}${path.replace(/^\//,'')}`;
const rawClaimById = new Map(claimRecords.map((claim) => [claim.id, claim]));

const statuses=[...new Set(vm.records.map((claim)=>claim.status))].sort();
const confidences=[...new Set(vm.records.map((claim)=>claim.confidence))].sort();
const roles=[...new Set(vm.records.map((claim)=>claim.decisionRole).filter((value): value is string => Boolean(value)))].sort();
const directionOptions = directions
  .filter((direction)=>vm.records.some((claim)=>claim.directionIds.includes(direction.id)))
  .map((direction)=>({value:direction.id,label:directionTitle(direction.id)}))
  .sort((a,b)=>a.label.localeCompare(b.label));

const records=vm.records.map((claim)=>({
  ...claim,
  raw:rawClaimById.get(claim.id),
  roleClass:claim.decisionRole ?? 'NO_ROLE',
  search:[
    claim.id,
    claim.proposition,
    claim.status,
    claim.confidence,
    claim.decisionRole ?? '',
    rawClaimById.get(claim.id)?.boundary ?? '',
    ...(rawClaimById.get(claim.id)?.supportingSourceIds ?? []),
    ...(rawClaimById.get(claim.id)?.contradictingSourceIds ?? []),
    ...claim.directionIds.map(directionTitle)
  ].join(' ')
}));
---

<BaseLayout title="Russia-Thermal — Claims" description={vm.summary}>
  <SiteHeader slot="header" />

  <div data-explorer-root>
    <section class="hero compact-hero">
      <div>
        <p class="eyebrow">Decision claim explorer</p>
        <h1>{vm.title}</h1>
        <p>{vm.summary}</p>
      </div>
      <div class="summary-chips">
        <span>{records.length} claims</span>
        <span>{records.filter((claim)=>claim.supportingCount>0).length} with support</span>
        <span>{records.filter((claim)=>claim.contradictingCount>0).length} pressure-tested</span>
      </div>
    </section>

    <ExplorerToolbar
      sticky
      compact
      total={records.length}
      urlFilterKeys={['capability', 'actor', 'person']}
      searchPlaceholder="Search proposition, boundary, Claim ID, role, Direction…"
      filters={[
        { key:'status', label:'Status', options:statuses.map((value)=>({value,label:value})) },
        { key:'confidence', label:'Confidence', options:confidences.map((value)=>({value,label:value})) },
        {
          key:'role',
          label:'Decision role',
          options:[...roles.map((value)=>({value,label:value})),{value:'NO_ROLE',label:'No special role'}]
        },
        {key:'direction',label:'Direction',options:directionOptions}
      ]}
    />

    <section class="dense-list" aria-label="Claim research index">
      {records.map((claim)=>(
        <div
          data-explorer-record
          data-status={claim.status}
          data-confidence={claim.confidence}
          data-role={claim.roleClass}
          data-direction={claim.directionIds.join('|')}
          data-capability={claim.capabilityIds.join('|')}
          data-actor={claim.institutionIds.join('|')}
          data-person={claim.peopleIds.join('|')}
          data-search={claim.search}
        >
          <DenseObjectRow layout="content-heavy" href={href(claim.href)} ariaLabel={claim.proposition}>
            <div slot="main" class="claim-main">
              <div class="topline">
                <span>{claim.id}</span>
                <b>{claim.status}</b>
                <em>{claim.confidence}</em>
              </div>
              <a class="title" href={href(claim.href)}>{claim.proposition}</a>
            </div>

            <div slot="details" class="claim-details">
              {claim.raw?.boundary ? (
                <div>
                  <span>Boundary</span>
                  <p>{claim.raw.boundary}</p>
                </div>
              ) : (
                <p class="muted">No separate Claim boundary recorded.</p>
              )}
              {claim.decisionRole && (
                <div>
                  <span>Decision role</span>
                  <p>{claim.decisionRole}</p>
                </div>
              )}
            </div>

            <div slot="meta" class="claim-meta">
              <div class="relation-metrics">
                <span><b>{claim.supportingCount}</b> support</span>
                <span class="pressure"><b>{claim.contradictingCount}</b> pressure</span>
                <span><b>{claim.directionCount}</b> Directions</span>
              </div>
              {claim.directionIds.length > 0 && (
                <div class="direction-line">
                  <span>Direction context</span>
                  <p>{claim.directionIds.slice(0,2).map(directionTitle).join(' · ')}{claim.directionIds.length > 2 ? ' …' : ''}</p>
                </div>
              )}
              {claim.capabilityIds.length > 0 && (
                <span class="cap-count">{claim.capabilityIds.length} linked capabilit{claim.capabilityIds.length === 1 ? 'y' : 'ies'}</span>
              )}
            </div>

            <div slot="actions" class="row-actions">
              <a href={href(`/evidence?claim=${encodeURIComponent(claim.id)}&relation=supporting`)}>Support</a>
              {claim.contradictingCount > 0 && <a href={href(`/evidence?claim=${encodeURIComponent(claim.id)}&relation=pressure`)}>Pressure</a>}
              <a href={href(`/papers?claim=${encodeURIComponent(claim.id)}`)}>Papers</a>
            </div>
          </DenseObjectRow>
        </div>
      ))}
    </section>
  </div>

  <style>
    .compact-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:24px}.compact-hero>div:first-child{max-width:72rem}.compact-hero h1{margin:0;font-size:clamp(1.65rem,2.5vw,2.25rem);letter-spacing:-.045em}.compact-hero p:not(.eyebrow){margin:.55rem 0 0;max-width:82ch;color:var(--text-muted);line-height:1.55}
    .summary-chips{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:6px;min-width:19rem}.summary-chips span{padding:5px 8px;border-radius:999px;background:#eef6fb;color:#365f7c;font-size:9px;font-weight:850;white-space:nowrap}
    .dense-list{margin-top:12px;border:1px solid var(--line);border-radius:var(--radius-md);overflow:hidden;background:var(--surface);box-shadow:var(--shadow-1)}

    .claim-main,.claim-details,.claim-meta{display:grid;gap:6px;min-width:0}.topline{display:flex;gap:5px;align-items:center;flex-wrap:wrap}.topline span,.topline b,.topline em{padding:3px 6px;border-radius:999px;font-size:.54rem;font-style:normal;font-weight:900;letter-spacing:.04em}.topline span{background:#eef6fb;color:#315f80}.topline b{background:#eef4f8;color:#587185}.topline em{background:#f3f0fb;color:#60558a}
    .title{color:#1d405a;font-size:.94rem;font-weight:850;line-height:1.42;text-decoration:none}.title:hover,.title:focus-visible{text-decoration:underline;text-underline-offset:.16em}
    .claim-details>div{display:grid;gap:3px}.claim-details span,.direction-line>span{color:#0b67b2;font-size:.56rem;font-weight:900;letter-spacing:.05em;text-transform:uppercase}.claim-details p,.direction-line p{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;margin:0;color:#536d80;font-size:.75rem;line-height:1.5}.muted{margin:0;color:#8798a5;font-size:.72rem}

    .relation-metrics{display:flex;gap:12px;flex-wrap:wrap}.relation-metrics span{color:#6a8192;font-size:.64rem}.relation-metrics b{color:#0b67b2;font-size:.88rem}.relation-metrics .pressure b{color:#a6662d}.direction-line{display:grid;gap:3px}.cap-count{color:#718797;font-size:.62rem}
    .row-actions{display:flex;gap:5px;flex-wrap:wrap}.row-actions a{padding:5px 7px;border:1px solid #d8e7f1;border-radius:6px;color:#43677f;font-size:.62rem;font-weight:800;text-decoration:none;white-space:nowrap}.row-actions a:hover{background:#eef6fb;color:#0b67b2}
    [hidden]{display:none!important}@media(max-width:850px){.compact-hero{align-items:flex-start;flex-direction:column}.summary-chips{justify-content:flex-start;min-width:0}}
  </style>
</BaseLayout>
