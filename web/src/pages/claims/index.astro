---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ExplorerToolbar from '../../components/ExplorerToolbar.astro';
import DenseResearchTable from '../../components/DenseResearchTable.astro';
import { directions } from '../../data/load-normalized';
import { buildClaimExplorerVM } from '../../view-models/builders';
import { directionTitle } from '../../view-models/helpers';

const vm = buildClaimExplorerVM();
const base = import.meta.env.BASE_URL;
const href=(path:string)=>`${base}${path.replace(/^\//,'')}`;

const statuses=[...new Set(vm.records.map((claim)=>claim.status))].sort();
const confidences=[...new Set(vm.records.map((claim)=>claim.confidence))].sort();
const roles=[...new Set(vm.records.map((claim)=>claim.decisionRole).filter((value): value is string => Boolean(value)))].sort();
const directionOptions = directions
  .filter((direction)=>vm.records.some((claim)=>claim.directionIds.includes(direction.id)))
  .map((direction)=>({value:direction.id,label:directionTitle(direction.id)}))
  .sort((a,b)=>a.label.localeCompare(b.label));

const records=vm.records.map((claim)=>({
  ...claim,
  roleClass:claim.decisionRole ?? 'NO_ROLE',
  search:[
    claim.id,
    claim.proposition,
    claim.status,
    claim.confidence,
    claim.decisionRole ?? '',
    ...claim.directionIds.map(directionTitle)
  ].join(' ')
}));
---

<BaseLayout title="Russia-Thermal — Claims" description={vm.summary}>
  <SiteHeader slot="header" />

  <div data-explorer-root>
    <section class="hero compact-hero">
      <div>
        <p class="eyebrow">Research objects · dense explorer</p>
        <h1>{vm.title}</h1>
        <p>{vm.summary}</p>
      </div>
      <div class="summary-chips">
        <span>{records.length} claims</span>
        <span>{records.filter((claim)=>claim.supportingCount>0).length} with support</span>
        <span>{records.filter((claim)=>claim.contradictingCount>0).length} pressure-tested</span>
      </div>
    </section>

    <ExplorerToolbar
      sticky
      compact
      total={records.length}
      urlFilterKeys={['capability', 'actor', 'person']}
      searchPlaceholder="Search proposition, Claim ID, role, Direction…"
      filters={[
        {
          key:'status',
          label:'Status',
          options:statuses.map((value)=>({value,label:value}))
        },
        {
          key:'confidence',
          label:'Confidence',
          options:confidences.map((value)=>({value,label:value}))
        },
        {
          key:'role',
          label:'Decision role',
          options:[
            ...roles.map((value)=>({value,label:value})),
            {value:'NO_ROLE',label:'No special role'}
          ]
        },
        {key:'direction',label:'Direction',options:directionOptions}
      ]}
    />

    <DenseResearchTable minWidth="74rem" maxHeight="calc(100vh - 13.8rem)" label="Claim research index">
      <tr slot="head">
        <th style="width:45%">Claim</th>
        <th style="width:10%">Status</th>
        <th style="width:10%">Confidence</th>
        <th style="width:15%">Decision role</th>
        <th style="width:6%">Support</th>
        <th style="width:6%">Pressure</th>
        <th style="width:8%">Directions</th>
      </tr>

      {records.map((claim)=>(
        <tr
          data-explorer-record
          data-status={claim.status}
          data-confidence={claim.confidence}
          data-role={claim.roleClass}
          data-direction={claim.directionIds.join('|')}
          data-capability={claim.capabilityIds.join('|')}
          data-actor={claim.institutionIds.join('|')}
          data-person={claim.peopleIds.join('|')}
          data-search={claim.search}
        >
          <td class="claim-cell">
            <a href={href(claim.href)}>
              <strong>{claim.proposition}</strong>
              <small>{claim.id}</small>
            </a>
          </td>
          <td><span class="state-pill">{claim.status}</span></td>
          <td><span class="confidence-pill">{claim.confidence}</span></td>
          <td>{claim.decisionRole ? <span class="role-pill">{claim.decisionRole}</span> : <span class="muted">—</span>}</td>
          <td class="number">{claim.supportingCount}</td>
          <td class="number pressure">{claim.contradictingCount}</td>
          <td>
            {claim.directionIds.length ? (
              <div class="direction-cell" title={claim.directionIds.map(directionTitle).join(' · ')}>
                <b>{claim.directionCount}</b>
                <span>{claim.directionIds.slice(0,1).map(directionTitle).join('')}</span>
              </div>
            ) : <span class="muted">0</span>}
          </td>
        </tr>
      ))}
    </DenseResearchTable>
  </div>

  <style>
    .compact-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:24px}
    .compact-hero>div:first-child{max-width:72rem}
    .compact-hero h1{margin:0;font-size:clamp(1.65rem,2.5vw,2.25rem);letter-spacing:-.045em}
    .compact-hero p:not(.eyebrow){margin:.55rem 0 0;max-width:82ch;color:var(--text-muted);line-height:1.55}
    .summary-chips{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:6px;min-width:19rem}
    .summary-chips span{padding:5px 8px;border-radius:999px;background:#eef6fb;color:#365f7c;font-size:9px;font-weight:850;white-space:nowrap}

    .claim-cell a{display:grid;gap:3px}
    .claim-cell strong{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;color:#203f57;font-size:11.5px;line-height:1.32}
    .claim-cell small{color:#718696;font-size:9px}
    .state-pill,.confidence-pill,.role-pill{display:inline-flex;padding:3px 6px;border-radius:999px;font-size:8px;font-weight:850;white-space:nowrap}
    .state-pill{background:#eef4f8;color:#47667d}.confidence-pill{background:#eef6fb;color:#315f80}.role-pill{max-width:100%;overflow:hidden;background:#f3f0fb;color:#60558a;text-overflow:ellipsis}
    .number{font-size:13px;font-weight:850;color:#0b67b2;text-align:center}.number.pressure{color:#a6662d}
    .direction-cell{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:6px}.direction-cell b{color:#0b67b2;font-size:12px}.direction-cell span{display:block;overflow:hidden;color:#668092;font-size:8px;text-overflow:ellipsis;white-space:nowrap}
    .muted{color:#8798a5;font-size:9px}
    @media(max-width:850px){.compact-hero{align-items:flex-start;flex-direction:column}.summary-chips{justify-content:flex-start;min-width:0}}
  </style>
</BaseLayout>
