---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ExplorerLinkStrip from '../../components/ExplorerLinkStrip.astro';
import InstitutionCard from '../../components/cards/InstitutionCard.astro';
import ScholarCard from '../../components/cards/ScholarCard.astro';
import DirectionCard from '../../components/cards/DirectionCard.astro';
import CapabilityDetail from '../../components/CapabilityDetail.astro';
import { buildInstitutionPageVM, institutionIds } from '../../view-models/builders';

export function getStaticPaths() {
  return institutionIds().map((id) => ({ params: { id } }));
}

const vm = buildInstitutionPageVM(Astro.params.id!);
if (!vm) throw new Error(`Unknown institution actor: ${Astro.params.id}`);
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<BaseLayout title={`Russia-Thermal — ${vm.name}`} description={vm.relevance ?? vm.name}>
  <SiteHeader slot="header" />

  <section class="detail-hero">
    <p class="eyebrow">{vm.kindLabel}</p>
    <h1>{vm.name}</h1>
    <p class="meta">{vm.country}{vm.role ? ` · ${vm.role}` : ''}</p>
    {vm.relevance && <p class="summary">{vm.relevance}</p>}
    {!vm.officialUrl && vm.parent?.officialUrl && <a class="official" href={vm.parent.officialUrl} target="_blank" rel="noopener noreferrer">Parent organization official site ↗</a>}
    {vm.officialUrl && <a class="official" href={vm.officialUrl} target="_blank" rel="noopener noreferrer">Official source ↗</a>}
    <ExplorerLinkStrip
      links={[
        { label: 'Related Claims', href: href(`/claims?actor=${encodeURIComponent(vm.id)}`) },
        { label: 'Related Papers', href: href(`/papers?actor=${encodeURIComponent(vm.id)}`) },
        { label: 'All Evidence', href: href(`/evidence?actor=${encodeURIComponent(vm.id)}`), primary: true }
      ]}
    />
  </section>

  {vm.parent && (
    <section class="page-section">
      <SectionHeader eyebrow="Hierarchy" title="Parent organization" />
      <div class="single-card"><InstitutionCard model={vm.parent} /></div>
    </section>
  )}

  {vm.children.length > 0 && (
    <section class="page-section">
      <SectionHeader eyebrow="Hierarchy" title="Labs / teams" description="Direct child actors from normalized parent relationships." />
      <div class="content-grid">{vm.children.map((model) => <InstitutionCard model={model} />)}</div>
    </section>
  )}

  {vm.people.length > 0 && (
    <section class="page-section">
      <SectionHeader eyebrow="People" title="Key people" />
      <div class="content-grid">{vm.people.map((model) => <ScholarCard model={model} />)}</div>
    </section>
  )}

  {vm.capabilities.length > 0 && (
    <section class="page-section">
      <SectionHeader eyebrow="Capability" title="Demonstrated capabilities" />
      <div class="content-grid">{vm.capabilities.map((model) => <CapabilityDetail model={model} />)}</div>
    </section>
  )}

  {vm.directions.length > 0 && (
    <section class="page-section">
      <SectionHeader eyebrow="Strategy" title="Connected directions" />
      <div class="content-grid">{vm.directions.map((model) => <DirectionCard model={model} />)}</div>
    </section>
  )}
</BaseLayout>

<style>
  .detail-hero {
    max-width: 58rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.7rem, 2.8vw, 2.5rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .meta, .summary {
    color: var(--text-muted);
  }

  .summary {
    max-width: 70ch;
  }

  .official {
    display: inline-block;
    margin-top: var(--space-3);
    font-weight: 700;
  }

  :global(.detail-hero .explorer-link-strip) { margin-top: var(--space-5); }

  .page-section {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-16);
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
  }

  .single-card {
    max-width: 30rem;
  }
</style>
