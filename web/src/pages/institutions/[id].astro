---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ExplorerLinkStrip from '../../components/ExplorerLinkStrip.astro';
import DetailHero from '../../components/detail/DetailHero.astro';
import MetricStrip from '../../components/detail/MetricStrip.astro';
import EvidencePressure from '../../components/detail/EvidencePressure.astro';
import RelationPath from '../../components/detail/RelationPath.astro';
import { buildInstitutionPageVM, institutionIds } from '../../view-models/builders';

export function getStaticPaths() {
  return institutionIds().map((id) => ({ params: { id } }));
}

const vm = buildInstitutionPageVM(Astro.params.id!);
if (!vm) throw new Error(`Unknown institution actor: ${Astro.params.id}`);

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
const primaryDirection =
  vm.directions.find((item) => item.lane.label === 'Strategic Candidate') ??
  vm.directions.find((item) => item.lane.label === 'Reserve') ??
  vm.directions[0];
---

<BaseLayout title={`Russia-Thermal — ${vm.name}`} description={vm.relevance ?? vm.name}>
  <SiteHeader slot="header" />

  <DetailHero
    eyebrow={`${vm.kindLabel} detail`}
    title={vm.name}
    summary={vm.relevance}
    meta={[vm.country, ...(vm.role ? [vm.role] : []), ...(primaryDirection ? [primaryDirection.lane.label] : [])]}
  >
    <div slot="actions">
      <ExplorerLinkStrip
        links={[
          { label: 'Claims', href: href(`/claims?actor=${encodeURIComponent(vm.id)}`) },
          { label: 'Papers', href: href(`/papers?actor=${encodeURIComponent(vm.id)}`) },
          { label: 'All Evidence', href: href(`/evidence?actor=${encodeURIComponent(vm.id)}`), primary: true }
        ]}
      />
      {vm.officialUrl && <a class="official-link" href={vm.officialUrl} target="_blank" rel="noopener noreferrer">Official source ↗</a>}
    </div>
    <MetricStrip
      slot="aside"
      items={[
        { label: 'Capabilities', value: vm.capabilities.length },
        { label: 'Scholars', value: vm.people.length },
        { label: 'Evidence', value: vm.evidenceStats.evidenceCount },
        { label: 'Deep Reads', value: vm.evidenceStats.deepReadCount }
      ]}
    />
  </DetailHero>

  <div class="detail-stack">
    <RelationPath
      nodes={[
        { label: 'Institution', value: 1, note: vm.kindLabel },
        { label: 'Scholars', value: vm.people.length },
        { label: 'Capabilities', value: vm.capabilities.length },
        { label: 'Claims', value: vm.evidenceStats.claimCount, href: href(`/claims?actor=${encodeURIComponent(vm.id)}`) },
        { label: 'Evidence', value: vm.evidenceStats.evidenceCount, href: href(`/evidence?actor=${encodeURIComponent(vm.id)}`) },
        { label: 'Directions', value: vm.directions.length }
      ]}
    />

    <section class="split-section">
      <article class="why">
        <p class="section-kicker">Why it matters</p>
        <h2>What this institution actually contributes to the portfolio</h2>
        <p>{vm.relevance ?? 'No concise research-relevance statement is currently normalized for this actor.'}</p>
        {primaryDirection && (
          <div class="decision-line">
            <span>Current decision position</span>
            <a href={href(`/directions/${primaryDirection.id}`)}>
              <b>{primaryDirection.title}</b>
              <small>{primaryDirection.recommendation} · {primaryDirection.lane.label}</small>
            </a>
          </div>
        )}
      </article>

      <article class="hierarchy">
        <p class="section-kicker">Organization context</p>
        <h2>Where this team sits</h2>
        {vm.parent && <a class="hierarchy-row" href={href(vm.parent.href ?? `/institutions/${vm.parent.id}`)}>
          <span>Parent</span><b>{vm.parent.name}</b>
        </a>}
        {vm.children.map((child) => <a class="hierarchy-row" href={href(child.href ?? `/institutions/${child.id}`)}>
          <span>Child team</span><b>{child.name}</b>
        </a>)}
        {vm.collaborators.map((collaborator) => <a class="hierarchy-row collaborator" href={href(collaborator.href ?? `/institutions/${collaborator.id}`)}>
          <span>Collaborator</span><b>{collaborator.name}</b>
        </a>)}
        {!vm.parent && vm.children.length === 0 && vm.collaborators.length === 0 && <p class="empty">No normalized hierarchy or collaborator relation.</p>}
      </article>
    </section>

    <EvidencePressure
      russia={vm.evidenceStats.russiaSourceCount}
      comparator={vm.evidenceStats.comparatorSourceCount}
      deepReads={vm.evidenceStats.deepReadCount}
      total={vm.evidenceStats.evidenceCount}
      papers={vm.evidenceStats.paperCount}
      patents={vm.evidenceStats.patentCount}
      baseline={primaryDirection?.collaborationFocus ? primaryDirection.problem : undefined}
      residual={primaryDirection?.residualDifferentiation}
    />

    {vm.people.length > 0 && <section class="panel">
      <header class="panel-head">
        <div><p class="section-kicker">People</p><h2>Key scholars linked to demonstrated capabilities</h2></div>
        <span>{vm.people.length} normalized people</span>
      </header>
      <div class="people-list">
        {vm.people.map((person) => <a href={href(person.href ?? `/scholars/${person.id}`)}>
          <div><b>{person.name}</b><span>{person.role ?? person.affiliation}</span></div>
          <p>{person.relevance}</p>
          <strong>Profile →</strong>
        </a>)}
      </div>
    </section>}

    {vm.capabilities.length > 0 && <section class="panel">
      <header class="panel-head">
        <div><p class="section-kicker">Capabilities</p><h2>What the evidence says this institution can actually do</h2></div>
        <span>{vm.capabilities.length} canonical capabilities</span>
      </header>
      <div class="capability-list">
        {vm.capabilities.map((capability) => <article>
          <div class="cap-main">
            <a href={href(`/capabilities/${capability.id}`)}>{capability.statement}</a>
            {capability.technicalScope.length > 0 && <p>{capability.technicalScope.join(' · ')}</p>}
          </div>
          <dl>
            <div><dt>Maturity</dt><dd>{capability.maturity}</dd></div>
            <div><dt>Evidence</dt><dd>{capability.evidenceConfidence}</dd></div>
            <div><dt>Target fit</dt><dd>{capability.targetFit}</dd></div>
          </dl>
          {capability.transferBoundary && <p class="boundary">{capability.transferBoundary}</p>}
        </article>)}
      </div>
    </section>}

    {vm.claims.length > 0 && <section class="panel">
      <header class="panel-head">
        <div><p class="section-kicker">Claims</p><h2>Propositions connecting capability to strategic judgment</h2></div>
        <a href={href(`/claims?actor=${encodeURIComponent(vm.id)}`)}>All claims →</a>
      </header>
      <div class="claim-list">
        {vm.claims.slice(0, 8).map((claim) => <a href={href(claim.href)}>
          <div><span>{claim.status} · {claim.confidence}</span><b>{claim.proposition}</b></div>
          <strong>Open →</strong>
        </a>)}
      </div>
    </section>}

    {vm.evidence.length > 0 && <section class="panel">
      <header class="panel-head">
        <div><p class="section-kicker">Evidence</p><h2>Representative sources behind the institution profile</h2></div>
        <a href={href(`/evidence?actor=${encodeURIComponent(vm.id)}`)}>All evidence →</a>
      </header>
      <div class="evidence-list">
        {vm.evidence.slice(0, 8).map((item) => <article>
          <div class="source-meta">
            <span>{item.year ?? 'n.d.'}</span>
            <span>{item.sourceType}</span>
            {item.countryContext && <span>{item.countryContext}</span>}
            {item.deepReadLevel && <span class="deep">{item.deepReadLevel}</span>}
          </div>
          <div class="source-copy">
            <h3>{item.title}</h3>
            {item.findings[0] && <p>{item.findings[0]}</p>}
          </div>
          <div class="source-actions">
            {item.id.startsWith('PAPER-') && <a href={href(`/papers/${item.id}`)}>Deep detail →</a>}
            {item.id.startsWith('PATENT-') && <a href={href(`/patents/${item.id}`)}>Patent detail →</a>}
            <a href={item.primaryUrl} target="_blank" rel="noopener noreferrer">Source ↗</a>
          </div>
        </article>)}
      </div>
    </section>}

    {vm.directions.length > 0 && <section class="panel">
      <header class="panel-head">
        <div><p class="section-kicker">Strategy</p><h2>Directions this institution can influence</h2></div>
      </header>
      <div class="direction-list">
        {vm.directions.map((direction) => <a href={href(`/directions/${direction.id}`)}>
          <div><span>{direction.lane.label}</span><b>{direction.title}</b></div>
          <p>{direction.residualDifferentiation ?? direction.collaborationFocus ?? direction.problem}</p>
          <strong>{direction.recommendation} →</strong>
        </a>)}
      </div>
    </section>}
  </div>
</BaseLayout>

<style>
  .official-link{display:inline-block;margin-top:.7rem;color:var(--accent-vivid);font-size:.72rem;font-weight:800;text-decoration:none}
  .detail-stack{display:grid;gap:1rem;margin-top:1rem}
  .split-section{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(18rem,.65fr);gap:1rem}
  .why,.hierarchy,.panel{border:1px solid var(--line);border-radius:1rem;background:var(--surface)}
  .why,.hierarchy{padding:1.2rem}
  .section-kicker{margin:0;color:var(--accent-vivid);font-size:.62rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}
  h2{margin:.3rem 0 0;font-size:1.15rem;line-height:1.25;letter-spacing:-.03em}
  .why>p:last-of-type{margin:.7rem 0 0;color:var(--text-muted);font-size:.84rem;line-height:1.7}
  .decision-line{display:grid;grid-template-columns:9rem 1fr;gap:.8rem;align-items:start;margin-top:1rem;padding-top:1rem;border-top:1px solid var(--line)}
  .decision-line>span{font-size:.64rem;color:#718697;text-transform:uppercase;font-weight:800}
  .decision-line a{display:grid;gap:.18rem;text-decoration:none}
  .decision-line b{font-size:.82rem;color:#153f5e}
  .decision-line small{font-size:.66rem;color:#6e8597}
  .hierarchy-row{display:grid;grid-template-columns:5.5rem 1fr;gap:.7rem;padding:.72rem 0;border-top:1px solid var(--line);text-decoration:none}
  .hierarchy h2+.hierarchy-row{margin-top:.7rem}
  .hierarchy-row span{font-size:.62rem;color:#74899a;text-transform:uppercase}
  .hierarchy-row b{font-size:.76rem;line-height:1.35}
  .hierarchy-row.collaborator b{color:var(--positive)}
  .empty{color:#7b8e9d;font-size:.75rem}
  .panel{overflow:hidden}
  .panel-head{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding:1rem 1.1rem;border-bottom:1px solid var(--line);background:#f9fcfe}
  .panel-head>span,.panel-head>a{font-size:.68rem;color:#6d8394;font-weight:750;text-decoration:none}
  .people-list a,.claim-list a,.direction-list a{display:grid;align-items:start;gap:1rem;padding:.9rem 1.1rem;border-bottom:1px solid #e8eff4;text-decoration:none}
  .people-list a{grid-template-columns:minmax(12rem,.55fr) minmax(0,1.25fr) auto}
  .people-list div,.claim-list div,.direction-list div{display:grid;gap:.15rem}
  .people-list b,.claim-list b,.direction-list b{font-size:.78rem;line-height:1.45}
  .people-list span,.claim-list span,.direction-list span{font-size:.61rem;color:#678195;text-transform:uppercase}
  .people-list p,.direction-list p{margin:0;color:#5e7689;font-size:.72rem;line-height:1.55}
  .people-list strong,.claim-list strong,.direction-list strong{font-size:.68rem;color:#0b67b2;white-space:nowrap}
  .capability-list article{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(20rem,.8fr);gap:.8rem 1.1rem;padding:1rem 1.1rem;border-bottom:1px solid #e8eff4}
  .cap-main a{font-size:.82rem;font-weight:850;line-height:1.45;text-decoration:none;color:#153f5e}
  .cap-main p{margin:.4rem 0 0;color:#6a8192;font-size:.67rem}
  dl{display:grid;grid-template-columns:repeat(3,1fr);gap:.4rem;margin:0}
  dt{font-size:.56rem;text-transform:uppercase;color:#75899a}
  dd{margin:.08rem 0 0;font-size:.68rem;font-weight:800;color:#344f63}
  .boundary{grid-column:1/-1;margin:0;padding-top:.65rem;border-top:1px dashed #dde8ef;color:#748797;font-size:.68rem;line-height:1.55}
  .claim-list a{grid-template-columns:minmax(0,1fr) auto}
  .evidence-list article{display:grid;grid-template-columns:10rem minmax(0,1fr) auto;gap:1rem;padding:.95rem 1.1rem;border-bottom:1px solid #e8eff4}
  .source-meta{display:flex;align-content:start;gap:.3rem;flex-wrap:wrap}
  .source-meta span{height:max-content;padding:.24rem .36rem;border-radius:.35rem;background:#f1f6f9;color:#667f91;font-size:.58rem;font-weight:800}
  .source-meta .deep{background:#e8f4ef;color:var(--positive)}
  .source-copy h3{margin:0;font-size:.79rem;line-height:1.45}
  .source-copy p{margin:.35rem 0 0;color:#617a8d;font-size:.69rem;line-height:1.5}
  .source-actions{display:grid;gap:.35rem;justify-items:end}
  .source-actions a{font-size:.66rem;color:#0b67b2;font-weight:800;text-decoration:none;white-space:nowrap}
  .direction-list a{grid-template-columns:minmax(12rem,.55fr) minmax(0,1fr) auto}
  @media(max-width:820px){
    .split-section{grid-template-columns:1fr}
    .people-list a,.direction-list a,.evidence-list article,.capability-list article{grid-template-columns:1fr}
    .source-actions{justify-items:start}
    dl{grid-template-columns:repeat(3,minmax(0,1fr))}
  }
</style>
