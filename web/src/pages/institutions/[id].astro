---
import InstitutionVisualHero from '../../components/InstitutionVisualHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ExplorerLinkStrip from '../../components/ExplorerLinkStrip.astro';
import DetailHero from '../../components/detail/DetailHero.astro';
import MetricStrip from '../../components/detail/MetricStrip.astro';
import EvidencePressure from '../../components/detail/EvidencePressure.astro';
import RelationPath from '../../components/detail/RelationPath.astro';
import { buildInstitutionPageVM, institutionIds } from '../../view-models/builders';
import selectedWorksJson from '../../../data/generated/representativeWorks.json';
import { actors } from '../../data/load-normalized';

export function getStaticPaths() {
  return institutionIds().map((id) => ({ params: { id } }));
}

const vm = buildInstitutionPageVM(Astro.params.id!);
if (!vm) throw new Error(`Unknown institution actor: ${Astro.params.id}`);

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
const relevantTeams = new Set([vm.id]);
const actorById = new Map(actors.map(actor => [actor.id,actor]));
for (const actor of actors) {
  let current = actor;
  const visited = new Set<string>();
  while (current.parentId && !visited.has(current.id)) {
    visited.add(current.id);
    if (current.parentId === vm.id) {
      relevantTeams.add(actor.id);
      break;
    }
    const parent = actorById.get(current.parentId);
    if (!parent || parent.type === 'PERSON') break;
    current = parent;
  }
}
const reviewedTeams = [...new Set((selectedWorksJson.records as Array<{teamId:string}>)
  .map(record => record.teamId)
  .filter(id => relevantTeams.has(id)))];
const primaryDirection =
  vm.directions.find((item) => item.lane.label === 'Strategic Candidate') ??
  vm.directions.find((item) => item.lane.label === 'Reserve') ??
  vm.directions[0];
const isKutateladze = vm.id === 'ACT-KUTATELADZE';
---

<BaseLayout title={`Russia-Thermal — ${vm.name}`} description={vm.atlasProfile?.leadershipSummary ?? vm.relevance ?? vm.name} immersive>
  <SiteHeader slot="header" />

  <InstitutionVisualHero name={vm.name} id={vm.id} country={vm.country} summary={vm.atlasProfile?.leadershipSummary ?? vm.relevance} capabilityCount={vm.capabilities.length} peopleCount={vm.people.length} paperCount={vm.outputSnapshot.paperCount} officialUrl={vm.officialUrl} />

  {isKutateladze && <section class="kut-editorial" aria-labelledby="kut-research-heading">
    <div class="kut-editorial-top">
      <div class="kut-lead">
        <p class="kut-kicker">RESEARCH VALUE / EXPERIMENTAL MECHANISMS</p>
        <h2 id="kut-research-heading">重点不是散热器件本身，而是<strong>识别局部干涸如何演化为不可逆失效</strong></h2>
        <p>代表性公开论文研究介电液体在沸腾临界区的局部干斑演化，利用红外与光学方法区分实验状态。对手机热管理的潜在价值在于更精确的失效验证方法；这仍然只是需要检验的合作研究假设。</p>
      </div>
      <div class="kut-lane">
        <span>RESEARCH POSITION</span><strong>优先：数据与方法可行性</strong>
        <p>尚无手机密闭 UTVC 级性能优势证据。论文研究条件不能直接外推到终端产品。</p>
        <a href={href('/partners')}>合作研究判断 ↗</a>
      </div>
    </div>
    <div class="kut-methods">
      <article><span>01 / 观测</span><h3>IR / Optical diagnostics</h3><p>公开研究在特定沸腾实验条件下记录局部干斑及临界状态。</p></article>
      <article><span>02 / 研究假设</span><h3>Failure-state labeling</h3><p>评估可重复的状态标签，能否为终端热失效验证增加有效信息。</p></article>
      <article><span>03 / 证明条件</span><h3>Phone-relevant validation</h3><p>需要原始数据、标注可重复性和相对于现有方案的实证增量。</p></article>
    </div>
    <div class="kut-research-path">
      <div class="kut-primary-source">
        <span>REPRESENTATIVE EVIDENCE · 2026</span>
        <a href="https://doi.org/10.1016/j.ijheatmasstransfer.2025.127855" target="_blank" rel="noopener noreferrer"><i>Investigation of heat transfer, critical heat flux and dry spots dynamics during boiling of dielectric fluids HFE-7100 and Novec 649</i> ↗</a>
        <small>Surtaev et al. · International Journal of Heat and Mass Transfer</small>
      </div>
      <nav class="kut-jumps" aria-label="本机构研究档案的关键内容">
        {vm.people.length > 0 && <a href="#institution-people">研究人员 <b>{vm.people.length}</b> ↘</a>}
        {vm.capabilities.length > 0 && <a href="#institution-capabilities">技术能力 <b>{vm.capabilities.length}</b> ↘</a>}
        {vm.evidence.length > 0 && <a href="#institution-evidence">原始证据 <b>{vm.evidenceStats.evidenceCount}</b> ↘</a>}
        <a href={href('/smartphone-transfer')}>手机迁移边界 ↗</a>
      </nav>
    </div>
  </section>}

  <div class="legacy-evidence">
  {!isKutateladze && <DetailHero
    eyebrow={`${vm.kindLabel} detail`}
    title={vm.name}
    summary={vm.atlasProfile?.leadershipSummary ?? vm.relevance}
    meta={[vm.country, ...(vm.researchClassification ? [vm.researchClassification] : []), ...(vm.researchDepth ? [vm.researchDepth + ' research'] : []), ...(vm.role ? [vm.role] : []), ...(primaryDirection ? [primaryDirection.lane.label] : [])]}
  >
    <div slot="actions">
      <ExplorerLinkStrip
        links={[
          { label: 'Claims', href: href(`/claims?actor=${encodeURIComponent(vm.id)}`) },
          { label: 'Papers', href: href(`/papers?actor=${encodeURIComponent(vm.id)}`) },
          { label: 'All Evidence', href: href(`/evidence?actor=${encodeURIComponent(vm.id)}`), primary: true }
        ]}
      />
      {vm.officialUrl && <a class="official-link" href={vm.officialUrl} target="_blank" rel="noopener noreferrer">Official source ↗</a>}
    </div>
    <MetricStrip
      slot="aside"
      items={[
        { label: 'Capabilities', value: vm.capabilities.length },
        { label: 'Linked researchers', value: vm.people.length },
        { label: 'Linked corpus papers', value: vm.outputSnapshot.paperCount },
        { label: 'Patents', value: vm.outputSnapshot.patentCount }
      ]}
    />
  </DetailHero>}

  <div class="detail-stack">
    {!isKutateladze && <RelationPath
      nodes={[
        { label: 'Institution', value: 1, note: vm.kindLabel },
        { label: 'Scholars', value: vm.people.length },
        { label: 'Capabilities', value: vm.capabilities.length },
        { label: 'Claims', value: vm.evidenceStats.claimCount, href: href(`/claims?actor=${encodeURIComponent(vm.id)}`) },
        { label: 'Evidence', value: vm.evidenceStats.evidenceCount, href: href(`/evidence?actor=${encodeURIComponent(vm.id)}`) },
        { label: 'Directions', value: vm.directions.length }
      ]}
    />}

    {reviewedTeams.length > 0 && <aside class="works-link">
      <strong>机构代表成果已收录</strong>
      <p>此入口仅包含人工核查的代表论文，不是该机构全部发文；论文署名不自动证明现任人员归属。</p>
      {reviewedTeams.map(team => <a href={href(`/representative-works#${team}`)}>查看 {team} 的代表论文与研究边界 →</a>)}
    </aside>}

    <section class="split-section">
      <article class="why">
        <p class="section-kicker">Why it matters</p>
        <h2>What this institution actually contributes to the portfolio</h2>
        <p>{vm.atlasProfile?.leadershipSummary ?? vm.relevance ?? 'A concise project-specific relevance summary has not yet been added.'}</p>
        {primaryDirection && (
          <div class="decision-line">
            <span>Current decision position</span>
            <a href={href(`/directions/${primaryDirection.id}`)}>
              <b>{primaryDirection.title}</b>
              <small>{primaryDirection.recommendation} · {primaryDirection.lane.label}</small>
            </a>
          </div>
        )}
      </article>

      <article class="hierarchy">
        <p class="section-kicker">Organization context</p>
        <h2>Where this team sits</h2>
        {vm.parent && <a class="hierarchy-row" href={href(vm.parent.href ?? `/institutions/${vm.parent.id}`)}>
          <span>Parent</span><b>{vm.parent.name}</b>
        </a>}
        {vm.children.map((child) => <a class="hierarchy-row" href={href(child.href ?? `/institutions/${child.id}`)}>
          <span>Child team</span><b>{child.name}</b>
        </a>)}
        {vm.collaborators.map((collaborator) => <a class="hierarchy-row collaborator" href={href(collaborator.href ?? `/institutions/${collaborator.id}`)}>
          <span>Collaborator</span><b>{collaborator.name}</b>
        </a>)}
        {!vm.parent && vm.children.length === 0 && vm.collaborators.length === 0 && <p class="empty">No parent, child-team or collaborator relationship is currently recorded.</p>}
      </article>
    </section>

    {vm.atlasProfile && <section class="atlas-grid">
      <article class="atlas-card output-card">
        <p class="section-kicker">Recovered output</p>
        <h2>{vm.outputSnapshot.label}</h2>
        <div class="output-metrics">
          <div><b>{vm.outputSnapshot.paperCount}</b><span>relevant papers</span></div>
          <div><b>{vm.outputSnapshot.patentCount}</b><span>relevant patents</span></div>
          <div><b>{vm.outputSnapshot.officialCount}</b><span>official/context sources</span></div>
          <div><b>{vm.outputSnapshot.firstYear && vm.outputSnapshot.latestYear ? `${vm.outputSnapshot.firstYear}–${vm.outputSnapshot.latestYear}` : '—'}</b><span>recovered activity window</span></div>
        </div>
        <p>{vm.atlasProfile.outputInterpretation}</p>
      </article>

      <article class="atlas-card">
        <p class="section-kicker">Collaboration</p>
        <h2>Public collaboration signals</h2>
        <p>{vm.atlasProfile.collaborationSummary}</p>
        {vm.atlasProfile.collaborationEvidence.length > 0 && <div class="profile-sources">
          {vm.atlasProfile.collaborationEvidence.map((item) => <a href={item.primaryUrl} target="_blank" rel="noopener noreferrer">{item.title} ↗</a>)}
        </div>}
      </article>

      <article class="atlas-card">
        <p class="section-kicker">Influence</p>
        <h2>Institution context</h2>
        <p>{vm.atlasProfile.influenceSummary}</p>
        {vm.atlasProfile.influenceEvidence.length > 0 && <div class="profile-sources">
          {vm.atlasProfile.influenceEvidence.map((item) => <a href={item.primaryUrl} target="_blank" rel="noopener noreferrer">{item.title} ↗</a>)}
        </div>}
      </article>

      <article class="atlas-card gap-card">
        <p class="section-kicker">Public gaps</p>
        <h2>What is still not evidenced</h2>
        <ul>{vm.atlasProfile.publicGaps.map((gap) => <li>{gap}</li>)}</ul>
      </article>
    </section>}

    <EvidencePressure
      russia={vm.evidenceStats.russiaSourceCount}
      comparator={vm.evidenceStats.comparatorSourceCount}
      deepReads={vm.evidenceStats.deepReadCount}
      total={vm.evidenceStats.evidenceCount}
      papers={vm.evidenceStats.paperCount}
      patents={vm.evidenceStats.patentCount}
      baseline={primaryDirection?.collaborationFocus ? primaryDirection.problem : undefined}
      residual={primaryDirection?.residualDifferentiation}
    />

    {vm.people.length > 0 && <section id="institution-people" class="panel">
      <header class="panel-head">
        <div><p class="section-kicker">People</p><h2>Associated researchers and recorded affiliations (not all current team members)</h2></div>
        <span>{vm.people.length} linked people</span>
      </header>
      <div class="people-list">
        {vm.people.map((person) => <a href={href(person.href ?? `/scholars/${person.id}`)}>
          <div><b>{person.name}</b><span>{person.role ?? person.affiliation}</span></div>
          <p>{person.relevance}</p>
          <strong>Profile →</strong>
        </a>)}
      </div>
    </section>}

    {vm.capabilities.length > 0 && <section id="institution-capabilities" class="panel">
      <header class="panel-head">
        <div><p class="section-kicker">Capabilities</p><h2>What the evidence says this institution can actually do</h2></div>
        <span>{vm.capabilities.length} documented capabilities</span>
      </header>
      <div class="capability-list">
        {vm.capabilities.map((capability) => <article>
          <div class="cap-main">
            <a href={href(`/capabilities/${capability.id}`)}>{capability.statement}</a>
            {capability.technicalScope.length > 0 && <p>{capability.technicalScope.join(' · ')}</p>}
          </div>
          <dl>
            <div><dt>Maturity</dt><dd>{capability.maturity}</dd></div>
            <div><dt>Evidence</dt><dd>{capability.evidenceConfidence}</dd></div>
            <div><dt>Target fit</dt><dd>{capability.targetFit}</dd></div>
          </dl>
          {capability.platformTransfer.length > 0 && <div class="transfer-row">
            <span>Platform transfer</span>
            <div>{capability.platformTransfer.map((item) => <b>{item.platform}: {item.level}</b>)}</div>
          </div>}
          {capability.transferBoundary && <p class="boundary">{capability.transferBoundary}</p>}
        </article>)}
      </div>
    </section>}

    {vm.claims.length > 0 && <section id="institution-claims" class="panel">
      <header class="panel-head">
        <div><p class="section-kicker">Claims</p><h2>Propositions connecting capability to strategic judgment</h2></div>
        <a href={href(`/claims?actor=${encodeURIComponent(vm.id)}`)}>All claims →</a>
      </header>
      <div class="claim-list">
        {vm.claims.slice(0, 8).map((claim) => <a href={href(claim.href)}>
          <div><span>{claim.status} · {claim.confidence}</span><b>{claim.proposition}</b></div>
          <strong>Open detail →</strong>
        </a>)}
      </div>
    </section>}

    {vm.evidence.length > 0 && <section id="institution-evidence" class="panel">
      <header class="panel-head">
        <div><p class="section-kicker">Evidence</p><h2>Representative sources behind the institution profile</h2></div>
        <a href={href(`/evidence?actor=${encodeURIComponent(vm.id)}`)}>All evidence →</a>
      </header>
      <div class="evidence-list">
        {vm.evidence.slice(0, 8).map((item) => <article>
          <div class="source-meta">
            <span>{item.year ?? 'n.d.'}</span>
            <span>{item.sourceType}</span>
            {item.countryContext && <span>{item.countryContext}</span>}
            {item.deepReadLevel && <span class="deep">{item.deepReadLevel}</span>}
          </div>
          <div class="source-copy">
            <h3>{item.title}</h3>
            {item.findings[0] && <p>{item.findings[0]}</p>}
          </div>
          <div class="source-actions">
            {item.id.startsWith('PAPER-') && <a href={href(`/papers/${item.id}`)}>Open detail →</a>}
            {item.id.startsWith('PATENT-') && <a href={href(`/patents/${item.id}`)}>Patent detail →</a>}
            <a href={item.primaryUrl} target="_blank" rel="noopener noreferrer">Source ↗</a>
          </div>
        </article>)}
      </div>
    </section>}

    {vm.directions.length > 0 && <section id="institution-directions" class="panel">
      <header class="panel-head">
        <div><p class="section-kicker">Strategy</p><h2>Directions this institution can influence</h2></div>
      </header>
      <div class="direction-list">
        {vm.directions.map((direction) => <a href={href(`/directions/${direction.id}`)}>
          <div><span>{direction.lane.label}</span><b>{direction.title}</b></div>
          <p>{direction.residualDifferentiation ?? direction.collaborationFocus ?? direction.problem}</p>
          <strong>{direction.recommendation} →</strong>
        </a>)}
      </div>
    </section>}
  </div>
  </div>
</BaseLayout>

<style>
  .kut-editorial{margin:0 10px 24px;border:1px solid #276486;border-radius:17px;overflow:hidden;background:linear-gradient(135deg,#082d4d,#051f38);color:#eaf8ff;box-shadow:0 14px 28px #001d3470}
  .kut-editorial-top{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(255px,.65fr);gap:25px;padding:clamp(24px,3.5vw,42px)}
  .kut-kicker{font-size:11px;color:#82dcf4;font-weight:850;letter-spacing:.13em;margin:0}
  .kut-lead h2{font-size:clamp(24px,2.65vw,35px);line-height:1.38;color:#f7fdff;margin:15px 0 15px;font-weight:760;letter-spacing:-.025em}
  .kut-lead h2 strong{color:#80e5ff;font-weight:850}
  .kut-lead>p:last-child{max-width:800px;color:#d5ebf5;line-height:1.85;font-size:15px;margin:0}
  .kut-lane{display:grid;align-content:center;gap:11px;padding:24px;border-radius:11px;border:1px solid #3a829f;background:#0d4568}
  .kut-lane span,.kut-primary-source>span{color:#91e7fd;font-size:11px;letter-spacing:.1em;font-weight:800}
  .kut-lane strong{color:#fff;font-size:21px;line-height:1.4}
  .kut-lane p{color:#cce5f3;font-size:13px;line-height:1.8;margin:0}
  .kut-lane a{font-size:13px;color:#a0ecff;font-weight:800}
  .kut-methods{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:#367d9c;border-block:1px solid #367d9c}
  .kut-methods article{padding:23px 27px;background:#0b3554}
  .kut-methods span{color:#8edbf5;font-size:12px;font-weight:800}
  .kut-methods h3{color:white;font-size:17px;line-height:1.4;margin:10px 0}
  .kut-methods p{color:#d0e5f0;font-size:13px;line-height:1.75;margin:0}
  .kut-research-path{display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:center;padding:25px 39px}
  .kut-primary-source{display:grid;gap:8px}
  .kut-primary-source>a{color:#f0fbff;font-size:14px;line-height:1.65;font-weight:700;text-decoration:none}
  .kut-primary-source>a:hover{text-decoration:underline}
  .kut-primary-source small{color:#b2d6e9;font-size:12px}
  .kut-jumps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
  .kut-jumps a{display:flex;justify-content:space-between;align-items:center;gap:9px;text-decoration:none;color:#c9effd;font-size:13px;font-weight:800;border:1px solid #3b7999;border-radius:8px;padding:12px 13px}
  .kut-jumps a:hover{background:#125779;color:white}
  .kut-jumps b{color:white;font-size:12px}
  .kut-editorial a:focus-visible{outline:3px solid #b4f6ff;outline-offset:3px}
  #institution-people,#institution-capabilities,#institution-evidence,#institution-claims,#institution-directions{scroll-margin-top:95px}
  @media(max-width:880px){.kut-editorial-top,.kut-research-path{grid-template-columns:1fr}.kut-methods{grid-template-columns:1fr}.kut-methods article{padding:20px 24px}.kut-research-path{padding:24px}}
  @media(max-width:530px){.kut-editorial{margin-inline:0}.kut-editorial-top{padding:23px}.kut-jumps{grid-template-columns:1fr}}
  .legacy-evidence{background:linear-gradient(135deg,#edf6fc,#f7fbff);border-radius:18px;padding:20px;margin:15px 0 45px;color:#17364d}
  .official-link{display:inline-block;margin-top:.7rem;color:var(--accent-vivid);font-size:.72rem;font-weight:800;text-decoration:none}
  .detail-stack{display:grid;gap:1rem;margin-top:1rem}
  .atlas-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .atlas-card{border:1px solid var(--line);border-radius:1rem;background:var(--surface);padding:1.15rem}
  .atlas-card h2{margin:.3rem 0 .7rem}
  .atlas-card>p:not(.section-kicker){margin:.55rem 0 0;color:#3f596d;font-size:.84rem;line-height:1.65}
  .output-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.5rem;margin:.8rem 0}
  .output-metrics>div{display:grid;gap:.2rem;padding:.65rem;border:1px solid #deebf3;border-radius:.7rem;background:#f8fbfd}
  .output-metrics b{font-size:1.05rem;color:#174b70}
  .output-metrics span{font-size:.7rem;color:#657d90;line-height:1.35}
  .profile-sources{display:grid;gap:.35rem;margin-top:.8rem;padding-top:.7rem;border-top:1px solid #e4edf3}
  .profile-sources a{width:fit-content;color:#0b67b2;font-size:.74rem;font-weight:750;text-decoration:none}
  .profile-sources a:hover,.profile-sources a:focus-visible{text-decoration:underline;text-underline-offset:.16em}
  .gap-card ul{margin:.65rem 0 0;padding-left:1.1rem;color:#3f596d;font-size:.82rem;line-height:1.65}
  .split-section{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(18rem,.65fr);gap:1rem}
  .why,.hierarchy,.panel{border:1px solid var(--line);border-radius:1rem;background:var(--surface)}
  .why,.hierarchy{padding:1.2rem}
  .section-kicker{margin:0;color:var(--accent-vivid);font-size:.62rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}
  h2{margin:.3rem 0 0;font-size:1.15rem;line-height:1.25;letter-spacing:-.03em}
  .why>p:last-of-type{margin:.7rem 0 0;color:var(--text-muted);font-size:.84rem;line-height:1.7}
  .decision-line{display:grid;grid-template-columns:9rem 1fr;gap:.8rem;align-items:start;margin-top:1rem;padding-top:1rem;border-top:1px solid var(--line)}
  .decision-line>span{font-size:.64rem;color:#718697;text-transform:uppercase;font-weight:800}
  .decision-line a{display:grid;gap:.18rem;text-decoration:none}
  .decision-line b{font-size:.82rem;color:#153f5e}
  .decision-line small{font-size:.66rem;color:#6e8597}
  .hierarchy-row{display:grid;grid-template-columns:5.5rem 1fr;gap:.7rem;padding:.72rem 0;border-top:1px solid var(--line);text-decoration:none}
  .hierarchy h2+.hierarchy-row{margin-top:.7rem}
  .hierarchy-row span{font-size:.62rem;color:#74899a;text-transform:uppercase}
  .hierarchy-row b{font-size:.76rem;line-height:1.35}
  .hierarchy-row.collaborator b{color:var(--positive)}
  .empty{color:#7b8e9d;font-size:.75rem}
  .panel{overflow:hidden}
  .panel-head{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding:1rem 1.1rem;border-bottom:1px solid var(--line);background:#f9fcfe}
  .panel-head>span,.panel-head>a{font-size:.68rem;color:#6d8394;font-weight:750;text-decoration:none}
  .people-list a,.claim-list a,.direction-list a{display:grid;align-items:start;gap:1rem;padding:.9rem 1.1rem;border-bottom:1px solid #e8eff4;text-decoration:none}
  .people-list a{grid-template-columns:minmax(12rem,.55fr) minmax(0,1.25fr) auto}
  .people-list div,.claim-list div,.direction-list div{display:grid;gap:.15rem}
