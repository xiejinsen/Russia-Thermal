---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ExplorerToolbar from '../components/ExplorerToolbar.astro';
import DenseObjectRow from '../components/DenseObjectRow.astro';
import { actors, capabilities, directions } from '../data/load-normalized';
import { buildCapabilitiesCollectionVM } from '../view-models/builders';
import { directionTitle, humanize } from '../view-models/helpers';

const vm = buildCapabilitiesCollectionVM();
const actorById = new Map(actors.map((actor) => [actor.id, actor]));
const capabilityById = new Map(capabilities.map((capability) => [capability.id, capability]));
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;

const records = vm.records.map((model) => {
  const capability = capabilityById.get(model.id);
  const owner = capability ? actorById.get(capability.actorId) : undefined;
  const people = capability
    ? capability.keyPeopleIds.map((id) => actorById.get(id)).filter((item): item is NonNullable<typeof item> => Boolean(item))
    : [];
  const linkedDirections = capability
    ? directions.filter((direction) => direction.capabilityIds.includes(capability.id))
    : [];

  return {
    model,
    capability,
    owner,
    people,
    directionIds: linkedDirections.map((direction) => direction.id),
    linkedDirections,
    search: [
      model.id,
      model.statement,
      model.strategicUse ?? '',
      model.transferBoundary ?? '',
      owner?.name ?? '',
      ...people.map((person) => person.name),
      ...model.technicalScope,
      ...linkedDirections.map((direction) => directionTitle(direction.id))
    ].join(' ')
  };
}).sort((a, b) =>
  (a.owner?.country ?? '').localeCompare(b.owner?.country ?? '') ||
  (a.owner?.name ?? '').localeCompare(b.owner?.name ?? '') ||
  a.model.id.localeCompare(b.model.id)
);

const countryValues = [...new Set(records.map((record) => record.owner?.country).filter((value): value is string => Boolean(value)))].sort();
const ownerValues = [...new Map(records
  .filter((record) => record.owner)
  .map((record) => [record.owner!.id, record.owner!.name])).entries()]
  .map(([value, label]) => ({ value, label }))
  .sort((a, b) => a.label.localeCompare(b.label));
const dispositionOptions = [
  { value: 'DIRECTION_LINKED', label: 'Direction-linked' },
  { value: 'SUPPORT_ONLY', label: 'Russia support-only' },
  { value: 'COMPARATOR_ONLY', label: 'China comparator-only' },
  { value: 'BACKGROUND_KILLED_THESIS', label: 'Background / killed thesis' }
];
const directionOptions = directions
  .map((direction) => ({ value: direction.id, label: directionTitle(direction.id) }))
  .sort((a, b) => a.label.localeCompare(b.label));
---

<BaseLayout title="Russia-Thermal — Capabilities" description={vm.summary}>
  <SiteHeader slot="header" />

  <div data-explorer-root>
    <section class="collection-hero compact-hero">
      <div>
        <p class="eyebrow">Technical capability explorer</p>
        <h1>Capabilities</h1>
        <p>
          Browse each documented capability with its technical meaning, transfer boundary and strategic use,
          while keeping one horizontal record per capability.
        </p>
      </div>
      <div class="count">{records.length} records</div>
    </section>

    <ExplorerToolbar
      sticky
      compact
      total={records.length}
      searchPlaceholder="Search capability, owner, person, scope or direction…"
      filters={[
        {
          key: 'country',
          label: 'Country',
          options: countryValues.map((value) => ({ value, label: value === 'RU' ? 'Russia' : value === 'CN' ? 'China' : value }))
        },
        { key: 'disposition', label: 'Disposition', options: dispositionOptions },
        { key: 'owner', label: 'Owner', options: ownerValues },
        { key: 'direction', label: 'Direction', options: directionOptions }
      ]}
    />

    <section class="dense-list" aria-label="Capability records">
      {records.map((record) => (
        <div
          data-explorer-record
          data-country={record.owner?.country ?? ''}
          data-disposition={record.capability?.portfolioDisposition ?? ''}
          data-owner={record.owner?.id ?? ''}
          data-direction={record.directionIds.join('|')}
          data-search={record.search}
        >
          <DenseObjectRow
            layout="content-heavy"
            href={href(`/capabilities/${record.model.id}`)}
            ariaLabel={record.model.statement}
          >
            <div slot="main" class="cap-main">
              <div class="topline">
                <span>{record.model.id}</span>
                <b>{record.capability ? humanize(record.capability.portfolioDisposition) : record.model.portfolioDisposition}</b>
              </div>
              <a class="title" href={href(`/capabilities/${record.model.id}`)}>{record.model.statement}</a>
              <div class="owner-line">
                {record.owner && <a href={href(`/institutions/${record.owner.id}`)}>{record.owner.name}</a>}
                {record.people.length > 0 && <span>· {record.people.slice(0,3).map((person) => person.name).join(' · ')}{record.people.length > 3 ? ' …' : ''}</span>}
              </div>
            </div>

            <div slot="details" class="cap-details">
              {record.model.strategicUse && (
                <div>
                  <span>Strategic use</span>
                  <p>{record.model.strategicUse}</p>
                </div>
              )}
              {record.model.transferBoundary && (
                <div>
                  <span>Transfer boundary</span>
                  <p>{record.model.transferBoundary}</p>
                </div>
              )}
              {!record.model.strategicUse && !record.model.transferBoundary && (
                <p class="muted">No separate strategic-use or transfer-boundary statement.</p>
              )}
            </div>

            <div slot="meta" class="cap-meta">
              <div class="metric-line">
                <span>Maturity <b>{record.model.maturity}</b></span>
                <span>Evidence <b>{record.model.evidenceConfidence}</b></span>
                <span>Fit <b>{record.model.targetFit}</b></span>
              </div>
              <div class="scope-tags">
                {record.model.technicalScope.slice(0,4).map((item) => <span>{item}</span>)}
                {record.model.technicalScope.length > 4 && <span>+{record.model.technicalScope.length - 4}</span>}
              </div>
              {record.linkedDirections.length > 0 && (
                <div class="direction-line">
                  <span>Directions</span>
                  <p>{record.linkedDirections.slice(0,2).map((direction) => directionTitle(direction.id)).join(' · ')}{record.linkedDirections.length > 2 ? ' …' : ''}</p>
                </div>
              )}
            </div>

            <div slot="actions" class="row-actions">
              <a href={href(`/claims?capability=${encodeURIComponent(record.model.id)}`)}>Claims</a>
              <a href={href(`/evidence?capability=${encodeURIComponent(record.model.id)}`)}>Evidence</a>
            </div>
          </DenseObjectRow>
        </div>
      ))}
    </section>
  </div>

  <style>
    .compact-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:24px}
    .compact-hero>div:first-child{max-width:72rem}
    .collection-hero h1{margin:0;font-size:clamp(1.7rem,2.7vw,2.35rem);letter-spacing:-.05em;line-height:1.08}
    .collection-hero>div>p:not(.eyebrow){margin:.55rem 0 0;color:var(--text-muted);max-width:82ch;line-height:1.6}
    .count{flex:0 0 auto;padding:.45rem .8rem;border-radius:999px;background:var(--accent-soft);color:var(--accent);font-weight:800}

    .dense-list{margin-top:12px;border:1px solid var(--line);border-radius:var(--radius-md);overflow:hidden;background:var(--surface);box-shadow:var(--shadow-1)}
    .cap-main,.cap-details,.cap-meta{display:grid;gap:6px;min-width:0}
    .topline{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
    .topline span{color:var(--accent-vivid);font-size:.58rem;font-weight:900;letter-spacing:.05em}
    .topline b{padding:3px 6px;border-radius:999px;background:#eef6fb;color:#315f80;font-size:.54rem;text-transform:uppercase}
    .title{color:#1d405a;font-size:.93rem;font-weight:850;line-height:1.42;text-decoration:none}
    .title:hover,.title:focus-visible{text-decoration:underline;text-underline-offset:.16em}
    .owner-line{display:flex;gap:5px;flex-wrap:wrap;color:#708696;font-size:.68rem}.owner-line a{color:#3e6682;font-weight:800;text-decoration:none}

    .cap-details>div{display:grid;gap:3px}.cap-details span,.direction-line>span{color:#0b67b2;font-size:.56rem;font-weight:900;letter-spacing:.05em;text-transform:uppercase}
    .cap-details p,.direction-line p{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;margin:0;color:#536d80;font-size:.75rem;line-height:1.5}
    .muted{margin:0;color:#8798a5;font-size:.72rem}

    .metric-line{display:grid;gap:3px}.metric-line span{color:#6a8192;font-size:.62rem}.metric-line b{color:#315f80}
    .scope-tags{display:flex;gap:4px;flex-wrap:wrap}.scope-tags span{padding:3px 5px;border-radius:5px;background:#f1f5f8;color:#587185;font-size:.55rem;font-weight:750}
    .direction-line{display:grid;gap:3px;margin-top:2px}

    .row-actions{display:flex;gap:5px;flex-wrap:wrap}.row-actions a{padding:5px 7px;border:1px solid #d8e7f1;border-radius:6px;color:#43677f;font-size:.62rem;font-weight:800;text-decoration:none;white-space:nowrap}.row-actions a:hover{background:#eef6fb;color:#0b67b2}

    [hidden]{display:none!important}
    @media(max-width:850px){.compact-hero{align-items:flex-start;flex-direction:column}}
  </style>
</BaseLayout>
