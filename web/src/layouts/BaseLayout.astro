---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  immersive?: boolean;
}

const {
  title,
  description = '俄罗斯热管理科研洞察：机构、学者、原始证据与中俄对照',
  immersive = false
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body class:list={{ 'theme-immersive': immersive }}>
    <slot name="header" />
    <main>
      <slot />
    </main>
  </body>
</html>
