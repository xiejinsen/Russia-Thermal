---
import InstitutionCard from './cards/InstitutionCard.astro';
import DirectionCard from './cards/DirectionCard.astro';
import type { FrontierVenueVM } from '../types/view-models';
interface Props { model: FrontierVenueVM; }
const { model } = Astro.props;
---
<article class="venue-card">
<header><div><p class="eyebrow">{model.kind === 'CONFERENCE' ? 'Conference discovery surface' : 'Journal discovery surface'}</p><h2><a href={model.officialUrl} target="_blank" rel="noreferrer">{model.name} ↗</a></h2></div><div class="coverage"><strong>{model.evidenceCount}</strong><span>matched evidence</span></div></header>
<p class="purpose">{model.purpose}</p><a class="official-link" href={model.officialUrl} target="_blank" rel="noreferrer">Open official {model.kind === 'CONFERENCE' ? 'conference' : 'journal'} site ↗</a><p class="note">{model.coverageNote}</p>
{model.latestYear && <p class="latest">Latest normalized evidence year: <strong>{model.latestYear}</strong></p>}
{model.linkedInstitutions.length > 0 && <details><summary>Linked institutions ({model.linkedInstitutions.length})</summary><div class="grid">{model.linkedInstitutions.map((item) => <InstitutionCard model={item} />)}</div></details>}
{model.linkedDirections.length > 0 && <details><summary>Linked directions ({model.linkedDirections.length})</summary><div class="grid">{model.linkedDirections.map((item) => <DirectionCard model={item} />)}</div></details>}
</article>
<style>
.venue-card{display:grid;gap:var(--space-5,1.25rem);padding:var(--space-5,1.25rem);background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg)}header{display:flex;justify-content:space-between;gap:var(--space-4);align-items:flex-start}h2,p{margin:0}h2{font-size:1.18rem}h2 a{text-decoration:none;color:inherit}h2 a:hover{text-decoration:underline;text-underline-offset:.18em}.official-link{width:fit-content;color:var(--accent);font-size:.78rem;font-weight:800;text-decoration:none}.official-link:hover{text-decoration:underline}.coverage{display:grid;text-align:right;min-width:0}.coverage strong{font-size:1.7rem;line-height:1}.coverage span,.purpose,.note,.latest{color:var(--text-muted)}.note{padding:var(--space-4);background:var(--surface-muted);border-radius:var(--radius-sm)}details{border-top:1px solid var(--line);padding-top:var(--space-4)}summary{cursor:pointer;font-weight:700}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,20rem),1fr));gap:var(--space-4);margin-top:var(--space-4)}
@media(max-width:640px){header{flex-direction:column}.coverage{text-align:left}.venue-card{padding:var(--space-4)}}
</style>