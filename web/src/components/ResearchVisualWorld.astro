---
import { russiaAtlas } from '../view-models/russia-atlas';
const base=import.meta.env.BASE_URL;
const href=(path:string)=>path==='/'?base:base+path.replace(/^\//,'');
const rootIds=['ACT-MPEI','ACT-KUTATELADZE','ACT-TPU','ACT-TSU'];
const labels=[
 {name:'莫斯科动力工程学院',en:'Moscow Power Engineering Institute',city:'MOSCOW',focus:'长期毛细退化与可靠性研究',note:'公开资料涉及长期运行后的毛细状态变化；中间时间序列与手机应用价值需要进一步核验。',photo:'Moscow_Power_Engineering_Institute_main_Building_1.jpg',credit:'Qweasdqwe',license:'CC0'},
 {name:'库塔捷拉泽热物理研究所',en:'Kutateladze Institute of Thermophysics',city:'NOVOSIBIRSK',focus:'沸腾 / Dryout 局部机理诊断',note:'实验室光学及红外观测可提供失效状态信息，但不能直接等同于手机密闭均热板性能。',photo:'Institute_of_Thermophysics.jpg',credit:'Obakeneko',license:'CC BY 3.0'},
 {name:'托木斯克理工大学',en:'Tomsk Polytechnic University',city:'TOMSK',focus:'润湿性、表面工程与蒸发',note:'表面处理和蒸发研究提供科学方法；需要证明相对现有手机工艺的可验证增量。',photo:'Главный_корпус_ТПУ_(Томск).jpg',credit:'Павел Андрющенко',license:'CC BY-SA 3.0'},
 {name:'托木斯克国立大学',en:'Tomsk State University',city:'TOMSK',focus:'热模型与电子器件传热',note:'已关联电子冷却建模等研究方法；并不意味着存在可直接替换手机产品的成熟方案。',photo:'2018-11-10_0002_-_Главный_корпус_ТГУ.jpg',credit:'Александр Рауш',license:'CC BY-SA 4.0'}
];
const entries=rootIds.map((id,i)=>({id,...labels[i],profile:russiaAtlas.find(a=>a.id===id),link:href('/institutions/'+id)}));
const cities=[
 {name:'MOSCOW',sub:'MPEI · 01',lat:55.75,lon:37.62,link:entries[0].link},
 {name:'NOVOSIBIRSK',sub:'KUTATELADZE · 02',lat:55.03,lon:82.92,link:entries[1].link},
 {name:'TOMSK',sub:'TPU / TSU · 03–04',lat:56.48,lon:84.95,link:entries[2].link}
].map(city=>({...city,
 x:(3.5+(city.lon-17)/174*93).toFixed(2),
 y:((26+(84-city.lat)/44*370)/430*100).toFixed(2)
}));
---
<section class="visual-world" aria-labelledby="world-heading">
 <div class="hero-row">
  <div class="hero-copy">
   <p class="kicker">RUSSIA THERMAL RESEARCH / EVIDENCE-LINKED LANDSCAPE</p>
   <h1 id="world-heading">俄罗斯热管理<br/><span>科研版图</span></h1>
   <p class="english">Russian Thermal Science Landscape</p>
   <p class="lead">从科研机构进入学者、实验研究与原始证据。地图让你看见研究在哪里，机构卡片则解释它们能为手机热管理研究提供什么。</p>
   <div class="hero-actions"><a href={href('/research-map/russia/')}>完整科研图解 ↗</a><a href={href('/russia-atlas/')}>研究能力 Atlas ↗</a></div>
  </div>
  <div class="map-visual" aria-label="俄罗斯科研网络示意：莫斯科、托木斯克、新西伯利亚及关联机构">
   <div class="map-hd"><span>RUSSIA / RESEARCH GEOGRAPHY</span><strong>地理节点 → 机构档案</strong></div>
   <div class="map-geometry">
    <img src={href('/assets/russia-editorial-outline.svg')} alt="根据 Natural Earth 地理轮廓绘制的俄罗斯科研版图示意图"/>
    {cities.map(city=><a href={city.link} class="geo-node" style={'left:'+city.x+'%;top:'+city.y+'%'} title={city.name+' · '+city.sub} aria-label={city.name+' 对应机构 '+city.sub+'，打开机构档案'}><span></span><b>{city.name}</b><small>{city.sub}</small></a>)}
    <span class="map-brand">SCIENCE / RESEARCH / EVIDENCE</span>
   </div>
   <div class="geo-note">示意地理分布，非实力排名 · Tomsk 的两所高校共享城市节点 · 点击城市或下方机构卡片进入档案</div>
  </div>
 </div>
 <div class="institutions-title">
  <div><p class="kicker">FEATURED RESEARCH ORGANIZATIONS / 研究机构</p><h3>从城市节点，认识研究能力</h3></div>
  <a href={href('/institutions')}>全部机构和实验室 ↗</a>
 </div>
 <div class="institute-grid">
  {entries.map((school,index)=><article class="institute-card">
   <a href={school.link} class="institute-link">
    <div class="photo">
     <img src={'https://commons.wikimedia.org/wiki/Special:FilePath/'+encodeURIComponent(school.photo)+'?width=900'} loading="lazy" alt={school.name+'历史建筑照片'}/>
     <span class="badge-number">{String(index+1).padStart(2,'0')}</span>
     <span class="city">{school.city}</span>
    </div>
    <div class="copy">
     <h4>{school.name}</h4><p class="english-name">{school.en}</p><p class="focus">{school.focus}</p>
     <p class="description">{school.note}</p>
     <span class="view-link">查看机构、学者与证据 <b aria-hidden="true">↗</b></span>
    </div>
   </a>
   <p class="image-credit">建筑照片：{school.credit} / {school.license} · <a href={'https://commons.wikimedia.org/wiki/File:'+encodeURIComponent(school.photo)} target="_blank" rel="noopener noreferrer">来源与授权 ↗</a></p>
  </article>)}
 </div>
 <div class="visual-footer"><strong>研究价值需要通过具体证据证明。</strong><span>机构地理位置与论文研究发现，都不能直接推出手机产品级散热优势。</span><a href={href('/smartphone-transfer')}>查看手机迁移边界 ↗</a></div>
</section>
<style>
.visual-world{color:#eaf7ff;background:radial-gradient(ellipse at 80% 0,#145985 0,transparent 38%),linear-gradient(145deg,#03182b,#082f4e 57%,#03172b);border:1px solid #1b5b83;border-radius:20px;padding:clamp(22px,3.5vw,46px);margin:14px 0 40px;box-shadow:0 20px 50px #00152960}
.hero-row{display:grid;grid-template-columns:minmax(270px,.85fr) minmax(0,1.28fr);gap:20px;align-items:center}
.kicker{font-size:11px;letter-spacing:.12em;color:#76ddf5;font-weight:850;line-height:1.6;margin:0}
.hero-copy h1{font-size:clamp(35px,4vw,57px);line-height:1.13;letter-spacing:-.04em;margin:18px 0 8px;color:#fff}
.hero-copy h1 span{color:#83dfff}.english{font-size:19px;font-weight:650;color:#afdff4;margin:0 0 19px}.lead{font-size:16px;line-height:1.9;color:#daebf5;max-width:550px}
.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}.hero-actions a{padding:11px 18px;text-decoration:none;color:#f3feff;font-weight:750;border:1px solid #4799c2;border-radius:30px;background:#12517b}.hero-actions a:first-child{background:#097cad}.hero-actions a:hover{background:#1e83b4}
.map-visual{overflow:hidden;border:1px solid #3383aa;border-radius:13px;background:radial-gradient(circle at 35% 60%,#12527c80,#041a2d 75%);box-shadow:0 15px 35px #0007}
.map-hd{padding:15px 18px;display:flex;align-items:center;justify-content:space-between;gap:10px;border-bottom:1px solid #1c5979}.map-hd span{font-size:11px;color:#83e2fc;letter-spacing:.08em;font-weight:750}.map-hd strong{font-size:13px;color:#e9f8ff}
.map-geometry{position:relative;aspect-ratio:1000/430;background:repeating-linear-gradient(0deg,transparent 0 29px,#67c6ec0b 30px),repeating-linear-gradient(90deg,transparent 0 29px,#67c6ec0b 30px)}
.map-geometry>img{display:block;width:100%;height:100%}
.geo-node{position:absolute;z-index:2;transform:translate(-50%,-50%);width:19px;height:19px;border-radius:50%;background:#56dfff;border:4px solid #dcfaff;box-shadow:0 0 0 8px #16b5e54d,0 0 26px #29baf2;color:#fff;text-decoration:none}
.geo-node span{display:block;width:100%;height:100%}.geo-node b{position:absolute;top:22px;left:-12px;background:#062b47cf;padding:2px 5px;border-radius:4px;color:white;white-space:nowrap;font-size:10px}.geo-node small{position:absolute;top:39px;left:-12px;white-space:nowrap;color:#bce8fa;font-size:8px}
.geo-node:hover,.geo-node:focus-visible{background:white;outline:2px solid #ecffff;outline-offset:6px}.map-brand{position:absolute;right:10px;bottom:9px;font-size:9px;letter-spacing:.12em;color:#a1cce0}
.geo-note{font-size:11px;line-height:1.7;color:#cce4f0;padding:12px 17px;border-top:1px solid #19516d}
.institutions-title{display:flex;align-items:end;justify-content:space-between;gap:12px;padding:31px 0 20px;border-top:1px solid #327796;margin-top:30px}.institutions-title h3{font-size:26px;color:#fff;margin:5px 0 0}.institutions-title a{color:#a5ebff;font-size:13px}
.institute-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}
.institute-card{background:linear-gradient(150deg,#134c71,#081e36);border:1px solid #3a7495;border-radius:12px;overflow:hidden;min-width:0;box-shadow:0 7px 18px #00142661;transition:transform .2s}
.institute-card:hover{transform:translateY(-5px)}.institute-link{display:block;color:#edf9ff;text-decoration:none;height:100%}.institute-link:focus-visible{outline:3px solid #aff7ff;outline-offset:-3px}
.photo{height:145px;position:relative;background:#103a57}.photo img{width:100%;height:100%;object-fit:cover;filter:saturate(.87) brightness(.95)}.photo:after{content:'';position:absolute;inset:40% 0 0;background:linear-gradient(0deg,#0a233cdc,transparent)}
.badge-number,.city{position:absolute;z-index:1;color:white;font-weight:800;text-shadow:0 1px 5px #000}.badge-number{top:10px;left:10px;font-size:19px}.city{bottom:12px;right:10px;font-size:11px}
.copy{padding:16px}.copy h4{color:#fff;font-size:16px;line-height:1.35;margin:0 0 4px}.english-name{color:#bedff0;font-size:11px;line-height:1.5;min-height:33px;margin:0 0 15px}.focus{color:#8deaff;border-top:1px solid #32698c;padding-top:12px;font-size:13px;font-weight:800}.description{color:#d0e4ee;font-size:12px;line-height:1.75;min-height:90px}.view-link{display:flex;justify-content:space-between;gap:6px;color:#abedff;font-weight:800;font-size:12px;border-top:1px solid #25638b;padding-top:12px}
.image-credit{padding:0 15px 12px;color:#c5dfea;font-size:10px;line-height:1.55;margin:0}.image-credit a{color:#a0eeff}.visual-footer{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center;padding-top:20px;margin-top:23px;border-top:1px solid #286d90;font-size:12px;color:#cce6f3}.visual-footer strong{color:white}.visual-footer a{color:#a6edff;margin-left:auto}
@media(max-width:1030px){.hero-row{grid-template-columns:1fr}.institute-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.description{min-height:0}}
@media(max-width:580px){.visual-world{border-radius:11px;padding:17px}.institute-grid{grid-template-columns:1fr}.institutions-title{flex-direction:column;align-items:start}.photo{height:190px}.map-hd{flex-direction:column;align-items:start}.geo-node b{font-size:8px}.geo-node small{display:none}}
@media(prefers-reduced-motion:reduce){.institute-card{transition:none}}
</style>
