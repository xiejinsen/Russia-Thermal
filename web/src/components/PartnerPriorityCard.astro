---
import InstitutionCard from './cards/InstitutionCard.astro';
import ScholarCard from './cards/ScholarCard.astro';
import DirectionCard from './cards/DirectionCard.astro';
import Badge from './primitives/Badge.astro';
import type { PartnerPriorityVM } from '../types/view-models';

interface Props {
  model: PartnerPriorityVM;
}

const { model } = Astro.props;
---

<section class="priority-card">
  <div class="priority-head">
    <div>
      <p class="rank">{model.rank}</p>
      <h2>{model.priorityClass} collaboration package</h2>
    </div>
    {model.readiness && <Badge tone="positive">{model.readiness}</Badge>}
  </div>

  {model.rationale && <p class="rationale">{model.rationale}</p>}
  {model.recommendedAction && (
    <div class="action">
      <strong>Recommended action</strong>
      <span>{model.recommendedAction}</span>
    </div>
  )}

  <div class="grid">
    {model.institutions.map((item) => <InstitutionCard model={item} />)}
  </div>

  {model.scholars.length > 0 && (
    <div>
      <h3>Key people</h3>
      <div class="grid">{model.scholars.map((item) => <ScholarCard model={item} />)}</div>
    </div>
  )}

  {model.directions.length > 0 && (
    <div>
      <h3>Connected directions</h3>
      <div class="grid">{model.directions.map((item) => <DirectionCard model={item} />)}</div>
    </div>
  )}
</section>

<style>
  .priority-card {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-8);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-1);
  }

  .priority-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .rank {
    margin: 0 0 var(--space-1);
    color: var(--accent);
    font-size: 1.6rem;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  h2, h3, p { margin: 0; }

  h2 { font-size: 1.5rem; }

  h3 {
    margin-bottom: var(--space-3);
    color: var(--text-muted);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .rationale {
    max-width: 72ch;
    color: var(--text-muted);
  }

  .action {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--surface-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-4);
  }
</style>
