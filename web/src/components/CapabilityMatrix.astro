---
import DecisionBadge from './domain/DecisionBadge.astro';
import type { LandscapeRowVM } from '../types/view-models';
interface Props { rows: LandscapeRowVM[]; }
const { rows } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<section class="matrix-wrap" aria-labelledby="matrix-title">
  <div class="matrix-head">
    <div>
      <p class="eyebrow">Capability matrix</p>
      <h2 id="matrix-title">Comparator pressure at a glance</h2>
    </div>
    <p>Each row is a canonical Direction. This is not a country scorecard; it shows who forms the China/global baseline, which Russian institutions retain differentiated value, transfer maturity and the current decision lane.</p>
  </div>

  <div class="matrix" role="table" aria-label="Russia versus China capability matrix">
    <div class="matrix-row matrix-header" role="row">
      <div role="columnheader">Direction</div>
      <div role="columnheader">China · representative baseline</div>
      <div role="columnheader">Russia · linked institutions</div>
      <div role="columnheader">Phone maturity</div>
      <div role="columnheader">Decision</div>
    </div>

    {rows.map((row) => (
      <div class="matrix-row" role="row">
        <div class="direction" role="cell">
          <a href={href(`/directions/${row.direction.id}`)}><strong>{row.direction.title}</strong></a>
          <span>{row.direction.role}</span>
        </div>
        <div class="china" role="cell"><a href={href('/research-map/china')}><strong class="entity-label">{row.chinaLabel}</strong><p>{row.chinaBaseline}</p></a></div>
        <div class="russia" role="cell"><a href={href('/research-map/russia')}><strong class="entity-label">{row.russiaLabel}</strong><p>{row.russiaResidual}</p></a></div>
        <div class="maturity" role="cell"><strong>{row.direction.phoneTransferMaturity}</strong><span>{row.direction.differentiationConfidence} differentiation</span></div>
        <div role="cell"><DecisionBadge label={row.direction.lane.label} tone={row.direction.lane.tone} /></div>
      </div>
    ))}
  </div>
</section>

<style>
.matrix-wrap{display:grid;gap:var(--space-5,1.25rem);margin-top:var(--space-10,2.5rem)}
.matrix-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.75fr);gap:var(--space-8);align-items:end}.matrix-head h2,.matrix-head p{margin:0}.matrix-head h2{font-size:clamp(1.45rem,2.5vw,2.1rem);letter-spacing:-.045em;line-height:1}.matrix-head>p{color:#42566b;font-weight:500}
.matrix{overflow:hidden;border:1px solid #c8d8e6;border-radius:var(--radius-lg);background:rgb(255 255 255 / .92);box-shadow:0 16px 46px rgb(35 75 102 / .06)}
.matrix-row{display:grid;grid-template-columns:minmax(12rem,1.05fr) minmax(17rem,1.55fr) minmax(17rem,1.55fr) minmax(9rem,.7fr) minmax(8rem,.65fr)}
.matrix-row>div{min-width:0;padding:var(--space-4);border-bottom:1px solid #d3e0eb}
.matrix-row>div+div{border-left:1px solid #d3e0eb}.matrix-row:last-child>div{border-bottom:0}
.matrix-header{background:linear-gradient(90deg,#e4f2fd,#f5faff);color:#20384f;font-size:.72rem;font-weight:850;letter-spacing:.055em;text-transform:uppercase}
.direction{display:grid;gap:var(--space-1)}.direction>a,.china>a,.russia>a{color:inherit;text-decoration:none}.direction>a:hover,.direction>a:focus-visible,.china>a:hover,.china>a:focus-visible,.russia>a:hover,.russia>a:focus-visible{text-decoration:underline;text-underline-offset:.16em}.direction span,.maturity span{color:#50657a;font-size:.8rem}
.entity-label{display:block;margin-bottom:var(--space-2);color:#172b40;font-size:.8rem;line-height:1.35}
.matrix p{margin:0;color:#34495e;font-size:.88rem;line-height:1.58;font-weight:500}
.china{background:rgb(237 246 255 / .52)}.russia{background:rgb(235 248 244 / .64)}
.maturity{display:grid;align-content:start;gap:var(--space-1);color:#1c344b}
@media(max-width:980px){.matrix{overflow-x:auto}.matrix-row{min-width:66rem}.matrix-head{grid-template-columns:1fr}}
</style>