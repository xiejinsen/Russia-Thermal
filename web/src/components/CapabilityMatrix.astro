---
import DecisionBadge from './domain/DecisionBadge.astro';
import type { LandscapeRowVM } from '../types/view-models';
interface Props { rows: LandscapeRowVM[]; }
const { rows } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---

<section class="matrix-wrap" aria-labelledby="matrix-title">
  <div class="matrix-head">
    <div>
      <p class="eyebrow">Capability matrix</p>
      <h2 id="matrix-title">Comparator pressure at a glance</h2>
    </div>
    <p>Each row is a canonical Direction. This is not a country scorecard; it shows who forms the China/global baseline, which Russian institutions retain differentiated value, transfer maturity and the current decision lane.</p>
  </div>

  <div class="matrix" role="table" aria-label="Russian research relative to China and global original science">
    <div class="matrix-row matrix-header" role="row">
      <div role="columnheader">Direction</div>
      <div role="columnheader">对照基线 · 中国 / 全球 / 内部</div>
      <div role="columnheader">俄方研究增量 · 证据边界</div>
      <div role="columnheader">Phone maturity</div>
      <div role="columnheader">Decision</div>
    </div>

    {rows.map((row) => (
      <div class="matrix-entry" role="rowgroup">
        <div class="matrix-row" role="row">
          <div class="direction" role="cell">
            <a href={href(`/directions/${row.direction.id}`)}><strong>{row.direction.title}</strong></a>
            <span>{row.direction.role}</span>
          </div>
          <div class="china" role="cell"><strong class="entity-label">{row.chinaLabel}</strong><p>{row.chinaBaseline}</p></div>
          <div class="russia" role="cell"><strong class="entity-label">{row.russiaLabel}</strong><p>{row.russiaResidual}</p></div>
          <div class="maturity" role="cell"><strong>{row.direction.phoneTransferMaturity}</strong><span>{row.direction.differentiationConfidence} differentiation</span></div>
          <div role="cell"><DecisionBadge label={row.direction.lane.label} tone={row.direction.lane.tone} /></div>
        </div>
        <div class="evidence-row" role="row">
          <div class="research-sources" role="cell">
            <span class="source-title">原文及 Claim 证据索引（关联证据≠同装置优势证明）</span>
            <div class="country-sources">
              <div><b>中国来源</b>{row.chinaEvidence.slice(0,3).map(s => <a href={s.primaryUrl} target="_blank" rel="noopener noreferrer">{s.title} ({s.year ?? '年份未知'}) ↗</a>)}{row.chinaEvidence.length===0 && <small>未找到已关联的中国原始论文；不代表没有中国研究</small>}</div>
              <div><b>国际/其他国别或未分类</b>{row.internationalEvidence.slice(0,3).map(s => <a href={s.primaryUrl} target="_blank" rel="noopener noreferrer">{s.title} ({s.year ?? '年份未知'}) ↗</a>)}{row.internationalEvidence.length===0 && <small>无独立关联记录或来源未收录</small>}</div>
              <div><b>俄罗斯来源</b>{row.russiaEvidence.slice(0,3).map(s => <a href={s.primaryUrl} target="_blank" rel="noopener noreferrer">{s.title} ({s.year ?? '年份未知'}) ↗</a>)}{row.russiaEvidence.length===0 && <small>暂无已关联的俄方论文，不表示没有科研成果</small>}</div>
            </div>
            <div class="claim-links"><span>{row.supportingClaimCount} 条有支持来源的 Claim · {row.contradictingClaimCount} 条有反证来源的 Claim</span>
              <a href={href(`/claims?direction=${encodeURIComponent(row.direction.id)}`)}>核查完整 Claim →</a>
              <a href={href(`/evidence?direction=${encodeURIComponent(row.direction.id)}`)}>全部证据 →</a>
              <a href={href(`/smartphone-transfer#${row.direction.id}`)}>手机迁移条件 →</a>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
.matrix-wrap{display:grid;gap:var(--space-5,1.25rem);margin-top:var(--space-10,2.5rem)}
.matrix-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.75fr);gap:var(--space-8);align-items:end}.matrix-head h2,.matrix-head p{margin:0}.matrix-head h2{font-size:clamp(1.45rem,2.5vw,2.1rem);letter-spacing:-.045em;line-height:1}.matrix-head>p{color:#42566b;font-weight:500}
.matrix{overflow:hidden;border:1px solid #c8d8e6;border-radius:var(--radius-lg);background:rgb(255 255 255 / .92);box-shadow:0 16px 46px rgb(35 75 102 / .06)}
.matrix-row{display:grid;grid-template-columns:minmax(12rem,1.05fr) minmax(17rem,1.55fr) minmax(17rem,1.55fr) minmax(9rem,.7fr) minmax(8rem,.65fr)}
.matrix-row>div{min-width:0;padding:var(--space-4);border-bottom:1px solid #d3e0eb}
.matrix-row>div+div{border-left:1px solid #d3e0eb}.matrix-entry:last-child .evidence-row{border-bottom:0}
.matrix-header{background:linear-gradient(90deg,#e4f2fd,#f5faff);color:#20384f;font-size:.72rem;font-weight:850;letter-spacing:.055em;text-transform:uppercase}
.direction{display:grid;gap:var(--space-1)}.direction>a{color:inherit;text-decoration:none}.direction>a:hover,.direction>a:focus-visible{text-decoration:underline;text-underline-offset:.16em}.cell-link{display:inline-block;margin-top:.7rem;color:var(--accent-vivid);font-size:.75rem;font-weight:800;text-decoration:none}.cell-link:hover,.cell-link:focus-visible{text-decoration:underline;text-underline-offset:.16em}.direction span,.maturity span{color:#50657a;font-size:.8rem}
.entity-label{display:block;margin-bottom:var(--space-2);color:#172b40;font-size:.8rem;line-height:1.35}
.matrix p{margin:0;color:#34495e;font-size:.88rem;line-height:1.58;font-weight:500}
.china{background:rgb(237 246 255 / .52)}.russia{background:rgb(235 248 244 / .64)}
.maturity{display:grid;align-content:start;gap:var(--space-1);color:#1c344b}
.evidence-row{border-bottom:2px solid #c9dce9;background:#f8fbfd;padding:14px 18px 16px}
.research-sources{min-width:0}
.source-title{display:block;font-size:.78rem;font-weight:800;color:#365d80;margin-bottom:8px}
.country-sources{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.country-sources>div{min-width:0;border-left:2px solid #b7d4e5;padding-left:10px}
.country-sources b{display:block;color:#365d80;font-size:.74rem;margin-bottom:6px}
.country-sources a{display:block;line-height:1.4;font-size:.76rem;color:#145a8c;overflow-wrap:anywhere;margin:5px 0}
.country-sources small{font-size:.72rem;line-height:1.4;color:#6b8091}
.claim-links{display:flex;gap:10px 16px;flex-wrap:wrap;align-items:center;margin-top:12px;padding-top:8px;border-top:1px solid #d7e4ed;font-size:.73rem;color:#60788a}
.claim-links a{color:#165c90;font-weight:750}
@media(max-width:840px){.country-sources{grid-template-columns:1fr}}
@media(max-width:980px){.matrix{overflow-x:auto}.matrix-row{min-width:66rem}.matrix-head{grid-template-columns:1fr}}
</style>