---
import DecisionBadge from './domain/DecisionBadge.astro';
import type { PartnerPriorityVM } from '../types/view-models';

interface Props { model: PartnerPriorityVM; }
const { model } = Astro.props;
const institution = model.institutions[0];
const direction = model.directions[0];
const base = import.meta.env.BASE_URL;
const institutionHref = institution?.href ? `${base}${institution.href.replace(/^\//,'')}` : undefined;
---

<article class="exec-priority">
  <div class="rank">{model.rank}</div>
  <div class="body">
    <div class="headline">
      <div>
        <p class="eyebrow">{model.priorityClass}</p>
        <h3>{institutionHref ? <a href={institutionHref}>{institution?.name ?? model.id}</a> : institution?.name ?? model.id}</h3>
      </div>
      {direction && <DecisionBadge label={direction.lane.label} tone={direction.lane.tone} />}
    </div>
    {model.rationale && <p class="rationale">{model.rationale}</p>}
    <dl>
      {model.readiness && <div><dt>Readiness</dt><dd>{model.readiness}</dd></div>}
      {direction && <div><dt>Direction</dt><dd>{direction.title}</dd></div>}
      {model.recommendedAction && <div><dt>Action</dt><dd>{model.recommendedAction}</dd></div>}
    </dl>
  </div>
</article>

<style>
  .exec-priority{display:grid;grid-template-columns:4.5rem 1fr;min-height:100%;background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden}
  .rank{display:grid;place-items:start center;padding:var(--space-6) var(--space-3);background:var(--accent);color:white;font-size:1.65rem;font-weight:900;letter-spacing:-.05em}
  .body{display:grid;gap:var(--space-4);padding:var(--space-6)}
  .headline{display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-4)}
  h3,p{margin:0}h3{font-size:1.25rem;letter-spacing:-.025em}h3 a{text-decoration:none}h3 a:hover{text-decoration:underline;text-underline-offset:.18em}
  .rationale{color:var(--text-muted)}
  dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(9rem,1fr));gap:var(--space-3);margin:0;padding-top:var(--space-4);border-top:1px solid var(--line)}
  dt{color:var(--text-muted);font-size:.68rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase}
  dd{margin:var(--space-1) 0 0;font-size:.9rem;font-weight:650}
</style>