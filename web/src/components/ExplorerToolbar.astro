---
interface FilterOption { value: string; label: string; }
interface FilterDef { key: string; label: string; options: FilterOption[]; }
interface Props {
  filters: FilterDef[];
  searchPlaceholder?: string;
  total: number;
  sticky?: boolean;
  compact?: boolean;
  urlFilterKeys?: string[];
}
const {
  filters,
  searchPlaceholder = 'Search records…',
  total,
  sticky = false,
  compact = false,
  urlFilterKeys = []
} = Astro.props;
---

<div
  class:list={['explorer-toolbar', { sticky, compact }]}
  data-explorer-toolbar
  data-url-filter-keys={urlFilterKeys.join('|')}
>
  <label class="search-box">
    <span>Search</span>
    <input type="search" placeholder={searchPlaceholder} data-explorer-search />
  </label>

  {filters.map((filter) => (
    <label>
      <span>{filter.label}</span>
      <select data-explorer-filter data-filter-key={filter.key}>
        <option value="">{compact ? `${filter.label}: All` : 'All'}</option>
        {filter.options.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
    </label>
  ))}

  <div class="toolbar-scope" data-explorer-scope hidden></div>

  <div class="toolbar-result">
    <strong data-explorer-count>{total}</strong>
    <span>visible</span>
  </div>

  <button type="button" data-explorer-reset>Reset</button>
</div>

<script>
  const roots = document.querySelectorAll<HTMLElement>('[data-explorer-root]');

  roots.forEach((root) => {
    const toolbar = root.querySelector<HTMLElement>('[data-explorer-toolbar]');
    if (!toolbar) return;

    const search = toolbar.querySelector<HTMLInputElement>('[data-explorer-search]');
    const filters = [...toolbar.querySelectorAll<HTMLSelectElement>('[data-explorer-filter]')];
    const reset = toolbar.querySelector<HTMLButtonElement>('[data-explorer-reset]');
    const count = toolbar.querySelector<HTMLElement>('[data-explorer-count]');
    const scope = toolbar.querySelector<HTMLElement>('[data-explorer-scope]');
    const records = [...root.querySelectorAll<HTMLElement>('[data-explorer-record]')];
    const extraKeys = (toolbar.dataset.urlFilterKeys ?? '').split('|').filter(Boolean);

    const values = (record: HTMLElement, key: string) =>
      (record.dataset[key] ?? '').split('|').map((value) => value.trim()).filter(Boolean);

    const params = () => new URLSearchParams(window.location.search);

    const relationMatches = (record: HTMLElement, url: URLSearchParams) => {
      const claim = url.get('claim');
      const relation = url.get('relation')?.toLowerCase();
      if (!claim || !relation) return true;
      if (relation === 'supporting' || relation === 'support') {
        return values(record, 'supportingClaim').includes(claim);
      }
      if (relation === 'pressure' || relation === 'contradicting' || relation === 'contradict') {
        return values(record, 'pressureClaim').includes(claim);
      }
      return true;
    };

    const syncControlsFromUrl = () => {
      const url = params();
      if (search) search.value = url.get('q') ?? '';
      filters.forEach((select) => {
        const key = select.dataset.filterKey ?? '';
        const requested = url.get(key) ?? '';
        select.value = [...select.options].some((option) => option.value === requested) ? requested : '';
      });
    };

    const updateScope = (url: URLSearchParams) => {
      if (!scope) return;
      const labels: string[] = [];
      for (const key of extraKeys) {
        const value = url.get(key);
        if (value) labels.push(`${key}: ${value}`);
      }
      const relation = url.get('relation');
      if (relation && !extraKeys.includes('relation')) labels.push(`relation: ${relation}`);
      scope.textContent = labels.length ? `Scope · ${labels.join(' · ')}` : '';
      scope.hidden = labels.length === 0;
    };

    const writeUrlFromControls = () => {
      const url = new URL(window.location.href);
      const query = search?.value.trim() ?? '';
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');

      filters.forEach((select) => {
        const key = select.dataset.filterKey ?? '';
        if (!key) return;
        if (select.value) url.searchParams.set(key, select.value);
        else url.searchParams.delete(key);
      });

      window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
    };

    const apply = () => {
      const url = params();
      const query = (url.get('q') ?? search?.value ?? '').trim().toLowerCase();
      let visible = 0;

      for (const record of records) {
        const searchable = (record.dataset.search ?? '').toLowerCase();
        const searchMatch = !query || searchable.includes(query);

        const visibleFilterMatch = filters.every((select) => {
          const key = select.dataset.filterKey ?? '';
          const selected = url.get(key) ?? select.value;
          if (!selected) return true;
          return values(record, key).includes(selected);
        });

        const extraFilterMatch = extraKeys.every((key) => {
          if (key === 'relation') return true;
          const selected = url.get(key);
          if (!selected) return true;
          return values(record, key).includes(selected);
        });

        const matched = searchMatch && visibleFilterMatch && extraFilterMatch && relationMatches(record, url);
        record.hidden = !matched;
        if (matched) visible += 1;
      }

      if (count) count.textContent = String(visible);
      updateScope(url);
    };

    const onControlChange = () => {
      writeUrlFromControls();
      apply();
    };

    search?.addEventListener('input', onControlChange);
    filters.forEach((select) => select.addEventListener('change', onControlChange));

    reset?.addEventListener('click', () => {
      const url = new URL(window.location.href);
      url.search = '';
      window.history.replaceState({}, '', `${url.pathname}${url.hash}`);
      syncControlsFromUrl();
      apply();
      search?.focus();
    });

    window.addEventListener('popstate', () => {
      syncControlsFromUrl();
      apply();
    });

    syncControlsFromUrl();
    apply();
  });
</script>

<style>
  .explorer-toolbar{
    display:grid;
    grid-template-columns:minmax(16rem,1.45fr) repeat(auto-fit,minmax(10rem,.65fr)) auto auto;
    gap:10px;
    align-items:end;
    margin-top:var(--space-8);
    padding:14px;
    border:1px solid var(--line);
    border-radius:var(--radius-md);
    background:var(--surface);
    box-shadow:var(--shadow-1);
  }
  .explorer-toolbar.compact{
    display:flex;
    align-items:center;
    gap:6px;
    margin-top:12px;
    padding:6px 8px;
    border-radius:9px;
    overflow-x:auto;
    overscroll-behavior-x:contain;
    scrollbar-width:thin;
  }
  .explorer-toolbar.compact label{
    display:block;
    flex:0 0 auto;
  }
  .explorer-toolbar.compact label>span{
    display:none;
  }
  .explorer-toolbar.compact .search-box{
    flex:1 0 17rem;
    min-width:17rem;
    max-width:28rem;
  }
  .explorer-toolbar.compact label:not(.search-box){
    min-width:8.5rem;
    max-width:12rem;
  }
  .explorer-toolbar.compact input,
  .explorer-toolbar.compact select{
    min-height:36px;
    height:36px;
    padding:4px 8px;
    border-radius:6px;
    font-size:.82rem;
  }
  .explorer-toolbar.compact .toolbar-scope{
    flex:0 0 auto;
    max-width:18rem;
    overflow:hidden;
    padding:5px 8px;
    border:1px solid #d8e7f1;
    border-radius:6px;
    background:#f8fbfd;
    color:#5a7183;
    font-size:.7rem;
    font-weight:800;
    text-overflow:ellipsis;
    white-space:nowrap;
  }
  .explorer-toolbar.compact .toolbar-result{
    display:flex;
    align-items:center;
    gap:4px;
    flex:0 0 auto;
    min-width:auto;
    height:36px;
    padding:0 8px;
    border-radius:6px;
  }
  .explorer-toolbar.compact .toolbar-result strong{
    font-size:.82rem;
  }
  .explorer-toolbar.compact .toolbar-result span{
    font-size:.68rem;
  }
  .explorer-toolbar.compact button{
    flex:0 0 auto;
    min-height:36px;
    height:36px;
    padding:0 9px;
    border-radius:6px;
    font-size:.75rem;
  }

  .explorer-toolbar.sticky{
    position:sticky;
    top:2.85rem;
    z-index:80;
    background:rgb(255 255 255 / .96);
    backdrop-filter:blur(14px);
  }
  label{display:grid;gap:5px;min-width:0}
  label>span,.toolbar-result span{color:var(--text-muted);font-size:.68rem;font-weight:850;letter-spacing:.06em;text-transform:uppercase}
  input,select{
    width:100%;
    min-height:40px;
    padding:8px 10px;
    border:1px solid var(--line);
    border-radius:8px;
    background:var(--surface-muted);
    color:var(--text);
    font:inherit;
    font-size:.82rem;
  }
  input:focus,select:focus{outline:2px solid color-mix(in srgb,var(--accent-vivid) 25%,transparent);border-color:var(--accent-vivid)}
  .toolbar-result{display:grid;justify-items:center;align-content:center;min-width:70px;height:40px;padding:0 10px;border-radius:8px;background:var(--accent-soft)}
  .toolbar-result strong{color:var(--accent);font-size:1rem}
  button{
    min-height:40px;
    padding:0 12px;
    border:1px solid var(--line);
    border-radius:8px;
    background:var(--surface);
    color:var(--accent);
    font:inherit;
    font-size:.78rem;
    font-weight:850;
    cursor:pointer;
  }
  button:hover,button:focus-visible{background:var(--accent-soft);outline:none}
  @media(max-width:950px){.explorer-toolbar:not(.compact){grid-template-columns:1fr 1fr}.explorer-toolbar:not(.compact) .search-box{grid-column:1/-1}}
  @media(max-width:860px){.explorer-toolbar.sticky{top:5.9rem}}
  @media(max-width:620px){.explorer-toolbar:not(.compact){grid-template-columns:1fr}.explorer-toolbar:not(.compact) .search-box{grid-column:auto}.explorer-toolbar.compact .search-box{flex-basis:14rem;min-width:14rem}}
</style>
