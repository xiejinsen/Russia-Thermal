---
import DecisionBadge from '../domain/DecisionBadge.astro';
import MetricPair from '../domain/MetricPair.astro';
import type { DirectionCardVM } from '../../types/view-models';

interface Props { model: DirectionCardVM; }
const { model } = Astro.props;
---

<article class="direction-card" aria-label={`${model.title}: ${model.recommendation}`}>
  <div class="heading">
    <div>
      <p class="recommendation">{model.recommendation}</p>
      <h3>{model.title}</h3>
    </div>
    <DecisionBadge label={model.lane.label} tone={model.lane.tone} />
  </div>

  {model.collaborationFocus && (
    <div class="conclusion">
      <span>What we should do</span>
      <p>{model.collaborationFocus}</p>
    </div>
  )}

  <div class="logic-grid">
    {model.problem && (
      <div class="logic-block">
        <strong>Problem to solve</strong>
        <p>{model.problem}</p>
      </div>
    )}
    {model.residualDifferentiation && (
      <div class="logic-block">
        <strong>Why Russia still adds value</strong>
        <p>{model.residualDifferentiation}</p>
      </div>
    )}
  </div>

  <dl class="metrics">
    <MetricPair label="Differentiation" value={model.differentiationConfidence} />
    <MetricPair label="Phone maturity" value={model.phoneTransferMaturity} />
  </dl>

  {model.ourControlBoundary && (
    <div class="block">
      <strong>What we keep under our control</strong>
      <p>{model.ourControlBoundary}</p>
    </div>
  )}

  {model.nextQuestion && (
    <div class="block next-question">
      <strong>Next question</strong>
      <p>{model.nextQuestion}</p>
    </div>
  )}

  {model.nextGate && (
    <div class="block gate">
      <strong>Promotion gate</strong>
      <p>{model.nextGate}</p>
    </div>
  )}
</article>

<style>
.direction-card{display:grid;gap:var(--space-5,1.25rem);padding:var(--space-6);background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-md)}
.heading{display:flex;align-items:start;justify-content:space-between;gap:var(--space-4)}
.recommendation{margin:0 0 var(--space-1);color:var(--accent-vivid);font-size:.78rem;font-weight:850;letter-spacing:.035em;text-transform:uppercase}
h3,p{margin:0}h3{font-size:1.25rem;letter-spacing:-.025em}
.conclusion{display:grid;gap:var(--space-2);padding:var(--space-5,1.25rem);border-left:4px solid var(--accent-vivid);border-radius:0 var(--radius-sm) var(--radius-sm) 0;background:linear-gradient(90deg,#e8f4ff,#f7fbff)}
.conclusion span{color:#21496d;font-size:.72rem;font-weight:850;letter-spacing:.06em;text-transform:uppercase}
.conclusion p{color:#172b40;font-weight:700;line-height:1.55}
.logic-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-3)}
.logic-block{display:grid;gap:var(--space-2);padding:var(--space-4);background:var(--surface-muted);border-radius:var(--radius-sm)}
.logic-block strong,.block strong{font-size:.8rem;color:#243c53}.logic-block p,.block p{color:var(--text-secondary);font-size:.9rem;line-height:1.58}
.metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4);margin:0;padding:var(--space-4) 0;border-block:1px solid var(--line)}
.block{display:grid;gap:var(--space-2)}
.next-question{padding:var(--space-4);border:1px solid #d3e2ef;border-radius:var(--radius-sm);background:#f8fbfe}
.gate{padding:var(--space-4);background:#edf7f3;border-radius:var(--radius-sm)}
@media(max-width:720px){.logic-grid{grid-template-columns:1fr}}
</style>
