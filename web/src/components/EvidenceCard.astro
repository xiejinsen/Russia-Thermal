---
import Badge from './primitives/Badge.astro';
import CapabilityDetail from './CapabilityDetail.astro';
import DirectionCard from './cards/DirectionCard.astro';
import type { EvidenceCardVM } from '../types/view-models';

interface Props { model: EvidenceCardVM; }
const { model } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
const paperHref = model.id.startsWith('PAPER-') ? href(`/papers/${model.id}`) : undefined;
---

<article class="evidence-card">
  <div class="meta">
    <Badge tone="accent">{model.sourceType}</Badge>
    {model.year && <span>{model.year}</span>}
    {model.venue && <span>{model.venue}</span>}
  </div>

  <h2>{paperHref ? <a href={paperHref}>{model.title}</a> : <a href={model.primaryUrl} rel="noreferrer">{model.title} ↗</a>}</h2>
  {paperHref && <div class="source-actions"><a href={paperHref}>Open paper →</a><a href={model.primaryUrl} rel="noreferrer">Original source ↗</a></div>}

  {model.authors.length > 0 && <p class="authors">{model.authors.join('; ')}</p>}
  {model.countryContext && <p class="country">{model.countryContext}</p>}

  {model.findings.length > 0 && (
    <div class="block">
      <strong>Direct findings</strong>
      <ul>{model.findings.map((item) => <li>{item}</li>)}</ul>
    </div>
  )}

  {model.boundary && (
    <div class="boundary">
      <strong>Boundary</strong>
      <p>{model.boundary}</p>
    </div>
  )}

  {(model.supportingClaims.length > 0 || model.contradictingClaims.length > 0) && (
    <div class="claim-grid">
      <div>
        <h3>Supports</h3>
        {model.supportingClaims.map((claim) => (
          <div class="claim">
            <span>{claim.id}</span>
            <p><a href={href(`/claims/${claim.id}`)}>{claim.proposition}</a></p>
            <small>{claim.confidence} · {claim.status}</small>
          </div>
        ))}
      </div>
      <div>
        <h3>Contradicts / pressures</h3>
        {model.contradictingClaims.map((claim) => (
          <div class="claim">
            <span>{claim.id}</span>
            <p><a href={href(`/claims/${claim.id}`)}>{claim.proposition}</a></p>
            <small>{claim.confidence} · {claim.status}</small>
          </div>
        ))}
      </div>
    </div>
  )}

  {model.linkedCapabilities.length > 0 && (
    <details>
      <summary>Linked capabilities ({model.linkedCapabilities.length})</summary>
      <div class="nested-grid">{model.linkedCapabilities.map((cap) => <CapabilityDetail model={cap} />)}</div>
    </details>
  )}

  {model.linkedDirections.length > 0 && (
    <details>
      <summary>Linked directions ({model.linkedDirections.length})</summary>
      <div class="nested-grid">{model.linkedDirections.map((dir) => <DirectionCard model={dir} />)}</div>
    </details>
  )}
</article>

<style>
  .evidence-card {
    display: grid;
    gap: var(--space-5, 1.25rem);
    padding: var(--space-8);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .meta { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; color: var(--text-muted); font-size: .8rem; }
  h2, h3, p { margin: 0; }
  h2 { font-size: 1.25rem; line-height: 1.3; }
  h2 a { text-decoration: none; }
  h2 a:hover, h2 a:focus-visible { text-decoration: underline; text-underline-offset: .18em; }
  .authors, .country { color: var(--text-muted); font-size: .9rem; }
  .source-actions{display:flex;gap:var(--space-4);flex-wrap:wrap}.source-actions a{font-size:.8rem;font-weight:800;color:var(--accent-vivid)}
  .claim p a{color:inherit;text-underline-offset:.16em}
  .block, .boundary { display: grid; gap: var(--space-2); }
  .block ul { margin: 0; padding-left: 1.2rem; }
  .boundary { padding: var(--space-4); background: var(--surface-muted); border-radius: var(--radius-sm); }
  .boundary p { color: var(--text-muted); }
  .claim-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: var(--space-6); }
  .claim-grid > div { display: grid; gap: var(--space-3); }
  .claim-grid h3 { color: var(--text-muted); font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; }
  .claim { padding-left: var(--space-3); border-left: 2px solid var(--line); }
  .claim span, .claim small { color: var(--text-muted); font-size: .75rem; }
  .claim p { margin: var(--space-1) 0; }
  details { border-top: 1px solid var(--line); padding-top: var(--space-4); }
  summary { cursor: pointer; font-weight: 700; }
  .nested-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: var(--space-4); margin-top: var(--space-4); }
</style>
