---
interface Props { eyebrow?: string; title: string; description?: string; }
const { eyebrow, title, description } = Astro.props;
---
<header class="section-header">
  {eyebrow && <p class="section-index">{eyebrow}</p>}
  <h2>{title}</h2>
  {description && <p class="description">{description}</p>}
</header>
<style>
  .section-header { max-width:62rem; }
  .section-index {
    margin:0 0 var(--space-2);
    color:var(--accent-vivid);
    font-size:clamp(1.45rem,3vw,2.35rem);
    font-weight:900;
    letter-spacing:-.045em;
    line-height:1;
  }
  h2 {
    margin:0;
    font-size:clamp(1.85rem,3.4vw,2.9rem);
    line-height:1.02;
    letter-spacing:-.045em;
  }
  .description { margin:var(--space-3) 0 0; color:var(--text-muted); font-size:1rem; }
</style>
