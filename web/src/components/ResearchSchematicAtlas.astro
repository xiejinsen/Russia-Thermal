 .map-key{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:11px;color:#cce0ef;padding:14px 1px 4px}.map-key i{display:inline-block;background:#63d5f8;width:9px;height:9px;border-radius:50%;margin-right:6px}
 .cartography-note{font-size:11px;line-height:1.65;color:#b6d4e5;margin:12px 0 0}.cartography-note strong{color:#f1faff}
 .focus-list{display:grid;gap:10px;align-self:start}.focus-card{min-width:0;overflow:hidden;border:1px solid #2d779b;background:linear-gradient(135deg,#124969,#082c4a);border-radius:12px;box-shadow:0 7px 22px #0003}
 .focus-main{display:grid;grid-template-columns:minmax(100px,33%) minmax(0,1fr);text-decoration:none;color:#f1fbff;min-height:137px}.focus-main:focus-visible{outline:3px solid #9ff2ff;outline-offset:-4px}
 .focus-media{position:relative;min-height:110px;background:#0c3857;overflow:hidden}.focus-media img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;filter:brightness(.9) saturate(.85)}.focus-media:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,#082c4b55)}
 .focus-number{position:absolute;z-index:1;top:9px;left:10px;font-size:21px;font-weight:850;text-shadow:0 1px 6px #000}
