---
import type { ResearchMapVM } from '../types/view-models';
import { actors } from '../data/load-normalized';

interface Props { vm: ResearchMapVM; country: 'RU' | 'CN'; }
const {vm, country} = Astro.props;
const isRussia = country === 'RU';
const base = import.meta.env.BASE_URL;
const href = (path:string) => path === '/' ? base : base + path.replace(/^\//,'');
const photos: Record<string, {file:string; author:string; license:string}> = {
 'ACT-KUTATELADZE':{file:'Institute_of_Thermophysics.jpg',author:'Obakeneko',license:'CC BY 3.0'},
 'ACT-MPEI':{file:'Moscow_Power_Engineering_Institute_main_Building_1.jpg',author:'Qweasdqwe',license:'CC0'},
 'ACT-TPU':{file:'Главный_корпус_ТПУ_(Томск).jpg',author:'Павел Андрющенко',license:'CC BY-SA 3.0'},
 'ACT-TSU':{file:'2018-11-10_0002_-_Главный_корпус_ТГУ.jpg',author:'Александр Рауш',license:'CC BY-SA 4.0'}
};
const canonical = isRussia
 ? ['ACT-MPEI','ACT-KUTATELADZE','ACT-TPU','ACT-TSU']
 : ['ACT-PKU','ACT-SEU','ACT-SJTU','ACT-SCUT'];
const nodeById = new Map(vm.nodes.map(n=>[n.actorId,n]));
const actorById = new Map(actors.map(a=>[a.id,a]));
const selected = canonical.map(id=>{
 const node=nodeById.get(id);
 const actor=actorById.get(id);
 if(!actor)return null;
 return {
   id,name:node?.name??actor.name,city:node?.city??actor.city??'城市尚未核实',
   latitude:node?.latitude??actor.latitude??undefined,longitude:node?.longitude??actor.longitude??undefined,
   href:href('/institutions/'+id),
   priority:node?.priorityRank,capabilityCount:node?.capabilityCount??0,
   scholarCount:node?.scholarCount??0,description:actor.atlasProfile?.leadershipSummary??actor.researchRelevance??'',
   photo:photos[id]
 };
}).filter((n):n is NonNullable<typeof n>=>Boolean(n));
const bounds=isRussia?{west:17,east:191,north:84,south:40}:{west:73,east:135,north:55,south:17};
function pin(latitude?:number,longitude?:number) {
 if(typeof latitude!=='number'||typeof longitude!=='number')return null;
 const lon=isRussia&&longitude<0?longitude+360:longitude;
 const x=35+(lon-bounds.west)/(bounds.east-bounds.west)*930;
 const y=26+(bounds.north-latitude)/(bounds.north-bounds.south)*370;
 if(!Number.isFinite(x)||!Number.isFinite(y)||x<0||x>1000||y<0||y>430)return null;
 return {x,y};
}
// The Tomsk State University root record has no verified campus coordinates.
// Show its affiliation with the Tomsk *city cluster*, never an invented campus pin.
const positions = selected.map((item,i)=>{
 let actual=pin(item.latitude,item.longitude);
 let cityOnly=false;
 if(!actual&&item.id==='ACT-TSU'){
  const tomsk=selected.find(other=>other.city.toLowerCase()==='tomsk'&&other.id!==item.id&&typeof other.latitude==='number'&&typeof other.longitude==='number');
  if(tomsk){actual=pin(tomsk.latitude,tomsk.longitude);cityOnly=true;}
 }
 const offsets=isRussia
  ? [[-33,-77],[-114,-92],[90,-54],[115,66]]
  : [[-73,-70],[-90,-64],[93,62],[85,-60]];
 const [dx,dy]=offsets[i]??[0,-65];
 const lx=actual?Math.max(74,Math.min(901,actual.x+dx)):0;
 const ly=actual?Math.max(47,Math.min(361,actual.y+dy)):0;
 return {...item,i,actual,cityOnly,marker:{x:lx,y:ly},number:String(i+1).padStart(2,'0')};
});
const visiblePositions=positions.filter(item=>item.actual!==null);
const contextNodes=vm.nodes
 .filter(node=>!canonical.includes(node.actorId))
 .map(node=>({id:node.actorId,name:node.name,city:node.city,actual:pin(node.latitude,node.longitude)}))
 .filter((node):node is typeof node & {actual:{x:number,y:number}}=>Boolean(node.actual));
const cityOptions=[...new Set(vm.nodes.map(n=>n.city))].sort((a,b)=>a.localeCompare(b));
const directions=[...new Map(vm.nodes.flatMap(n=>n.directions).map(d=>[d.id,d])).values()];
const catalog=vm.nodes.map(n=>({...n,
  link:href(n.href),
  searchable:[n.name,n.city,n.region??'',...n.keyPeople.map(p=>p.name),...n.directions.map(d=>d.title)].join(' ').toLowerCase(),
  directionIds:n.directions.map(d=>d.id).join('|')
}));
---
<div class="schematic-root" data-schematic-root>
 <header class="atlas-hero">
  <div class="atlas-intro">
   <p class="kicker">{isRussia?'RUSSIAN RESEARCH LANDSCAPE':'CHINA COMPARATOR LANDSCAPE'} / VISUAL RESEARCH ATLAS</p>
   <h1>{isRussia?'俄罗斯热管理科研版图':'中国热管理研究对照版图'}</h1>
   <p class="english">{isRussia?'Organizations · People · Capabilities · Original Evidence':'Comparator Organizations · Capabilities · Evidence'}</p>
   <p class="lead">{isRussia?'从城市集群认识俄罗斯研究机构：谁在研究什么、关联哪些学者，以及哪些结论尚不能直接迁移到手机热管理。':'以中国研究机构作为学术与工程对照基线。这里展示已收录样本的研究位置与证据关联，不推断全国科研强弱。'}</p>
   <div class="metrics">
    <div><strong>{vm.mappedActorCount}</strong><span>有位置记录的根机构</span></div>
    <div><strong>{vm.scholarCount}</strong><span>关联人物记录</span></div>
    <div><strong>{vm.capabilityCount}</strong><span>关联技术能力</span></div>
    <div><strong>{vm.unmappedActorCount}</strong><span>位置待核验</span></div>
   </div>
  </div>
  <aside class="hero-context">
   <div class="scope-mark">EVIDENCE / BOUNDARY</div>
   <h2>地图展示的是研究分布，不是实力排名</h2>
   <p>节点对应有位置记录的机构，数字和卡片用于关联阅读；研究能力与手机工程价值必须通过原始证据链独立评估。</p>
   <a href={href(isRussia?'/russia-atlas':'/landscape')}>{isRussia?'进入完整俄罗斯能力 Atlas':'查看中俄及国际研究对照'} ↗</a>
  </aside>
 </header>

 <section class="visual-atlas" aria-labelledby="infographic-title">
  <div class="section-line"><div><p class="kicker">01 / RESEARCH NETWORK</p><h2 id="infographic-title">{isRussia?'科研城市与代表机构':'研究对照机构与区域节点'}</h2></div><span>GEO-REFERENCED OUTLINE · EDITORIAL INFOGRAPHIC</span></div>
  <div class="atlas-columns">
   <div class="map-pane">
    <div class="map-graphic">
     <img class="country-outline" src={href('/assets/'+(isRussia?'russia':'china')+'-editorial-outline.svg')} alt={isRussia?'俄罗斯真实轮廓构成的科研版图背景':'中国真实轮廓构成的科研版图背景'} loading="eager"/>
     <svg class="location-overlay" viewBox="0 0 1000 430" role="img" aria-label={isRussia?'俄罗斯科研机构地点与机构编号：01莫斯科、02新西伯利亚、03及04托木斯克城市集群':'中国科研机构地点与编号：01北京、02南京、03上海、04广州'}>
      <defs>
       <filter id={isRussia?'ru-marker-halo':'cn-marker-halo'} x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="7"/>
       </filter>
      </defs>
      {contextNodes.map(node=><g class="context-position" aria-label={node.name+' · '+node.city}>
       <circle cx={node.actual.x} cy={node.actual.y} r="4" fill="#57afcf" stroke="#a8e7ff" stroke-width="1.2"/>
      </g>)}
      {visiblePositions.map(item=><g class="pin-group">
       <circle cx={item.actual!.x} cy={item.actual!.y} r="14" fill="#38d7ff" opacity=".45" filter={'url(#'+(isRussia?'ru-marker-halo':'cn-marker-halo')+')'}/>
       <circle class="true-location-dot" cx={item.actual!.x} cy={item.actual!.y} r="6" fill="#e8fbff" stroke="#17afe6" stroke-width="2"/>
       <path class="pin-leader" d={'M '+item.actual!.x+' '+item.actual!.y+' L '+item.marker.x+' '+item.marker.y} fill="none" stroke={item.cityOnly?'#9dd1e6':'#52d7f9'} stroke-dasharray={item.cityOnly?'5 5':undefined} stroke-width="2"/>
       <a class="feature-pin" href={'#atlas-feature-'+item.number} aria-label={item.number+' '+item.name+' · '+item.city+(item.cityOnly?' 城市集群示意':' 地理坐标')+'，查看下方图文简介'}>
        <title>{item.name} · {item.city}{item.cityOnly?' · 城市集群示意，不代表精确校舍坐标':''}</title>
        <rect class="pin-label-bg" x={item.marker.x-23} y={item.marker.y-18} width="46" height="36" rx="10" fill="#082945" stroke="#74e8ff" stroke-width="2"/>
        <text x={item.marker.x} y={item.marker.y+5} fill="#f5fdff" font-size="17" font-weight="800" text-anchor="middle">{item.number}</text>
        <text class="pin-city-label" x={item.marker.x+(item.marker.x>760?-33:33)} y={item.marker.y-3} text-anchor={item.marker.x>760?'end':'start'}>{item.city.toUpperCase()}</text>
        <text class="pin-actor-label" x={item.marker.x+(item.marker.x>760?-33:33)} y={item.marker.y+14} text-anchor={item.marker.x>760?'end':'start'}>{item.id.replace('ACT-','')}{item.cityOnly?' · CITY CLUSTER':''}</text>
       </a>
      </g>)}
     </svg>
     <div class="map-footnote">{isRussia?'RUSSIA':'CHINA'} / GEOREFERENCED SCIENCE · EDITORIAL LANDSCAPE</div>
    </div>
    <div class="map-key">
     <span><i class="primary-dot"></i> 编号 = 下方机构卡片</span>
     <span><i class="secondary-dot"></i> 小点 = 其他有坐标的机构</span>
     <span>引线从实际地理位置延伸至错位展示标签</span>
    </div>
    <p class="cartography-note">基于已归档地理坐标与静态地图轮廓生成，非 GIS 地图。{isRussia?'Tomsk State University 暂无独立核实坐标，04 号仅表示 Tomsk 城市集群；虚线不表示校舍位置。':''} <strong>引线用于阅读，不表示机构之间存在合作。</strong></p>
   </div>
   <div class="feature-header"><span>FEATURED / 代表机构</span><strong>点击地图编号定位介绍；点击卡片进入对应机构档案</strong></div>
   <div class="focus-list">
    {positions.map(item=><article class="focus-card" id={'atlas-feature-'+item.number}>
     <a class="focus-main" href={item.href}>
      <div class="focus-media">
       {item.photo?<img src={'https://commons.wikimedia.org/wiki/Special:FilePath/'+encodeURIComponent(item.photo.file)+'?width=800'} loading="lazy" alt={item.name+'建筑资料照片'}/>:<span class="visual-no-photo" aria-label="无经核验的建筑照片"><b>RESEARCH</b><small>INSTITUTION</small></span>}
       <span class="focus-number">{item.number}</span>
      </div>
      <div class="focus-copy">
       <span class="focus-location">{item.city}{item.cityOnly?' · 城市集群位置示意':''}{item.priority?' · '+item.priority+' 研究优先级':''}</span>
       <h3>{item.name}</h3>
       <p>{item.description || '机构档案包含已记录的研究能力、关联学者及其证据边界。'}</p>
       <span class="focus-bottom">{item.capabilityCount} 能力 · {item.scholarCount} 人物 <em>查看档案 ↗</em></span>
      </div>
     </a>
     {item.photo&&<p class="credit">图像：{item.photo.author} / {item.photo.license} · <a href={'https://commons.wikimedia.org/wiki/File:'+encodeURIComponent(item.photo.file)} target="_blank" rel="noopener noreferrer">原图与授权 ↗</a></p>}
    </article>)}
    {selected.length===0&&<p class="no-data">当前没有可展示的代表机构，详见下方机构及证据目录。</p>}
   </div>
  </div>
 </section>

 <section class="catalog-section" aria-labelledby="directory-title">
  <div class="section-line light"><div><p class="kicker">02 / COMPLETE RESEARCH INDEX</p><h2 id="directory-title">机构、研究人员与能力入口</h2></div><a href={href('/institutions')}>完整机构总目录 ↗</a></div>
  <p class="directory-explain">以下逐项来自研究图谱，不对机构研究水平进行排序。论文关联不等于论文作者归属，也不等于人员现在仍任职于该机构。</p>
  <div class="catalog-controls">
   <label>搜索机构 / 人员 / 研究方向<input type="search" data-filter-search placeholder="例如：dryout / Tomsk / thermal..." autocomplete="off"/></label>
   <label>城市<select data-filter-city><option value="">全部城市</option>{cityOptions.map(city=><option value={city}>{city}</option>)}</select></label>
   <label>关联研究方向<select data-filter-direction><option value="">全部研究方向</option>{directions.map(d=><option value={d.id}>{d.title}</option>)}</select></label>
   <span class="counter" data-filter-count aria-live="polite">{catalog.length} 个机构</span>
  </div>
  <div class="catalog-grid">
   {catalog.map(node=><article class="research-row" data-research-item data-search={node.searchable} data-city={node.city} data-direction={node.directionIds}>
    <div class="row-head"><span>{node.city}</span>{node.priorityRank&&<small>{node.priorityRank} · 合作研究优先级</small>}</div>
    <h3><a href={node.link}>{node.name} <span aria-hidden="true">↗</span></a></h3>
    <p>{node.scholarCount} 个关联人物 · {node.capabilityCount} 项研究能力 · {node.directions.length} 条方向关联</p>
    {node.directions.length>0&&<div class="tags">{node.directions.slice(0,2).map(d=><a href={href('/directions/'+d.id)}>{d.title} ↗</a>)}</div>}
    {node.keyPeople.length>0&&<div class="people-line"><span>关联学者：</span>{node.keyPeople.slice(0,3).map(person=><a href={href(person.href)}>{person.name} ↗</a>)}</div>}
   </article>)}
  </div>
  <p class="no-data" data-filter-empty hidden>没有符合筛选条件的已收录机构。请更改检索条件。</p>
 </section>
 {vm.unmappedActors.length>0&&<section class="coverage-gaps">
  <p class="kicker">LOCATION COVERAGE / OPEN DATA GAPS</p><h2>尚无可信坐标的研究对象</h2>
  <p>以下机构保留在研究目录中，但暂不放置示意节点，避免制造并不存在的精确地理信息。</p>
  <div>{vm.unmappedActors.map(a=><a href={href(a.href)}>{a.name} ↗</a>)}</div>
 </section>}
 <footer class="atlas-outro"><strong>研究结论与手机产品技术判断之间，必须保留证据边界。</strong><p>这是一张研究主题和机构网络的视觉索引；不能从节点数量、地理集中度或机构名气推断设备级散热优势。</p><div><a href={href('/representative-works')}>查阅代表论文 ↗</a><a href={href('/smartphone-transfer')}>手机迁移边界 ↗</a><a href={href('/research-questions')}>Q01–Q10 结题结论 ↗</a></div></footer>
</div>
<script>
 const root=document.querySelector<HTMLElement>('[data-schematic-root]');
 if(root){
  const search=root.querySelector<HTMLInputElement>('[data-filter-search]');
  const city=root.querySelector<HTMLSelectElement>('[data-filter-city]');
  const direction=root.querySelector<HTMLSelectElement>('[data-filter-direction]');
  const entries=[...root.querySelectorAll<HTMLElement>('[data-research-item]')];
  const count=root.querySelector<HTMLElement>('[data-filter-count]');
  const empty=root.querySelector<HTMLElement>('[data-filter-empty]');
  const apply=()=>{
   const q=(search?.value??'').trim().toLowerCase();
   const c=city?.value??'';
   const d=direction?.value??'';
   let visible=0;
   for(const item of entries){
    const ok=(!q||(item.dataset.search??'').includes(q))&&(!c||item.dataset.city===c)&&(!d||(item.dataset.direction??'').split('|').includes(d));
    item.hidden=!ok;
    if(ok)visible++;
   }
   if(count)count.textContent=visible+' / '+entries.length+' 个机构';
   if(empty)empty.hidden=visible!==0;
  };
  [search,city,direction].forEach(control=>{control?.addEventListener('input',apply);control?.addEventListener('change',apply)});
 }
</script>
<style>
 :global(body.theme-immersive) {background:radial-gradient(ellipse at 72% 0,#19527a,transparent 36%),linear-gradient(145deg,#031526,#082e50 55%,#041728);color:#e6f6ff}
 .schematic-root{color:#e8f7ff;max-width:1330px;margin:auto;padding:16px 0 72px}
 .kicker{margin:0;color:#6ed8f5;font-weight:800;font-size:12px;letter-spacing:.12em}
 .atlas-hero{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(245px,.75fr);gap:40px;padding:54px 44px 48px;border-radius:20px 20px 0 0;background:radial-gradient(circle at 12% 20%,#134f79 0%,transparent 45%),linear-gradient(120deg,#092b4c,#04172e);border:1px solid #1c5779}
 .atlas-intro h1{font-size:clamp(30px,4.2vw,58px);color:white;line-height:1.2;margin:20px 0 12px;letter-spacing:-.04em}
 .english{font-size:19px;color:#b3dcf2;font-weight:650;margin:0 0 18px}.lead{font-size:16px;line-height:1.85;max-width:72ch;color:#e2eff8}
 .metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:26px}.metrics div{border-top:2px solid #428ab0;padding-top:10px}.metrics strong{display:block;color:#fff;font-size:24px}.metrics span{font-size:11px;color:#c1dceb}
 .hero-context{align-self:center;padding:24px;background:#0b4065b3;border:1px solid #4189ad;border-radius:15px}.scope-mark{color:#7fe5f6;font-size:11px;letter-spacing:.1em;font-weight:850}.hero-context h2{font-size:21px;line-height:1.35;color:white}.hero-context p{font-size:14px;line-height:1.8;color:#d3e8f5}.hero-context a{font-size:13px;font-weight:750;color:#9debff}
 .visual-atlas{border-inline:1px solid #1c5779;background:linear-gradient(140deg,#072441,#0b3455 50%,#041d37);padding:34px}
 .section-line{display:flex;justify-content:space-between;gap:15px;align-items:end;margin-bottom:22px}.section-line h2{color:white;font-size:26px;line-height:1.3;margin:6px 0 0}.section-line>span{font-size:11px;color:#c1d8e5;letter-spacing:.08em;text-align:right}
 .atlas-columns{display:flex;flex-direction:column;gap:0}
 .map-pane{min-width:0;padding:18px 18px 12px;background:#041f38c9;border:1px solid #387fa1;border-radius:15px 15px 0 0}
 .map-graphic{position:relative;width:100%;aspect-ratio:1000/430;background:radial-gradient(ellipse at 40% 45%,#13527b7a,transparent 72%),repeating-linear-gradient(0deg,transparent 0 31px,#7cccf00d 32px),repeating-linear-gradient(90deg,transparent 0 31px,#7cccf00d 32px);overflow:hidden;border-radius:11px}
 .country-outline{width:100%;height:100%;display:block}
 .location-overlay{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none}
 .location-overlay .feature-pin{pointer-events:all;cursor:pointer}
 .pin-city-label{fill:#f2fcff;font-size:15px;font-weight:800;paint-order:stroke;stroke:#061b31;stroke-width:4px;stroke-linejoin:round}
 .pin-actor-label{fill:#9eeaff;font-size:11px;font-weight:700;paint-order:stroke;stroke:#061b31;stroke-width:3px;stroke-linejoin:round}
 .true-location-dot{filter:drop-shadow(0 0 3px #7df2ff)}
 .pin-label-bg{filter:drop-shadow(0 3px 7px #00172acc)}
 .feature-pin:hover .pin-label-bg,.feature-pin:focus .pin-label-bg{fill:#167da9;stroke:#eaffff;stroke-width:3}
 .feature-pin:focus{outline:none}
 .map-footnote{position:absolute;right:14px;bottom:12px;letter-spacing:.13em;color:#daf0fc;font-size:11px;background:#062a4688;padding:5px 9px;border-radius:5px}
 .map-key{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:12px;color:#cfe6f2;padding:17px 2px 7px}
 .map-key i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px;vertical-align:middle}
 .map-key .primary-dot{background:#aaf4ff;box-shadow:0 0 0 3px #53c8ed61}
 .map-key .secondary-dot{background:#57afcf}
 .cartography-note{font-size:12px;line-height:1.75;color:#d4e9f4;margin:10px 0 0}
 .cartography-note strong{color:#f5fcff}
 .feature-header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:23px 4px 16px}
 .feature-header span{font-size:12px;letter-spacing:.12em;color:#70ddf3;font-weight:850}
 .feature-header strong{font-size:13px;color:#dcecf7;font-weight:600}
 .focus-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;align-items:stretch}
 .focus-card{min-width:0;display:flex;flex-direction:column;overflow:hidden;border:1px solid #3c81a2;background:linear-gradient(148deg,#154f75,#082640);border-radius:12px;box-shadow:0 7px 22px #0003;scroll-margin-top:100px}
 .focus-card:target{outline:3px solid #80e6fd;outline-offset:3px}
 .focus-main{display:flex;flex-direction:column;flex:1;text-decoration:none;color:#f1fbff}
 .focus-main:focus-visible{outline:3px solid #9ff2ff;outline-offset:-4px}
 .focus-media{position:relative;height:150px;background:#0c3857;overflow:hidden}
 .focus-media img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;filter:brightness(.92) saturate(.86)}
