 .credit{font-size:10px;line-height:1.6;margin:0;color:#c3dce9;padding:0 12px 8px}.credit a{color:#a6edff}
 .catalog-section{background:#eaf4fb;color:#18334b;padding:42px 38px;border-inline:1px solid #b5d3e5}.section-line.light h2{color:#17334b}.section-line.light .kicker{color:#0d6088}.section-line.light a{color:#075b86;font-size:13px;font-weight:800}
 .directory-explain{max-width:950px;font-size:14px;line-height:1.8;color:#40596c}
 .catalog-controls{display:flex;align-items:end;gap:12px;flex-wrap:wrap;margin:23px 0;padding:20px;border:1px solid #c0d5e3;background:#f7fbff;border-radius:12px}.catalog-controls label{display:grid;gap:7px;flex:1;min-width:175px;font-size:12px;font-weight:800;color:#284e6b}.catalog-controls input,.catalog-controls select{border:1px solid #9bb9ca;background:white;border-radius:7px;padding:11px;color:#142f45;font-size:14px;min-width:0;width:100%}.counter{font-size:13px;font-weight:800;color:#175f86}
 .catalog-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.research-row{padding:22px;border:1px solid #c0d4e2;border-radius:13px;background:#fff;min-width:0}.research-row[hidden]{display:none}.row-head{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between}.row-head span{font-weight:850;color:#145d86;font-size:11px;text-transform:uppercase}.row-head small{font-size:10px;color:#48667b}.research-row h3{font-size:17px;line-height:1.45;margin:9px 0}.research-row h3 a{color:#133a58;text-decoration:none}.research-row h3 a:hover{text-decoration:underline}.research-row>p{color:#486073;font-size:12px;margin:0 0 10px}.tags{display:flex;gap:7px;flex-wrap:wrap}.tags a{font-size:11px;color:#155e88;background:#e9f4fb;border-radius:30px;text-decoration:none;padding:5px 8px}.people-line{font-size:11px;display:flex;gap:9px;flex-wrap:wrap;border-top:1px solid #deebf3;margin-top:12px;padding-top:12px;color:#425e74}.people-line a{color:#175d87}.no-data{color:#465e70;font-size:13px}
 .coverage-gaps{background:#edf6fb;color:#203950;padding:35px 40px;border-inline:1px solid #b5d3e5}.coverage-gaps .kicker{color:#135a83}.coverage-gaps h2{color:#193954;font-size:24px}.coverage-gaps p{color:#475f73;font-size:14px}.coverage-gaps div{display:flex;flex-wrap:wrap;gap:8px}.coverage-gaps a{padding:9px 12px;text-decoration:none;background:#fff;border:1px solid #cbdbe7;border-radius:8px;font-size:12px;color:#175b83}
