---
interface Props {
  russia: number;
  comparator: number;
  deepReads: number;
  total: number;
  papers?: number;
  patents?: number;
  baseline?: string;
  residual?: string;
}
const { russia, comparator, deepReads, total, papers = 0, patents = 0, baseline, residual } = Astro.props;
const max = Math.max(russia, comparator, 1);
---
<section class="pressure">
  <header>
    <div>
      <p>Evidence pressure</p>
      <h2>Is the conclusion surviving comparison, or only self-confirming?</h2>
    </div>
    <div class="counts"><b>{total}</b><span>reachable sources</span></div>
  </header>

  <div class="pressure-grid">
    <div class="bars">
      <div class="bar-row">
        <div class="bar-label"><b>Russia</b><span>{russia} sources</span></div>
        <div class="track"><i style={`width:${Math.max((russia/max)*100,4)}%`}></i></div>
      </div>
      <div class="bar-row comparator">
        <div class="bar-label"><b>China / global</b><span>{comparator} sources</span></div>
        <div class="track"><i style={`width:${Math.max((comparator/max)*100,4)}%`}></i></div>
      </div>
      <div class="micro">
        <span><b>{deepReads}</b> Deep Reads</span>
        <span><b>{papers}</b> papers</span>
        <span><b>{patents}</b> patents</span>
      </div>
    </div>

    {(baseline || residual) && <div class="pressure-copy">
      {baseline && <article><span>Strongest baseline</span><p>{baseline}</p></article>}
      {residual && <article class="residual"><span>Surviving residual</span><p>{residual}</p></article>}
    </div>}
  </div>
</section>

<style>
  .pressure{
    border:1px solid var(--line);
    border-radius:1rem;
    background:var(--surface);
    overflow:hidden;
  }
  header{
    display:flex;
    justify-content:space-between;
    gap:1rem;
    align-items:end;
    padding:1rem 1.1rem;
    border-bottom:1px solid var(--line);
    background:#f8fbfe;
  }
  header p{
    margin:0;
    color:var(--accent-vivid);
    font-size:.64rem;
    font-weight:850;
    letter-spacing:.1em;
    text-transform:uppercase;
  }
  h2{margin:.25rem 0 0;font-size:1rem;line-height:1.3;letter-spacing:-.025em}
  .counts{text-align:right;white-space:nowrap}
  .counts b{display:block;font-size:1.3rem;color:#16496d}
  .counts span{font-size:.65rem;color:#6a8192}
  .pressure-grid{
    display:grid;
    grid-template-columns:minmax(16rem,.75fr) minmax(0,1.25fr);
    gap:0;
  }
  .bars{padding:1.05rem;border-right:1px solid var(--line)}
  .bar-row{display:grid;grid-template-columns:7.4rem 1fr;gap:.7rem;align-items:center;margin-bottom:.85rem}
  .bar-label{display:grid}
  .bar-label b{font-size:.76rem}
  .bar-label span{font-size:.65rem;color:#73899a}
  .track{height:.48rem;border-radius:999px;background:#e9f0f5;overflow:hidden}
  .track i{display:block;height:100%;border-radius:inherit;background:#4f8fbf}
  .comparator .track i{background:#63a88e}
  .micro{display:flex;gap:.4rem;flex-wrap:wrap;margin-top:.35rem}
  .micro span{padding:.32rem .45rem;border-radius:.4rem;background:#f2f7fa;color:#62798a;font-size:.65rem}
  .micro b{color:#244b66}
  .pressure-copy{display:grid;grid-template-columns:1fr 1fr}
  .pressure-copy article{padding:1rem 1.05rem}
  .pressure-copy article+article{border-left:1px solid var(--line)}
  .pressure-copy span{
    color:#0b67b2;
    font-size:.62rem;
    font-weight:850;
    letter-spacing:.08em;
    text-transform:uppercase;
  }
  .pressure-copy .residual span{color:var(--positive)}
  .pressure-copy p{margin:.4rem 0 0;color:var(--text-muted);font-size:.78rem;line-height:1.6}
  @media(max-width:840px){
    .pressure-grid,.pressure-copy{grid-template-columns:1fr}
    .bars{border-right:0;border-bottom:1px solid var(--line)}
    .pressure-copy article+article{border-left:0;border-top:1px solid var(--line)}
  }
</style>
