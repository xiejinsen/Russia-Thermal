---
interface Props {
  eyebrow: string;
  title: string;
  summary?: string;
  meta?: string[];
  badge?: string;
  badgeTone?: 'neutral' | 'positive' | 'warning' | 'critical';
}
const {
  eyebrow,
  title,
  summary,
  meta = [],
  badge,
  badgeTone = 'neutral'
} = Astro.props;
---
<section class="detail-hero">
  <div class="detail-copy">
    <div class="detail-kicker">
      <p>{eyebrow}</p>
      {badge && <span class:list={['badge', `tone-${badgeTone}`]}>{badge}</span>}
    </div>
    <h1>{title}</h1>
    {meta.length > 0 && <div class="meta-row">{meta.map((item) => <span>{item}</span>)}</div>}
    {summary && <p class="summary">{summary}</p>}
    <div class="actions"><slot name="actions" /></div>
  </div>
  <aside class="hero-aside"><slot name="aside" /></aside>
</section>

<style>
  .detail-hero {
    display:grid;
    grid-template-columns:minmax(0,1.55fr) minmax(17rem,.55fr);
    gap:1rem;
    padding:1.5rem;
    border:1px solid var(--line);
    border-radius:1.15rem;
    background:
      linear-gradient(135deg, rgb(255 255 255 / .98), rgb(244 250 255 / .96)),
      var(--surface);
    box-shadow:var(--shadow-1);
  }
  .detail-copy{min-width:0}
  .detail-kicker{display:flex;gap:.65rem;align-items:center;flex-wrap:wrap}
  .detail-kicker p{
    margin:0;
    font-size:.68rem;
    font-weight:850;
    letter-spacing:.12em;
    text-transform:uppercase;
    color:var(--accent-vivid);
  }
  .badge{
    padding:.28rem .48rem;
    border:1px solid var(--line);
    border-radius:999px;
    font-size:.65rem;
    font-weight:850;
    line-height:1;
  }
  .tone-neutral{background:#f2f6f9;color:#536a7c}
  .tone-positive{background:#ecf8f3;color:var(--positive);border-color:#c8e7db}
  .tone-warning{background:#fbf5e8;color:var(--warning);border-color:#ead9af}
  .tone-critical{background:#fbefef;color:var(--critical);border-color:#e9c7c7}
  h1{
    max-width:24ch;
    margin:.55rem 0 0;
    font-size:clamp(1.9rem,3.5vw,3rem);
    line-height:1.02;
    letter-spacing:-.05em;
  }
  .meta-row{display:flex;gap:.45rem;flex-wrap:wrap;margin-top:.8rem}
  .meta-row span{
    padding:.28rem .45rem;
    border-radius:.38rem;
    background:var(--surface-muted);
    color:var(--text-secondary);
    font-size:.7rem;
    font-weight:750;
  }
  .summary{
    max-width:76ch;
    margin:1rem 0 0;
    color:var(--text-muted);
    font-size:.95rem;
    line-height:1.7;
  }
  .actions{margin-top:1rem}
  .hero-aside{
    min-width:0;
    display:flex;
    align-items:stretch;
  }
  .hero-aside:empty{display:none}
  @media(max-width:800px){
    .detail-hero{grid-template-columns:1fr;padding:1.15rem}
    h1{font-size:clamp(1.65rem,8vw,2.35rem)}
  }
</style>
