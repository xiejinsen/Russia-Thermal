---
interface Node {
  label: string;
  value: string | number;
  href?: string;
  note?: string;
}
interface Props {
  nodes: Node[];
  title?: string;
}
const { nodes, title = 'Evidence chain' } = Astro.props;
---
<section class="relation-path">
  <header>
    <p>{title}</p>
    <span>Follow how this item connects to the evidence and decision chain</span>
  </header>
  <div class="path">
    {nodes.map((node, index) => (
      <>
        <div class="node">
          <span>{node.label}</span>
          {node.href ? <a href={node.href}>{node.value}</a> : <b>{node.value}</b>}
          {node.note && <small>{node.note}</small>}
        </div>
        {index < nodes.length - 1 && <i aria-hidden="true">→</i>}
      </>
    ))}
  </div>
</section>

<style>
  .relation-path{
    border:1px solid var(--line);
    border-radius:.9rem;
    background:#fbfdff;
    overflow:hidden;
  }
  header{
    display:flex;
    justify-content:space-between;
    gap:1rem;
    padding:.72rem .9rem;
    border-bottom:1px solid var(--line);
  }
  header p{margin:0;font-size:.78rem;font-weight:850;color:#244f6c}
  header span{font-size:.72rem;color:#526a7c}
  .path{
    display:flex;
    gap:.45rem;
    align-items:stretch;
    overflow-x:auto;
    padding:.75rem;
  }
  .node{
    min-width:8.5rem;
    flex:1 0 8.5rem;
    padding:.7rem .75rem;
    border:1px solid #dce8f1;
    border-radius:.65rem;
    background:white;
  }
  .node>span{display:block;font-size:.65rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase;color:#718798}
  .node b,.node a{display:block;margin-top:.18rem;color:#153f5e;font-size:.9rem;font-weight:850;text-decoration:none}
  .node a:hover{text-decoration:underline;text-underline-offset:.14em}
  .node small{display:block;margin-top:.2rem;color:#526a7c;font-size:.72rem;line-height:1.4}
  .path>i{align-self:center;color:#8fa6b7;font-style:normal;font-weight:900}
</style>
