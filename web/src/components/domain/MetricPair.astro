---
interface Props {
  label: string;
  value: string | number;
  href?: string;
}
const { label, value, href } = Astro.props;
---

{href ? (
  <div class="metric">
    <span class="label">{label}</span>
    <a class="value-link" href={href} aria-label={`Browse ${label} collection`}>{value}</a>
  </div>
) : (
  <div class="metric">
    <dt>{label}</dt>
    <dd>{value}</dd>
  </div>
)}

<style>
  .metric { display:grid; gap:var(--space-1); min-width:0; }
  dt,.label {
    color:var(--text-muted);
    font-size:.72rem;
    font-weight:750;
    letter-spacing:.07em;
    text-transform:uppercase;
  }
  dd,.value-link {
    margin:0;
    width:fit-content;
    color:var(--text);
    font-size:clamp(1.2rem,2vw,1.7rem);
    font-weight:850;
    line-height:1;
    letter-spacing:-.035em;
  }
  .value-link {
    text-decoration:none;
    border-radius:.35rem;
  }
  .value-link:hover,.value-link:focus-visible {
    color:var(--accent-vivid);
    text-decoration:underline;
    text-underline-offset:.16em;
  }
</style>
