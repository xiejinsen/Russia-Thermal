---
interface Props {
  label: string;
  value: string | number;
}

const { label, value } = Astro.props;
---

<div class="metric">
  <dt>{label}</dt>
  <dd>{value}</dd>
</div>

<style>
  .metric {
    display: grid;
    gap: var(--space-1);
  }

  dt {
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    font-weight: 700;
  }
</style>
