---
import MetricPair from './domain/MetricPair.astro';
import type { CapabilityDetailVM } from '../types/view-models';

interface Props {
  model: CapabilityDetailVM;
}

const { model } = Astro.props;
---

<article class="capability">
  <p class="eyebrow">{model.id}</p>
  <h3>{model.statement}</h3>

  <dl class="metrics">
    <MetricPair label="Maturity" value={model.maturity} />
    <MetricPair label="Evidence confidence" value={model.evidenceConfidence} />
    <MetricPair label="Target fit" value={model.targetFit} />
  </dl>

  {model.technicalScope.length > 0 && (
    <div>
      <strong>Technical scope</strong>
      <ul>
        {model.technicalScope.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  )}

  {model.transferBoundary && (
    <div class="note">
      <strong>Transfer boundary</strong>
      <p>{model.transferBoundary}</p>
    </div>
  )}

  {model.strategicUse && (
    <div class="note">
      <strong>Strategic use</strong>
      <p>{model.strategicUse}</p>
    </div>
  )}
</article>

<style>
  .capability {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  h3, p { margin: 0; }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding-block: var(--space-4);
    border-block: 1px solid var(--line);
  }

  ul {
    margin: var(--space-2) 0 0;
    padding-left: 1.2rem;
  }

  .note {
    display: grid;
    gap: var(--space-2);
  }

  .note p { color: var(--text-muted); }
</style>
