---
interface LinkItem {
  label: string;
  href: string;
  primary?: boolean;
}

interface Props {
  links: LinkItem[];
  ariaLabel?: string;
  align?: 'start' | 'end';
}

const {
  links,
  ariaLabel = 'Explore related research objects',
  align = 'start'
} = Astro.props;
---

<nav class:list={['explorer-link-strip', `align-${align}`]} aria-label={ariaLabel}>
  {links.map((item) => (
    <a class:list={{ primary: item.primary }} href={item.href}>{item.label}</a>
  ))}
</nav>

<style>
  .explorer-link-strip {
    display: flex;
    gap: .45rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .align-end { justify-content: flex-end; }

  a {
    padding: .42rem .58rem;
    border: 1px solid var(--line);
    border-radius: .48rem;
    background: var(--surface);
    color: var(--accent);
    font-size: .72rem;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  a:hover,
  a:focus-visible {
    background: var(--accent-soft);
    color: var(--accent-vivid);
    outline: none;
  }

  a.primary {
    border-color: #b9d7ea;
    background: #edf7fd;
    color: #0b67b2;
  }

  @media (max-width: 720px) {
    .align-end { justify-content: flex-start; }
  }
</style>
