---
const base = import.meta.env.BASE_URL;
const href = (path: string) => path === '/' ? base : `${base}${path.replace(/^\//, '')}`;

const pathname = Astro.url.pathname;
const basePath = base.endsWith('/') ? base.slice(0, -1) : base;
const route = pathname.startsWith(basePath) ? pathname.slice(basePath.length) || '/' : pathname;
const normalize = (path: string) => path === '/' ? '/' : path.replace(/\/$/, '');
const currentRoute = normalize(route);
const isActivePath = (path: string) => {
  const target = normalize(path);
  return target === '/' ? currentRoute === '/' : currentRoute === target || currentRoute.startsWith(target + '/');
};

const groups = [
  { label: 'Overview', path: '/' },
  {
    label: 'Decide',
    children: [
      { label: 'Partner Portfolio', path: '/partners' },
      { label: 'Directions', path: '/directions' },
      { label: 'Russia vs China', path: '/landscape' },
      { label: 'Decisions', path: '/decisions' }
    ]
  },
  {
    label: 'Explore',
    children: [
      { label: 'Research Coverage', path: '/research-coverage' },
      { label: 'Research Maps', path: '/research-map' },
      { label: 'Institutions', path: '/institutions' },
      { label: 'Scholars', path: '/scholars' },
      { label: 'Capabilities', path: '/capabilities' }
    ]
  },
  {
    label: 'Audit',
    children: [
      { label: 'Claims', path: '/claims' },
      { label: 'Papers', path: '/papers' },
      { label: 'Evidence', path: '/evidence' },
      { label: 'Frontier Watch', path: '/frontier' }
    ]
  }
];

const activeGroup = groups.find((item) =>
  item.path ? isActivePath(item.path) : item.children?.some((child) => isActivePath(child.path))
);
const activeChild = activeGroup && !activeGroup.path
  ? activeGroup.children?.find((child) => isActivePath(child.path))
  : undefined;
const locationLabel = activeGroup && activeChild
  ? `${activeGroup.label} · ${activeChild.label}`
  : activeGroup?.label ?? 'Research Intelligence';
---

<header class="site-header">
  <div class="inner">
    <div class="brand-area">
      <a class="brand" href={href('/')}>Russia-Thermal</a>
      <span class="location-chip">{locationLabel}</span>
    </div>

    <nav aria-label="Primary navigation">
      {groups.map((item) => item.path ? (
        <a class:list={['top-link', { active: isActivePath(item.path) }]} href={href(item.path)} aria-current={isActivePath(item.path) ? 'page' : undefined}>{item.label}</a>
      ) : (
        <details class:list={['nav-group', { 'is-active': item.children?.some((child) => isActivePath(child.path)) }]} data-nav-group>
          <summary>{item.label}<span aria-hidden="true">⌄</span></summary>
          <div class="menu">
            {item.children?.map((child) => <a class:list={{ active: isActivePath(child.path) }} href={href(child.path)} aria-current={isActivePath(child.path) ? 'page' : undefined}>{child.label}</a>)}
          </div>
        </details>
      ))}
    </nav>
  </div>
</header>

<script>
  const navGroups = document.querySelectorAll('[data-nav-group]');
  const desktop = window.matchMedia('(hover: hover) and (pointer: fine)');

  navGroups.forEach((group) => {
    let closeTimer: number | undefined;

    const openGroup = () => {
      if (!desktop.matches) return;
      clearTimeout(closeTimer);
      navGroups.forEach((other) => {
        if (other !== group) other.removeAttribute('open');
      });
      group.setAttribute('open', '');
    };

    const closeGroup = () => {
      if (!desktop.matches) return;
      clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        if (!group.matches(':hover') && !group.matches(':focus-within')) {
          group.removeAttribute('open');
        }
      }, 120);
    };

    group.addEventListener('mouseenter', openGroup);
    group.addEventListener('mouseleave', closeGroup);
    group.addEventListener('focusin', openGroup);
    group.addEventListener('focusout', closeGroup);
  });

  document.addEventListener('click', (event) => {
    if (!desktop.matches) return;
    navGroups.forEach((group) => {
      const target = event.target;
      if (!(target instanceof Node) || !group.contains(target)) group.removeAttribute('open');
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--line);
    background: rgb(248 252 255 / 0.94);
    backdrop-filter: blur(18px);
  }

  .inner {
    width: min(calc(100% - 2rem), var(--content-max));
    margin: 0 auto;
    min-height: 2.7rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand-area {
    display: flex;
    align-items: center;
    gap: .65rem;
    min-width: 0;
    flex: 0 0 auto;
  }

  .brand {
    flex: 0 0 auto;
    color: #183b58;
    font-weight: 800;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .location-chip {
    max-width: 15rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: .2rem .42rem;
    border: 1px solid #d8e7f1;
    border-radius: 999px;
    background: #eef6fb;
    color: #4d6f87;
    font-size: .63rem;
    font-weight: 800;
    letter-spacing: .02em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: .3rem;
  }

  .top-link,
  summary {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    min-height: 1.9rem;
    padding: 0 .62rem;
    border-radius: .6rem;
    color: #35546c;
    font-size: .79rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }

  summary::-webkit-details-marker { display: none; }

  .top-link:hover,
  .top-link:focus-visible,
  .top-link.active,
  summary:hover,
  summary:focus-visible,
  details[open] > summary,
  .nav-group.is-active > summary {
    background: #eaf4fb;
    color: #0b67b2;
    outline: none;
  }

  .nav-group {
    position: relative;
  }

  .menu {
    position: absolute;
    top: calc(100% + .45rem);
    right: 0;
    min-width: 12.5rem;
    padding: .45rem;
    border: 1px solid #d4e4ef;
    border-radius: .75rem;
    background: #fff;
    box-shadow: 0 14px 34px rgb(31 76 112 / 0.12);
  }

  .menu a {
    display: block;
    padding: .62rem .72rem;
    border-radius: .5rem;
    color: #35546c;
    font-size: .8rem;
    font-weight: 650;
    text-decoration: none;
  }

  .menu a:hover,
  .menu a:focus-visible,
  .menu a.active {
    background: #f0f7fc;
    color: #0b67b2;
    outline: none;
  }

  @media (max-width: 860px) {
    .inner {
      align-items: flex-start;
      flex-direction: column;
      padding-block: .45rem;
    }

    .location-chip { max-width: 11rem; }

    nav {
      width: 100%;
      overflow-x: auto;
      padding-bottom: .15rem;
    }

    .nav-group {
      position: static;
    }

    .menu {
      position: fixed;
      left: 1rem;
      right: 1rem;
      top: 6.4rem;
      min-width: 0;
      z-index: 120;
    }
  }
</style>
