---
const base = import.meta.env.BASE_URL;
const href = (path: string) => path === '/' ? base : `${base}${path.replace(/^\//, '')}`;

const items = [
  { label: 'Overview', path: '/' },
  { label: 'Capabilities', path: '/capabilities' },
  { label: 'Labs', path: '/institutions' },
  { label: 'Key People', path: '/scholars' },
  { label: 'Partners', path: '/partners' },
  { label: 'Russia vs China', path: '/landscape' },
  { label: 'Evidence', path: '/evidence' },
  { label: 'Decisions', path: '/decisions' },
  { label: 'Frontier Watch', path: '/frontier' },
  { label: 'Fixtures', path: '/fixtures' }
];
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href={href('/')}>Russia-Thermal</a>
    <nav aria-label="Primary navigation">
      {items.map((item) => <a href={href(item.path)}>{item.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--line);
    background: rgb(248 252 255 / 0.82);
    backdrop-filter: blur(18px);
  }

  .inner {
    width: min(calc(100% - 2rem), var(--content-max));
    margin: 0 auto;
    min-height: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    font-weight: 800;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  nav a {
    color: #263b50;
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--text);
  }

  @media (max-width: 720px) {
    .inner {
      align-items: flex-start;
      flex-direction: column;
      padding-block: var(--space-3);
    }
  }
</style>
