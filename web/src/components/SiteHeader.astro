---
const base=import.meta.env.BASE_URL;
const href=(path:string)=>path==='/'?base:base+path.replace(/^\//,'');
const prefix=base.endsWith('/')?base.slice(0,-1):base;
const pathname=Astro.url.pathname;
const route=pathname.startsWith(prefix)?pathname.slice(prefix.length)||'/':pathname;
const norm=(path:string)=>path==='/'?'/':path.replace(/\/$/,'');
const current=norm(route);

const nav=[
 {label:'首页',path:'/',aliases:[]},
 {label:'科研版图',path:'/research-map',aliases:['/russia-atlas']},
 {label:'研究结论',path: '/research-questions',aliases:['/landscape','/smartphone-transfer','/decisions']},
 {label:'机构与学者',path:'/institutions',aliases:['/scholars']},
 {label:'合作方向',path:'/partners',aliases:['/directions','/research-packages']},
 {label:'全部内容',path:'/site-directory',aliases:[]}
];
function matches(path:string){const target=norm(path);return target==='/'?current==='/':current===target||current.startsWith(target+'/');}
const currentTab=nav.find(item=>item.path!=='/site-directory'&&(matches(item.path)||item.aliases.some(matches)))?.label??(current==='/'?'首页':'全部内容');
---
<header class="site-header" lang="zh-CN">
 <div class="inner">
  <a class="brand" href={href('/')} aria-label="俄罗斯热管理研究 · 首页">
   <span class="brand-cn">俄罗斯热管理研究</span><span class="brand-en">RUSSIA–THERMAL</span>
  </a>
  <nav class="desktop-nav" aria-label="主导航">
   {nav.map(item=><a href={href(item.path)} class:list={{active:currentTab===item.label}}
      aria-current={matches(item.path)?'page':undefined}>{item.label}</a>)}
  </nav>
  <details class="mobile-nav">
   <summary aria-label="展开网站导航">栏目 <span aria-hidden="true">☰</span></summary>
   <nav aria-label="移动端主导航">
    {nav.map(item=><a href={href(item.path)} class:list={{active:currentTab===item.label}}
       aria-current={matches(item.path)?'page':undefined}>{item.label}</a>)}
   </nav>
  </details>
 </div>
</header>
<style>
.site-header{position:sticky;top:0;z-index:100;border-bottom:1px solid #d3e1ec;background:rgb(249 252 255 / .95);backdrop-filter:blur(17px)}
.inner{width:min(calc(100% - 2rem),var(--content-max));min-height:4rem;margin:auto;display:flex;gap:24px;align-items:center;justify-content:space-between}
.brand{min-width:0;display:flex;flex-direction:column;gap:0;text-decoration:none;line-height:1.15;color:#173951;white-space:nowrap}
.brand-cn{font-size:16px;letter-spacing:.01em;font-weight:850}
.brand-en{font-size:9px;letter-spacing:.15em;color:#5a7890;font-weight:750;padding-top:5px}
.desktop-nav{display:flex;align-items:center;gap:4px}
.desktop-nav a,.mobile-nav a{color:#294d67;font-size:14px;font-weight:720;text-decoration:none;white-space:nowrap;border-radius:8px;transition:background .15s,color .15s}
.desktop-nav a{padding:10px 12px}
.desktop-nav a:hover,.desktop-nav a:focus-visible,.desktop-nav a.active{color:#0c5b85;background:#e8f3fa}
.desktop-nav a:focus-visible,.mobile-nav a:focus-visible,.mobile-nav summary:focus-visible{outline:2px solid #249acb;outline-offset:2px}
.mobile-nav{display:none;position:relative}
.mobile-nav summary{display:flex;align-items:center;gap:10px;list-style:none;padding:9px 13px;font-size:14px;font-weight:800;color:#254e69;border-radius:9px;border:1px solid #b8cedd;cursor:pointer}
.mobile-nav summary::-webkit-details-marker{display:none}
.mobile-nav summary span{font-size:18px;line-height:1}
.mobile-nav nav{position:absolute;right:0;top:calc(100% + 9px);width:min(290px,calc(100vw - 34px));display:grid;gap:4px;padding:10px;border:1px solid #c6d9e5;border-radius:12px;background:#fbfdff;box-shadow:0 12px 32px #001b3466}
.mobile-nav a{display:block;padding:12px 14px}
.mobile-nav a:hover,.mobile-nav a:focus-visible,.mobile-nav a.active{color:#075681;background:#e6f3fa}
:global(body.theme-immersive) .site-header{background:rgb(4 25 44 / .96);border-color:#24607f}
:global(body.theme-immersive) .site-header .brand{color:#f0faff}
:global(body.theme-immersive) .site-header .brand-en{color:#afd5e7}
:global(body.theme-immersive) .site-header .desktop-nav a{color:#d3eaf6}
:global(body.theme-immersive) .site-header .desktop-nav a:hover,
:global(body.theme-immersive) .site-header .desktop-nav a:focus-visible,
:global(body.theme-immersive) .site-header .desktop-nav a.active{background:#14577a;color:#fff}
:global(body.theme-immersive) .site-header .mobile-nav summary{color:#edf9ff;background:#104365;border-color:#407da1}
:global(body.theme-immersive) .site-header .mobile-nav nav{background:#082c49;border-color:#377392}
:global(body.theme-immersive) .site-header .mobile-nav a{color:#e5f4fb}
:global(body.theme-immersive) .site-header .mobile-nav a:hover,
:global(body.theme-immersive) .site-header .mobile-nav a.active{color:#fff;background:#145a81}
@media(max-width:920px){.desktop-nav{display:none}.mobile-nav{display:block}.inner{min-height:3.7rem}}
@media(prefers-reduced-motion:reduce){.desktop-nav a,.mobile-nav a{transition:none}}
</style>