---
interface Props {
  href?: string;
  ariaLabel?: string;
}

const { href, ariaLabel } = Astro.props;
---

<article class="dense-object-row" aria-label={ariaLabel}>
  <div class="main"><slot name="main" /></div>
  <div class="details"><slot name="details" /></div>
  <div class="meta"><slot name="meta" /></div>
  <div class="actions">
    <slot name="actions" />
    {href && <a class="open-link" href={href}>Open →</a>}
  </div>
</article>

<style>
  .dense-object-row{
    display:grid;
    grid-template-columns:minmax(18rem,1.25fr) minmax(20rem,1.45fr) minmax(13rem,.8fr) auto;
    gap:18px;
    align-items:start;
    padding:15px 16px;
    border-bottom:1px solid #e2ebf2;
    background:var(--surface);
  }

  .dense-object-row:last-child{border-bottom:0}
  .dense-object-row:hover{background:#fbfdff}

  .main,.details,.meta,.actions{min-width:0}
  .main,.details,.meta{display:grid;gap:6px}
  .actions{display:flex;align-items:flex-start;justify-content:flex-end;gap:6px;flex-wrap:wrap}

  .open-link{
    padding:6px 8px;
    border:1px solid #cfe0eb;
    border-radius:6px;
    background:#edf7fd;
    color:#0b67b2;
    font-size:.67rem;
    font-weight:850;
    text-decoration:none;
    white-space:nowrap;
  }

  .open-link:hover,.open-link:focus-visible{
    background:#e2f1fb;
    text-decoration:underline;
    text-underline-offset:.15em;
  }

  @media(max-width:1100px){
    .dense-object-row{grid-template-columns:minmax(18rem,1fr) minmax(18rem,1fr)}
    .meta,.actions{grid-row:2}
    .actions{justify-content:flex-start}
  }

  @media(max-width:720px){
    .dense-object-row{grid-template-columns:1fr;gap:12px}
    .meta,.actions{grid-row:auto}
  }
</style>
