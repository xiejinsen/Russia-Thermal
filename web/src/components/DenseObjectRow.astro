---
interface Props {
  href?: string;
  ariaLabel?: string;
  layout?: 'content-heavy' | 'detail-heavy' | 'balanced';
}

const { href, ariaLabel, layout = 'balanced' } = Astro.props;
---

<article class:list={['dense-object-row', layout]} aria-label={ariaLabel}>
  <div class="main"><slot name="main" /></div>
  <div class="details"><slot name="details" /></div>
  <div class="meta"><slot name="meta" /></div>
  <div class="actions">
    <div class="action-grid">
      <slot name="actions" />
      {href && <a class="open-link" href={href}>Open →</a>}
    </div>
  </div>
</article>

<style>
  .dense-object-row{
    display:grid;
    gap:14px;
    align-items:start;
    padding:15px 16px;
    border-bottom:1px solid #e2ebf2;
    background:var(--surface);
  }

  .dense-object-row.content-heavy{
    grid-template-columns:minmax(19rem,1.55fr) minmax(14rem,1fr) minmax(10rem,.72fr) 8.75rem;
  }

  .dense-object-row.detail-heavy{
    grid-template-columns:minmax(16rem,.95fr) minmax(22rem,1.6fr) minmax(10rem,.72fr) 8.75rem;
  }

  .dense-object-row.balanced{
    grid-template-columns:minmax(17rem,1.12fr) minmax(17rem,1.12fr) minmax(11rem,.78fr) 8.75rem;
  }

  .dense-object-row:last-child{border-bottom:0}
  .dense-object-row:hover{background:#fbfdff}

  .main,.details,.meta,.actions{min-width:0}
  .main,.details,.meta{display:grid;gap:6px}
  .details,.meta,.actions{
    padding-left:14px;
    border-left:1px solid #edf2f6;
  }
  .actions{display:block}

  .action-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:5px;
    width:8.75rem;
  }

  .action-grid :global(.row-actions){
    display:contents !important;
  }

  .action-grid :global(a){
    box-sizing:border-box;
    width:100%;
    min-width:0;
    justify-content:center;
    text-align:center;
    overflow:hidden;
    text-overflow:ellipsis;
  }

  .open-link{
    padding:6px 8px;
    border:1px solid #cfe0eb;
    border-radius:6px;
    background:#edf7fd;
    color:#0b67b2;
    font-size:.67rem;
    font-weight:850;
    text-decoration:none;
    white-space:nowrap;
  }

  .open-link:hover,.open-link:focus-visible{
    background:#e2f1fb;
    text-decoration:underline;
    text-underline-offset:.15em;
  }

  @media(max-width:1180px){
    .dense-object-row,
    .dense-object-row.content-heavy,
    .dense-object-row.detail-heavy,
    .dense-object-row.balanced{
      grid-template-columns:minmax(20rem,1.2fr) minmax(16rem,1fr);
      gap:14px 18px;
    }
    .meta,.actions{grid-row:2}
    .action-grid{width:100%;max-width:18rem}
  }

  @media(max-width:720px){
    .dense-object-row,
    .dense-object-row.content-heavy,
    .dense-object-row.detail-heavy,
    .dense-object-row.balanced{grid-template-columns:1fr;gap:12px}
    .details,.meta,.actions{
      grid-row:auto;
      padding-left:0;
      border-left:0;
    }
    .action-grid{width:100%;max-width:none}
  }
</style>
