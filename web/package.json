{
  "name": "russia-thermal-web",
  "private": true,
  "type": "module",
  "scripts": {
    "data:generate": "python adapters/export_web.py",
    "dev": "python adapters/export_web.py && astro dev",
    "build": "python adapters/export_web.py && npm run check:research && npm run check:atlas && npm run check:comparison && astro build",
    "preview": "astro preview",
    "check": "python adapters/export_web.py && npm run check:research && npm run check:atlas && npm run check:comparison && astro check",
    "check:links": "node scripts/check-internal-links.mjs && npm run check:visual-contract",
    "check:research": "node scripts/check-research-closeout.mjs && npm run check:evidence-graph",
    "check:atlas": "node scripts/check-russia-atlas.mjs",
    "check:comparison": "node scripts/check-comparison-transfer.mjs",
    "check:visual-contract": "node scripts/check-web-quality.mjs",
    "check:evidence-graph": "node scripts/check-evidence-relations.mjs"
  },
  "dependencies": {
    "astro": "^5.14.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.3"
  }
}
